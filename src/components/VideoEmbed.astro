---
/**
 * Lazy-loaded YouTube embed with VideoObject structured data.
 *
 * Renders a real iframe (loading="lazy") so Googlebot can verify the video
 * is watchable on the page — required for video indexing. A click-to-play
 * facade was tried first, but Search Console flagged every facaded page with
 * "Video isn't on a watch page" because no player exists in the DOM until
 * click. Lazy loading keeps below-fold embeds off the initial page weight.
 */
import seo from '../data/seo.json';

export interface Props {
  videoId: string;
  title: string;
  description?: string;
  uploadDate?: string; // ISO date (YYYY-MM-DD) or full ISO datetime
}

const { videoId, title, description = '', uploadDate: rawUploadDate } = Astro.props;

// Google requires uploadDate to carry a timezone; expand bare dates to noon Central.
const uploadDate = rawUploadDate && /^\d{4}-\d{2}-\d{2}$/.test(rawUploadDate)
  ? `${rawUploadDate}T12:00:00-06:00`
  : rawUploadDate;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description: description || title,
  thumbnailUrl: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
  ...(uploadDate && { uploadDate }),
  embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
  contentUrl: `https://www.youtube.com/watch?v=${videoId}`,
  author: {
    '@type': 'Person',
    name: seo.person.name,
    url: seo.site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: seo.site.name,
    logo: { '@type': 'ImageObject', url: seo.brokerage.logo },
  },
};
---

<div class="video-embed">
  <div class="video-embed__frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
  <p class="video-embed__caption">{title}</p>
</div>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .video-embed {
    max-width: 700px;
    margin: 2rem auto 0;
  }
  .video-embed__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }
  .video-embed__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .video-embed__caption {
    font-size: 0.8rem;
    color: #777;
    margin-top: 0.6rem;
    text-align: center;
  }
</style>
