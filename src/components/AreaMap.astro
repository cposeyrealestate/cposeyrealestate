---
// AreaMap — a fixed, illustrated area snippet (Houston-style), built from real
// U.S. Census city-limit boundaries (2023 cartographic boundary file, Texas
// places; source data in ~/workspace/map-data). No tiles, no pan/zoom: areas
// highlight on hover and click through to their guide pages. Icons are
// data-driven — add an entry to BASES/ICONS to place more. Rings are Cody's
// downtown-San-Antonio calibrations (15 ≈ Wurzbach Pkwy, 30 ≈ FM 1103 in
// Cibolo, 60 ≈ Yarrington Rd), drawn as SVG circles in the same projected
// space (viewBox units = km).
const DOWNTOWN = { x: 37.4, y: 66.3 };
const RINGS = [
  { r: 13.5, label: '15 MIN', lx: 37.4, ly: 54.8, anchor: 'middle' },
  { r: 30, label: '30 MIN', lx: 18.2, ly: 41.6, anchor: 'middle' },
  { r: 80, label: '60 MIN', lx: 101, ly: 17.8, anchor: 'end' }
];
const BASES = [
  { name: 'RANDOLPH', x: 57.9, y: 54.5 },
  { name: 'FORT SAM', x: 43, y: 61 },
  { name: 'LACKLAND', x: 25.6, y: 70.5 },
  { name: 'CAMP BULLIS', x: 30.8, y: 37.3 }
];
---
<figure class="area-map">
  <svg viewBox="0 0 102.5 104.5" role="img" aria-label="Map of San Antonio and the Hill Country communities Cody serves, with 15, 30 and 60 minute drive rings from downtown San Antonio" class="area-map__svg">
    <rect x="0" y="0" width="102.5" height="104.5" class="area-map__bg" />
    <!-- drive rings from downtown -->
    {RINGS.map((ring) => (
      <circle cx={DOWNTOWN.x} cy={DOWNTOWN.y} r={ring.r} class="area-map__ring" />
    ))}
    {RINGS.map((ring) => (
      <text x={ring.lx} y={ring.ly} text-anchor={ring.anchor} class="area-map__ring-label">{ring.label}</text>
    ))}
