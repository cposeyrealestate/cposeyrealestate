---
<div class="reloc-map" id="reloc-map" role="img" aria-label="Map of the San Antonio and Hill Country communities Cody serves, with city-limit borders and 15, 30 and 60 minute drive rings from downtown San Antonio"></div>
<p class="reloc-map-caption">City-limit borders from U.S. Census data (Stone Oak is an approximate neighborhood outline). Hover an area to highlight it, click to open its community guide. Rings are approximate drive times from downtown San Antonio. Regional drives: Austin ≈ 1.5 hrs · Houston ≈ 3.5 hrs · Dallas ≈ 5 hrs.</p>

<style is:global>
  .reloc-map { height: 600px; border-radius: 16px; overflow: hidden; border: 1px solid #d8dee3; box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08); background: #e8eef1; z-index: 0; }
  @media (max-width: 700px) { .reloc-map { height: 460px; } }
  .reloc-map-caption { color: #5b6b78; font-size: 0.85rem; margin: 0.6rem 0.2rem 0; }
  .reloc-map .leaflet-container { font: inherit; }
  /* locked snippet: no grab cursors anywhere */
  .reloc-map .leaflet-grab, .reloc-map .leaflet-dragging .leaflet-grab { cursor: default; }
  .reloc-label {
    background: transparent; border: none; box-shadow: none; padding: 0;
    color: #22303c; font-weight: 800; letter-spacing: 0.045em; text-transform: uppercase;
    text-shadow: 0 0 4px #fff, 0 0 4px #fff, 0 0 5px #fff, 0 1px 2px #fff;
    white-space: nowrap; pointer-events: none;
  }
  .reloc-label::before { display: none; }
  .reloc-label--lg { font-size: 14px; }
  .reloc-label--md { font-size: 12px; }
  .reloc-label--sm { font-size: 10.5px; line-height: 1.25; text-align: center; }
  .reloc-label--hot { color: #b30000; }
  .reloc-base-star { color: #d90404; font-size: 15px; line-height: 1; text-shadow: 0 0 3px #fff, 0 0 3px #fff, 0 1px 2px rgba(255,255,255,0.9); text-align: center; }
  .reloc-base-label {
    background: transparent; border: none; box-shadow: none; padding: 0;
    color: #66788a; font-size: 9.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    text-shadow: 0 0 3px #fff, 0 0 3px #fff; white-space: nowrap; pointer-events: none;
  }
  .reloc-base-label::before { display: none; }
  .reloc-ring-label { background: transparent; border: none; box-shadow: none; padding: 0; pointer-events: none; }
  .reloc-ring-label::before { display: none; }
  .reloc-ring-label__pill {
    display: inline-block; background: #fff; color: #c00; border: 1.5px solid #FF1616;
    font-size: 11px; font-weight: 800; letter-spacing: 0.02em;
    padding: 1px 8px; border-radius: 999px; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.22); white-space: nowrap;
  }
  .reloc-center-star {
    background: #d90404; color: #fff; border: 2px solid #fff; border-radius: 50%;
    font-size: 11px; line-height: 18px; text-align: center; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.35);
  }
</style>

<script define:vars={{ MAP_DATA }}>
  const el = document.getElementById('reloc-map');
  if (el && !el.dataset.loaded) {
    el.dataset.loaded = '1';
    import('leaflet').then((L) => {
      // LOCKED snippet: no pan, no scroll, no zoom — clicks and hover only.
      const map = L.map(el, {
        dragging: false, scrollWheelZoom: false, doubleClickZoom: false,
        boxZoom: false, keyboard: false, zoomControl: false,
        touchZoom: false, tap: false, attributionControl: true
      });
      map.attributionControl.setPrefix(false);
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Esri, OpenStreetMap contributors', maxZoom: 16
      }).addTo(map);
      map.fitBounds([[29.13, -98.88], [30.01, -97.82]], { padding: [8, 8] });

      // Cody's calibrated rings from downtown San Antonio.
      const DOWNTOWN_SA = [29.4241, -98.4936];
      [
        { time: 15, radius: 13500, fillOpacity: 0.1 },
        { time: 30, radius: 30000, fillOpacity: 0.07 },
        { time: 60, radius: 80000, fillOpacity: 0.045 }
      ].forEach((band) => {
        L.circle(DOWNTOWN_SA, { radius: band.radius, color: '#d90404', weight: 1.2, fillColor: '#FF1616', fillOpacity: band.fillOpacity, interactive: false }).addTo(map);
        const labelLat = DOWNTOWN_SA[0] + band.radius / 111320;
        L.tooltip({ permanent: true, direction: 'center', className: 'reloc-ring-label', interactive: false })
          .setLatLng([labelLat, DOWNTOWN_SA[1]])
          .setContent('<span class="reloc-ring-label__pill">' + band.time + ' min</span>')
          .addTo(map);
      });

      // Area borders: San Antonio first (underlay), then the rest.
      const ordered = MAP_DATA.areas.slice().sort((a, b) => (a.name === 'San Antonio' ? -1 : b.name === 'San Antonio' ? 1 : 0));
      ordered.forEach((area) => {
        const geom = MAP_DATA.areaGeo[area.name];
        if (!geom) return;
        const layer = L.geoJSON({ type: 'Feature', geometry: geom }, {
          style: { color: '#3c546a', weight: 1.4, fillColor: '#ffffff', fillOpacity: 0.22 },
          interactive: true
        }).addTo(map);
        const label = L.tooltip({ permanent: true, direction: 'center', className: 'reloc-label reloc-label--' + area.size, interactive: false })
          .setLatLng(area.label)
          .setContent(area.display || area.name.toUpperCase())
          .addTo(map);
        layer.on('mouseover', () => {
          layer.setStyle({ color: '#d90404', weight: 2.4, fillColor: '#FF1616', fillOpacity: 0.2 });
          const t = label.getElement(); if (t) t.classList.add('reloc-label--hot');
        });
        layer.on('mouseout', () => {
          layer.setStyle({ color: '#3c546a', weight: 1.4, fillColor: '#ffffff', fillOpacity: 0.22 });
          const t = label.getElement(); if (t) t.classList.remove('reloc-label--hot');
        });
        layer.on('click', () => { window.location.href = area.href; });
      });

      // Base stars (+micro labels where there is room).
      MAP_DATA.bases.forEach((base) => {
        L.marker(base.latlng, {
          interactive: false,
          icon: L.divIcon({ className: '', html: '<div class="reloc-base-star" title="' + base.name + '">★</div>', iconSize: [15, 15], iconAnchor: [7, 8] })
        }).addTo(map);
        if (base.label) {
          L.tooltip({ permanent: true, direction: 'right', offset: [8, 0], className: 'reloc-base-label', interactive: false })
            .setLatLng(base.latlng).setContent(base.name).addTo(map);
        }
      });
      L.marker(DOWNTOWN_SA, {
        interactive: false,
        icon: L.divIcon({ className: '', html: '<div class="reloc-center-star">★</div>', iconSize: [20, 20], iconAnchor: [10, 10] })
      }).addTo(map);
    });
  }
</script>
