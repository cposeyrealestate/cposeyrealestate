  { name: 'Boerne', href: '/boerne/', label: [29.7945, -98.7319], size: 'md' },
  { name: 'Bulverde', href: '/bulverde/', label: [29.755, -98.44], size: 'md' },
  { name: 'Canyon Lake', href: '/canyon-lake/', label: [29.905, -98.225], size: 'md' },
