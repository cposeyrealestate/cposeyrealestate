---
// Interactive relocation map: JBSA installations + Hill Country communities.
// Leaflet + CARTO Voyager tiles (modern basemap, free w/ attribution, no API key).
// Custom branded pins: red star pins for installations, charcoal pins for communities.
---

<div class="reloc-map-wrap">
  <div id="reloc-map" role="application" aria-label="Interactive map of JBSA installations and Hill Country communities"></div>
  <div class="reloc-ringbar" role="group" aria-label="Drive-time rings">
    <span class="reloc-ringbar__label">Drive-time rings around:</span>
    <button type="button" class="reloc-ringbtn is-active" data-base="JBSA Randolph">Randolph</button>
    <button type="button" class="reloc-ringbtn" data-base="JBSA Fort Sam Houston">Fort Sam</button>
    <button type="button" class="reloc-ringbtn" data-base="JBSA Lackland">Lackland</button>
    <button type="button" class="reloc-ringbtn" data-base="Camp Bullis">Camp Bullis</button>
    <button type="button" class="reloc-ringbtn" data-base="">Off</button>
    <span class="reloc-ringbar__hint">Rings show roughly 15 / 30 / 45-minute drives on the road network.</span>
  </div>
  <div class="reloc-map-legend">
    <span class="reloc-map-chip"><span class="reloc-map-chip__pin reloc-map-chip__pin--base"><span class="reloc-map-chip__glyph">★</span></span> Military installation</span>
    <span class="reloc-map-chip"><span class="reloc-map-chip__pin reloc-map-chip__pin--town"></span> Community guide</span>
    <span class="reloc-map-legend__hint">Tap a pin — or pick a community below — for a short brief and the full guide.</span>
  </div>

  <div class="reloc-cards">
    <button type="button" class="reloc-card" data-fly="New Braunfels">
      <span class="reloc-card__img"><img src="/images/areas/new-braunfels.jpg" alt="New Braunfels, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">New Braunfels</span><span class="reloc-card__desc">Rivers, Gruene, and the I-35 corridor between SA and Austin.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
    <button type="button" class="reloc-card" data-fly="Schertz">
      <span class="reloc-card__img"><img src="/images/areas/cibolo-schertz.jpg" alt="Cibolo and Schertz, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">Cibolo &amp; Schertz</span><span class="reloc-card__desc">Closest to Randolph AFB — newer homes, SCUC ISD.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
    <button type="button" class="reloc-card" data-fly="Garden Ridge">
      <span class="reloc-card__img"><img src="/images/areas/garden-ridge.jpg" alt="Garden Ridge, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">Garden Ridge</span><span class="reloc-card__desc">Acreage lots and a quiet, wooded feel.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
    <button type="button" class="reloc-card" data-fly="Bulverde">
      <span class="reloc-card__img"><img src="/images/areas/bulverde.jpg" alt="Bulverde, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">Bulverde</span><span class="reloc-card__desc">Hill Country space and scenery on US-281.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
    <button type="button" class="reloc-card" data-fly="Canyon Lake">
      <span class="reloc-card__img"><img src="/images/areas/canyon-lake.jpg" alt="Canyon Lake, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">Canyon Lake</span><span class="reloc-card__desc">Lake life on the Guadalupe River.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
    <button type="button" class="reloc-card" data-fly="Boerne">
      <span class="reloc-card__img"><img src="/images/areas/boerne.jpg" alt="Boerne, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">Boerne</span><span class="reloc-card__desc">Historic Main Street on I-10, northwest of San Antonio.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
    <button type="button" class="reloc-card" data-fly="Seguin">
      <span class="reloc-card__img"><img src="/images/areas/seguin.jpg" alt="Seguin, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">Seguin</span><span class="reloc-card__desc">Historic, affordable, and right on the river.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
    <button type="button" class="reloc-card" data-fly="San Antonio">
      <span class="reloc-card__img"><img src="/images/areas/san-antonio.jpg" alt="San Antonio, Texas" loading="lazy" /></span>
      <span class="reloc-card__body"><span class="reloc-card__name">San Antonio</span><span class="reloc-card__desc">The metro core — Fort Sam and Lackland inside the city.</span><span class="reloc-card__cta">See it on the map ↑</span></span>
    </button>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  .reloc-map-wrap { max-width: 1100px; margin: 0 auto; }
  #reloc-map {
    height: 520px; width: 100%;
    border: none; border-radius: 16px;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16), 0 3px 10px rgba(15, 23, 42, 0.08);
    z-index: 0; background: #eef1f4;
    font-family: inherit;
  }
  /* Custom pins */
  .reloc-pin {
    width: 34px; height: 34px; border-radius: 50% 50% 50% 4px;
    transform: rotate(-45deg);
    border: 2.5px solid #fff;
    box-shadow: 0 6px 14px rgba(15, 23, 42, 0.35);
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.15s ease;
  }
  .reloc-pin:hover { transform: rotate(-45deg) scale(1.12); }
  .reloc-pin--base { background: linear-gradient(135deg, #ff3b30, #d90404); }
  .reloc-pin--town { background: linear-gradient(135deg, #3a3f47, #14171b); }
  .reloc-pin__glyph {
    transform: rotate(45deg); color: #fff; font-size: 15px; line-height: 1;
    display: flex; align-items: center; justify-content: center;
  }
  .reloc-pin__dot { width: 9px; height: 9px; border-radius: 50%; background: #fff; }
  /* Legend */
  .reloc-map-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: center; margin-top: 0.9rem; }
  .reloc-map-chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: #fff; border: 1px solid #e3e6ea; border-radius: 999px;
    padding: 0.35rem 0.8rem 0.35rem 0.45rem; font-size: 0.88rem; font-weight: 600; color: #222;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
  }
  .reloc-map-chip__pin {
    width: 20px; height: 20px; border-radius: 50% 50% 50% 3px; transform: rotate(-45deg);
    color: #fff; font-size: 10px; display: inline-flex; align-items: center; justify-content: center;
  }
  .reloc-map-chip__pin--base { background: linear-gradient(135deg, #ff3b30, #d90404); }
  .reloc-map-chip__glyph { transform: rotate(45deg); line-height: 1; }
  .reloc-map-chip__pin--town { background: linear-gradient(135deg, #3a3f47, #14171b); }
  .reloc-map-legend__hint { color: #777; font-size: 0.9rem; margin-left: 0.25rem; }
  /* Leaflet chrome */
  #reloc-map .leaflet-bar { border: none; box-shadow: 0 4px 14px rgba(15,23,42,0.18); border-radius: 10px; overflow: hidden; }
  #reloc-map .leaflet-bar a { border: none; width: 34px; height: 34px; line-height: 34px; color: #222; }
  #reloc-map .leaflet-control-layers {
    border: none; box-shadow: 0 4px 14px rgba(15,23,42,0.18); border-radius: 10px;
    padding: 0.5rem 0.7rem; font-size: 0.85rem;
  }
  #reloc-map .leaflet-control-attribution { background: rgba(255,255,255,0.75); font-size: 10px; }
  /* Popups */
  #reloc-map .leaflet-popup-content-wrapper {
    border-radius: 14px; box-shadow: 0 14px 34px rgba(15, 23, 42, 0.25); overflow: hidden; padding: 0;
  }
  #reloc-map .leaflet-popup-content { margin: 0; width: 250px !important; }
  #reloc-map .leaflet-popup-tip { box-shadow: none; }
  .reloc-popup__head {
    padding: 0.65rem 0.9rem; color: #fff; font-weight: 800; font-size: 0.98rem; letter-spacing: 0.01em;
    display: flex; align-items: center; gap: 0.45rem;
  }
  .reloc-popup__head--base { background: linear-gradient(135deg, #ff3b30, #c00); }
  .reloc-popup__head--town { background: linear-gradient(135deg, #3a3f47, #14171b); }
  .reloc-popup__body { padding: 0.75rem 0.9rem 0.9rem; }
  .reloc-popup__body p { margin: 0 0 0.7rem; font-size: 0.88rem; line-height: 1.5; color: #333; }
  .reloc-popup__btn {
    display: inline-block; background: #FF1616; color: #fff !important; font-weight: 700; font-size: 0.85rem;
    padding: 0.45rem 0.85rem; border-radius: 8px; text-decoration: none !important;
  }
  .reloc-popup__btn:hover { background: #d90404; }
  /* Drive-time ring selector */
  .reloc-ringbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; margin-top: 0.9rem; }
  .reloc-ringbar__label { font-weight: 700; font-size: 0.9rem; color: #222; margin-right: 0.15rem; }
  .reloc-ringbar__hint { color: #777; font-size: 0.85rem; width: 100%; margin-top: 0.15rem; }
  .reloc-ringbtn {
    font: inherit; font-size: 0.86rem; font-weight: 600; cursor: pointer;
    background: #fff; color: #333; border: 1px solid #d8dce1; border-radius: 999px; padding: 0.32rem 0.8rem;
    transition: all 0.15s ease;
  }
  .reloc-ringbtn:hover { border-color: #FF1616; color: #d90404; }
  .reloc-ringbtn.is-active { background: #FF1616; border-color: #FF1616; color: #fff; }
  /* Community cards */
  .reloc-cards {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1.25rem;
  }
  .reloc-card {
    display: block; text-align: left; background: #fff; border: 1px solid #e6e8ec; border-radius: 14px;
    overflow: hidden; padding: 0; cursor: pointer; font: inherit;
    box-shadow: 0 3px 10px rgba(15, 23, 42, 0.06);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .reloc-card:hover, .reloc-card:focus-visible {
    transform: translateY(-4px); border-color: #FF1616;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.14); outline: none;
  }
  .reloc-card__img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #eef1f4; }
  .reloc-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.35s ease; }
  .reloc-card:hover .reloc-card__img img { transform: scale(1.06); }
  .reloc-card__body { display: block; padding: 0.8rem 0.95rem 0.95rem; }
  .reloc-card__name { display: block; font-weight: 800; font-size: 1.02rem; color: #14171b; }
  .reloc-card__desc { display: block; font-size: 0.86rem; line-height: 1.45; color: #555; margin-top: 0.25rem; }
  .reloc-card__cta { display: block; font-size: 0.82rem; font-weight: 700; color: #d90404; margin-top: 0.55rem; }
  @media (max-width: 900px) { .reloc-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { #reloc-map { height: 400px; } }
  @media (max-width: 520px) { .reloc-cards { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var BASES = [
      { name: 'JBSA Randolph', lat: 29.5297, lng: -98.2817, blurb: 'The flight-training hub of JBSA. Schertz, Cibolo and New Braunfels are the common off-base picks.', link: '/military-relocation/randolph-afb/', linkText: 'Randolph AFB housing guide' },
      { name: 'JBSA Fort Sam Houston', lat: 29.4713, lng: -98.4355, blurb: 'Home of Army medicine. Northeast San Antonio puts you close; New Braunfels is an I-35 commute.', link: '/military-relocation/fort-sam-houston/', linkText: 'Fort Sam Houston housing guide' },
      { name: 'JBSA Lackland', lat: 29.3858, lng: -98.6153, blurb: 'Basic military training and technical schools. Most off-base living is on San Antonio\u2019s west and southwest sides.', link: '/military-relocation/lackland-afb/', linkText: 'Lackland AFB housing guide' },
      { name: 'Camp Bullis', lat: 29.6850, lng: -98.5620, blurb: 'Training area on the north side. Stone Oak, Bulverde and Garden Ridge are the usual landing spots.', link: '/military-relocation/camp-bullis/', linkText: 'Camp Bullis housing guide' }
    ];
    var TOWNS = [
      { name: 'New Braunfels', lat: 29.7030, lng: -98.1245, blurb: 'Rivers, German heritage, and the I-35 corridor between San Antonio and Austin. About 30 minutes to Randolph.', link: '/new-braunfels/', linkText: 'New Braunfels guide' },
      { name: 'Schertz', lat: 29.5522, lng: -98.2697, blurb: 'The closest-in suburb to Randolph AFB, in Schertz-Cibolo-Universal City ISD.', link: '/cibolo-schertz/', linkText: 'Cibolo & Schertz guide' },
      { name: 'Cibolo', lat: 29.5630, lng: -98.2260, blurb: 'Fast-growing, newer construction, and a short hop to Randolph\u2019s gate.', link: '/cibolo-schertz/', linkText: 'Cibolo & Schertz guide' },
      { name: 'Garden Ridge', lat: 29.7283, lng: -98.2988, blurb: 'Acreage lots and a quiet, wooded feel between New Braunfels and San Antonio.', link: '/garden-ridge/', linkText: 'Garden Ridge guide' },
      { name: 'Bulverde', lat: 29.7439, lng: -98.4537, blurb: 'Hill Country space on US-281: bigger lots, scenery, and a 35\u201345 minute peak commute downtown.', link: '/bulverde/', linkText: 'Bulverde guide' },
      { name: 'Canyon Lake', lat: 29.8750, lng: -98.2600, blurb: 'Lake life on the Guadalupe. Water levels recovered to about 98% full in July 2026 after the spring rains.', link: '/canyon-lake/', linkText: 'Canyon Lake guide' },
      { name: 'Boerne', lat: 29.7945, lng: -98.7319, blurb: 'Hill Country town on I-10 with a historic Main Street, northwest of San Antonio.', link: '/boerne/', linkText: 'Boerne guide' },
      { name: 'Seguin', lat: 29.5684, lng: -97.9647, blurb: 'Historic, affordable, and on the Guadalupe River \u2014 east of New Braunfels on the way to Houston.', link: '/seguin/', linkText: 'Seguin guide' },
      { name: 'San Antonio', lat: 29.4241, lng: -98.4936, blurb: 'The metro core: Fort Sam Houston and Lackland sit inside the city; the Alamo and River Walk downtown.', link: '/san-antonio/', linkText: 'San Antonio guide' }
    ];

    function popup(p, kind) {
      var glyph = kind === 'base' ? '\u2605 ' : '';
      return '<div class="reloc-popup">' +
        '<div class="reloc-popup__head reloc-popup__head--' + kind + '">' + glyph + p.name + '</div>' +
        '<div class="reloc-popup__body"><p>' + p.blurb + '</p>' +
        '<a class="reloc-popup__btn" href="' + p.link + '">' + p.linkText + ' &rarr;</a></div></div>';
    }

    function pinIcon(kind) {
      var glyph = kind === 'base'
        ? '<span class="reloc-pin__glyph">\u2605</span>'
        : '<span class="reloc-pin__glyph"><span class="reloc-pin__dot"></span></span>';
      return L.divIcon({
        className: 'reloc-pin-icon',
        html: '<div class="reloc-pin reloc-pin--' + kind + '">' + glyph + '</div>',
        iconSize: [34, 34],
        iconAnchor: [17, 32],
        popupAnchor: [0, -30]
      });
    }

    function init() {
      if (!window.L || !document.getElementById('reloc-map')) return;
      var map = L.map('reloc-map', { scrollWheelZoom: false }).setView([29.62, -98.35], 9);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        maxZoom: 19,
        subdomains: 'abcd',
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
      }).addTo(map);
      map.on('focus', function () { map.scrollWheelZoom.enable(); });
      map.on('blur', function () { map.scrollWheelZoom.disable(); });

      var markers = {};
      var baseLayer = L.layerGroup();
      BASES.forEach(function (p) {
        markers[p.name] = L.marker([p.lat, p.lng], { icon: pinIcon('base') }).bindPopup(popup(p, 'base')).addTo(baseLayer);
      });
      var townLayer = L.layerGroup();
      TOWNS.forEach(function (p) {
        markers[p.name] = L.marker([p.lat, p.lng], { icon: pinIcon('town') }).bindPopup(popup(p, 'town')).addTo(townLayer);
      });
      baseLayer.addTo(map); townLayer.addTo(map);
      L.control.layers(null, { 'Military installations': baseLayer, 'Communities': townLayer }, { collapsed: false }).addTo(map);

      // Drive-time rings (precomputed road-network isochrones, loaded lazily).
      var ringsLayer = L.layerGroup().addTo(map);
      var ringsData = null;
      var activeBase = 'JBSA Randolph';
      var RING_STYLE = {
        45: { color: '#d90404', weight: 1, dashArray: '5 5', fillColor: '#FF1616', fillOpacity: 0.05 },
        30: { color: '#d90404', weight: 1, dashArray: '5 5', fillColor: '#FF1616', fillOpacity: 0.09 },
        15: { color: '#d90404', weight: 1.2, fillColor: '#FF1616', fillOpacity: 0.14 }
      };
      function drawRings() {
        ringsLayer.clearLayers();
        if (!ringsData || !activeBase || !ringsData[activeBase]) return;
        ringsData[activeBase].forEach(function (f) {
          L.geoJSON({ type: 'Feature', geometry: f.geometry }, { style: RING_STYLE[f.time] || RING_STYLE[45] })
            .bindPopup('About a ' + f.time + '-minute drive to ' + activeBase + ' on the road network (before traffic).')
            .addTo(ringsLayer);
        });
        baseLayer.eachLayer(function (m) { if (m.bringToFront) m.bringToFront(); });
        townLayer.eachLayer(function (m) { if (m.bringToFront) m.bringToFront(); });
      }
      fetch('/data/relocation-rings.json')
        .then(function (r) { return r.json(); })
        .then(function (d) { ringsData = d; drawRings(); })
        .catch(function () { /* rings are an enhancement; map works without them */ });
      var ringBtns = document.querySelectorAll('.reloc-ringbtn[data-base]');
      Array.prototype.forEach.call(ringBtns, function (btn) {
        btn.addEventListener('click', function () {
          Array.prototype.forEach.call(ringBtns, function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          activeBase = btn.getAttribute('data-base');
          drawRings();
        });
      });

      // Community cards fly the map to their pin and open its popup.
      var cards = document.querySelectorAll('.reloc-card[data-fly]');
      Array.prototype.forEach.call(cards, function (card) {
        card.addEventListener('click', function () {
          var marker = markers[card.getAttribute('data-fly')];
          if (!marker) return;
          document.getElementById('reloc-map').scrollIntoView({ behavior: 'smooth', block: 'center' });
          map.flyTo(marker.getLatLng(), 11, { duration: 1.1 });
          map.once('moveend', function () { marker.openPopup(); });
        });
      });
    }

    if (window.L) { init(); }
    else {
      var s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.onload = init;
      document.head.appendChild(s);
    }
  })();
</script>
