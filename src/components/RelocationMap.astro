<style is:global>
  .area-map { margin: 0 auto; max-width: 880px; border: 1px solid #0b2833; border-radius: 16px; overflow: hidden; background: #0b2833; box-shadow: 0 14px 34px rgba(11, 40, 51, 0.35); }
  .area-map__svg { display: block; width: 100%; height: auto; }
  .area-map__county { fill: none; stroke: rgba(255, 255, 255, 0.13); stroke-width: 0.3; }
  .area-map__county-label { fill: #6f8b99; font-size: 1.6px; font-weight: 700; letter-spacing: 0.18em; }
  .area-map__ring { fill: none; stroke: rgba(255, 255, 255, 0.5); stroke-width: 0.32; stroke-dasharray: 1.8 1.3; }
  .area-map__ring-text { fill: #ffd97a; font-size: 1.55px; font-weight: 700; letter-spacing: 0.16em; }
  .area-map__ring-pill rect { fill: #fff; }
  .area-map__ring-pill text { fill: #b30000; font-size: 1.9px; font-weight: 800; letter-spacing: 0.04em; }
  .area-map__lake { fill: #2e8fa8; opacity: 0.9; }
  .area-map__poly { fill: rgba(255, 255, 255, 0.05); stroke: rgba(255, 255, 255, 0.4); stroke-width: 0.35; transition: fill 120ms ease; }
  .area-map__area { cursor: pointer; }
  .area-map__area:hover .area-map__poly, .area-map__area:focus .area-map__poly { fill: rgba(232, 163, 61, 0.88); stroke: #f2b33d; stroke-width: 0.5; }
  .area-map__label { fill: #fff; font-weight: 800; letter-spacing: 0.05em; text-anchor: middle; pointer-events: none; paint-order: stroke; stroke: rgba(11, 40, 51, 0.6); stroke-width: 0.5; }
  .area-map__shield rect { fill: #173f4d; stroke: #cfe3ea; stroke-width: 0.3; }
  .area-map__shield text { fill: #fff; font-weight: 800; text-anchor: middle; }
  .area-map__star { fill: #f2b33d; font-size: 3.3px; text-anchor: middle; }
