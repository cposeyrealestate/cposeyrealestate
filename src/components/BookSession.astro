---
// Inline TidyCal scheduler. Renders a "Book a Session" section with the
// embedded 30-minute meeting calendar so visitors can pick a time without
// leaving the site. Reused on the homepage and the /contact page (anchor
// #book — the navbar "Book a Session" button links to /contact#book).
const tidyCalPath = 'cposeyrealestate/30-minute-meeting';
---

<section class="book-session section" id="book">
  <div class="container">
    <div class="section-title">
      <p class="book-session__eyebrow">Let's Talk</p>
      <h2>Schedule a Free <span class="accent">Real Estate Consultation</span></h2>
      <p class="book-session__sub">Grab a free 30-minute call — whether you're buying, selling, planning a military PCS move, or exploring San Antonio, New Braunfels, and the Hill Country. Pick a time that works for you and I'll take it from there.</p>
    </div>

    <div class="book-session__embed" data-booking-slot data-path={tidyCalPath}>
      <div class="book-session__facade" data-booking-facade>
        <h3>Find a time that works for you</h3>
        <p>Choose a free 30-minute consultation with Cody.</p>
        <button type="button" class="btn btn-primary" data-load-booking>View available times</button>
        <p><a href={`https://tidycal.com/${tidyCalPath}`} target="_blank" rel="noopener noreferrer">Open the booking page ↗</a></p>
        <p data-booking-status role="status" hidden></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initBooking } from '../lib/booking.mjs';
  for (const slot of document.querySelectorAll<HTMLElement>('[data-booking-slot]')) {
    initBooking(slot);
  }
</script>

<style>
  .book-session {
    background: #000;
    color: #fff;
  }

  .book-session .section-title {
    text-align: center;
  }

  .book-session__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #FF1616;
    margin-bottom: 0.5rem;
  }

  .book-session h2 {
    color: #fff;
  }

  .book-session__sub {
    color: rgba(255, 255, 255, 0.6);
    max-width: 620px;
    margin: 1rem auto 0;
    line-height: 1.7;
  }

  .book-session__embed {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2.5rem auto 0;
    max-width: 900px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    min-height: 620px;
  }
  .book-session__facade { min-height: 570px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1.25rem; text-align: center; color: #111; }
  .book-session__facade[hidden] { display: none; }
  .book-session__facade h3 { font-size: 1.4rem; }
  .book-session__facade a { color: #b30d0d; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 600px) {
    .book-session__embed {
      padding: 0.75rem;
    }
  }
</style>
