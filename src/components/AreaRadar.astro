---
/**
 * AreaRadar — clickable "radar screen" area map for the homepage.
 * Stylized SVG radar (rings radiate from New Braunfels) with HTML overlay links:
 *  - 12 city dots → area relocation guides
 *  - 4 installation stars → per-installation PCS housing guides
 *  - 5 landmark pins → visual markers with hover labels (not links)
 */

const cities = [
  { name: 'New Braunfels', href: '/new-braunfels/', x: 50, y: 50, lx: 0, ly: 26, home: true },
  { name: 'San Antonio', href: '/san-antonio/', x: 35, y: 70, lx: -58, ly: 14 },
  { name: 'Bulverde', href: '/bulverde/', x: 36.25, y: 41.25, lx: -52, ly: -8 },
  { name: 'Garden Ridge', href: '/garden-ridge/', x: 43.1, y: 46.9, lx: 14, ly: -16 },
  { name: 'Canyon Lake', href: '/canyon-lake/', x: 39.4, y: 33.1, lx: 14, ly: -14 },
  { name: 'Seguin', href: '/seguin/', x: 71.25, y: 53.75, lx: 14, ly: -10 },
  { name: 'Cibolo', href: '/cibolo-schertz/', x: 55.6, y: 59.4, lx: 14, ly: -12 },
  { name: 'Schertz', href: '/cibolo-schertz/', x: 59.4, y: 63.75, lx: 14, ly: 6 },
  { name: 'Boerne', href: '/boerne/', x: 26.9, y: 43.75, lx: -48, ly: -10 },
  { name: 'Universal City', href: '/cibolo-schertz/', x: 53.1, y: 66.9, lx: 12, ly: 10 },
  { name: 'Selma', href: '/cibolo-schertz/', x: 51.9, y: 56.5, lx: -44, ly: 2 },
  { name: 'Live Oak', href: '/cibolo-schertz/', x: 48.75, y: 70, lx: -52, ly: 8 },
];

const installations = [
  { name: 'Fort Sam Houston', href: '/military-relocation/fort-sam-houston/', x: 42.5, y: 61.9, lx: 14, ly: 8 },
  { name: 'Randolph AFB', href: '/military-relocation/randolph-afb/', x: 62.5, y: 58.1, lx: 14, ly: 10 },
  { name: 'Lackland AFB', href: '/military-relocation/lackland-afb/', x: 27.25, y: 74.5, lx: -58, ly: 6 },
  { name: 'Camp Bullis', href: '/military-relocation/camp-bullis/', x: 34.4, y: 36.9, lx: 14, ly: -14 },
];

const landmarks = [
  { name: 'Schlitterbahn', x: 55, y: 49.5, icon: '≈' },
  { name: 'Riverwalk', x: 38.75, y: 65.6, icon: '≋' },
  { name: 'Spurs', x: 43.1, y: 69, icon: '●' },
  { name: 'Six Flags', x: 32.25, y: 57.75, icon: '▲' },
  { name: 'SeaWorld', x: 28.5, y: 71, icon: '◠' },
];

const driveTimes = [
  { label: '25 MIN · NB TO SAN ANTONIO', x: 50, y: 4.5 },
  { label: '45 MIN · NB TO AUSTIN', x: 50, y: 95.5 },
  { label: '20 MIN · NB TO SEGUIN', x: 4, y: 50 },
  { label: '35 MIN · NB TO BOERNE', x: 96, y: 50 },
];
---

<section class="area-radar" id="area-radar">
  <div class="container">
    <p class="area-radar__kicker">Explore the Area</p>
    <h2 class="area-radar__heading">Find Your Place in the Corridor</h2>
    <p class="area-radar__sub">
      Twelve cities, four military installations, one radar. Click anywhere on the
      dial for the full relocation guide — neighborhoods, commute times, schools,
      and what your BAH actually buys.
    </p>

    <div class="area-radar__map">
      <svg viewBox="0 0 800 800" class="area-radar__svg" role="img" aria-label="Radar-style map of Cody Posey's service area, centered on New Braunfels, Texas">
        <!-- concentric radar rings -->
        <g fill="none" stroke="rgba(255,255,255,0.16)" stroke-dasharray="6 8">
          <circle cx="400" cy="400" r="360" stroke-width="1.5" />
          <circle cx="400" cy="400" r="270" stroke-width="1" />
          <circle cx="400" cy="400" r="180" stroke-width="1" />
          <circle cx="400" cy="400" r="90" stroke-width="1" />
        </g>
        <!-- crosshairs -->
        <g stroke="rgba(255,255,255,0.08)" stroke-width="1">
          <line x1="400" y1="20" x2="400" y2="780" />
          <line x1="20" y1="400" x2="780" y2="400" />
        </g>
        <!-- highways -->
        <g fill="none" stroke="rgba(255,22,22,0.35)" stroke-width="3" stroke-linecap="round">
          <path d="M 250 660 L 400 400 L 530 170" />
          <path d="M 70 570 L 710 470" />
          <path d="M 290 545 L 330 110" />
          <path d="M 400 400 L 170 355" />
        </g>
        <g fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="2">
          <ellipse cx="290" cy="545" rx="95" ry="70" stroke-dasharray="10 8" transform="rotate(-18 290 545)" />
        </g>
        <!-- water -->
        <g fill="rgba(120,170,220,0.20)">
          <ellipse cx="315" cy="262" rx="42" ry="26" transform="rotate(-24 315 262)" />
          <path d="M 560 430 q 30 40 10 90 q -8 22 -30 30 q 25 -60 -5 -110 Z" />
        </g>
        <!-- highway labels -->
        <g fill="rgba(255,255,255,0.45)" font-size="15" font-weight="700" letter-spacing="2" text-anchor="middle" font-family="inherit">
          <text x="470" y="290" transform="rotate(63 470 290)">I-35</text>
          <text x="620" y="505">I-10</text>
          <text x="352" y="150" transform="rotate(78 352 150)">281</text>
          <text x="270" y="345" transform="rotate(-8 270 345)">46</text>
          <text x="205" y="600" transform="rotate(-18 205 600)">1604</text>
        </g>
        <!-- water / county labels -->
        <g fill="rgba(255,255,255,0.30)" font-size="13" letter-spacing="3" text-anchor="middle" font-family="inherit">
          <text x="315" y="266">CANYON LAKE</text>
          <text x="400" y="120">COMAL CO.</text>
          <text x="180" y="680">BEXAR CO.</text>
          <text x="660" y="400">GUADALUPE CO.</text>
          <text x="120" y="300">KENDALL CO.</text>
        </g>
        <!-- compass -->
        <g fill="rgba(255,255,255,0.55)" font-size="16" font-weight="700" text-anchor="middle" font-family="inherit">
          <text x="400" y="52">N</text>
          <path d="M 400 60 L 394 74 L 406 74 Z" />
        </g>
      </svg>

      <!-- clickable city dots -->
      {cities.map((c) => (
        <a
          href={c.href}
          class={'area-radar__point' + (c.home ? ' area-radar__point--home' : '')}
          style={`left:${c.x}%;top:${c.y}%;`}
          aria-label={`${c.name} relocation guide`}
        >
          <span class="area-radar__dot"></span>
          <span class="area-radar__label" style={`transform:translate(${c.lx}px,${c.ly}px);`}>{c.name}</span>
        </a>
      ))}

      <!-- installation stars -->
      {installations.map((b) => (
        <a
          href={b.href}
          class="area-radar__point area-radar__point--base"
          style={`left:${b.x}%;top:${b.y}%;`}
          aria-label={`${b.name} PCS housing guide`}
        >
          <svg class="area-radar__star" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 1.8l3.1 6.6 7.1.8-5.3 4.9 1.4 7-6.3-3.6-6.3 3.6 1.4-7L1.8 9.2l7.1-.8z" fill="#FF1616" stroke="#fff" stroke-width="1.2"/>
          </svg>
          <span class="area-radar__label area-radar__label--base" style={`transform:translate(${b.lx}px,${b.ly}px);`}>{b.name}</span>
        </a>
      ))}

      <!-- landmark pins (visual only) -->
      {landmarks.map((l) => (
        <span class="area-radar__landmark" style={`left:${l.x}%;top:${l.y}%;`} title={l.name} aria-hidden="true">
          <span class="area-radar__landmark-icon">{l.icon}</span>
          <span class="area-radar__landmark-name">{l.name}</span>
        </span>
      ))}

      <!-- drive-time callouts -->
      {driveTimes.map((d) => (
        <span class="area-radar__drive" style={`left:${d.x}%;top:${d.y}%;`}>{d.label}</span>
      ))}
    </div>

    <!-- legend -->
    <div class="area-radar__legend">
      <span class="area-radar__legend-item"><span class="area-radar__dot area-radar__dot--sm"></span> City guide</span>
      <span class="area-radar__legend-item">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 1.8l3.1 6.6 7.1.8-5.3 4.9 1.4 7-6.3-3.6-6.3 3.6 1.4-7L1.8 9.2l7.1-.8z" fill="#FF1616"/></svg>
        Military installation
      </span>
      <span class="area-radar__legend-item"><span class="area-radar__landmark-icon area-radar__landmark-icon--sm">◈</span> Attraction</span>
    </div>

    <!-- mobile fallback link list -->
    <div class="area-radar__mobile-list">
      <p class="area-radar__mobile-title">Browse the guides:</p>
      <div class="area-radar__mobile-links">
        {cities.map((c) => (<a href={c.href}>{c.name}</a>))}
        {installations.map((b) => (<a href={b.href}>{b.name}</a>))}
      </div>
    </div>

    <p class="area-radar__more"><a href="/explorearea/">Explore all areas →</a></p>
  </div>
</section>

<style>
  .area-radar {
    padding: 4.5rem 0;
    background: #141414;
    color: #fff;
    text-align: center;
  }
  .area-radar__kicker {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.75rem;
    font-weight: 700;
    color: #FF1616;
    margin-bottom: 0.75rem;
  }
  .area-radar__heading {
    font-size: 2.1rem;
    margin: 0 0 1rem;
    color: #fff;
  }
  .area-radar__sub {
    max-width: 640px;
    margin: 0 auto 2.5rem;
    color: #bdbdbd;
    line-height: 1.7;
  }
  .area-radar__map {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
  }
  .area-radar__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .area-radar__point {
    position: absolute;
    width: 0;
    height: 0;
    text-decoration: none;
    z-index: 3;
  }
  .area-radar__dot {
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #FF1616;
    border: 2px solid #fff;
    box-shadow: 0 0 0 4px rgba(255,22,22,0.25);
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .area-radar__point:hover .area-radar__dot {
    transform: scale(1.35);
    box-shadow: 0 0 0 7px rgba(255,22,22,0.35);
  }
  .area-radar__point--home .area-radar__dot {
    width: 16px;
    height: 16px;
    left: -8px;
    top: -8px;
    background: #fff;
    border: 3px solid #FF1616;
  }
  .area-radar__star {
    position: absolute;
    left: -9px;
    top: -9px;
    filter: drop-shadow(0 0 6px rgba(255,22,22,0.7));
    transition: transform 0.15s;
  }
  .area-radar__point--base:hover .area-radar__star {
    transform: scale(1.3);
  }
  .area-radar__label {
    position: absolute;
    left: 0;
    top: -9px;
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.9);
    transition: color 0.15s;
  }
  .area-radar__point:hover .area-radar__label {
    color: #FF1616;
  }
  .area-radar__label--base {
    color: #ffb3b3;
  }
  .area-radar__landmark {
    position: absolute;
    width: 0;
    height: 0;
    z-index: 2;
    cursor: default;
  }
  .area-radar__landmark-icon {
    position: absolute;
    left: -9px;
    top: -11px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.45);
    color: #ffd97a;
    font-size: 0.65rem;
    line-height: 17px;
    text-align: center;
  }
  .area-radar__landmark-name {
    position: absolute;
    left: 12px;
    top: -8px;
    white-space: nowrap;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }
  .area-radar__drive {
    position: absolute;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.5);
    z-index: 1;
  }
  .area-radar__legend {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
  .area-radar__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #bdbdbd;
  }
  .area-radar__dot--sm {
    position: static;
    width: 10px;
    height: 10px;
    box-shadow: none;
  }
  .area-radar__landmark-icon--sm {
    position: static;
    display: inline-block;
    line-height: 16px;
  }
  .area-radar__mobile-list {
    display: none;
  }
  .area-radar__more {
    margin-top: 1.75rem;
  }
  .area-radar__more a {
    color: #FF1616;
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 720px) {
    .area-radar__label { font-size: 0.6rem; }
    .area-radar__landmark-name { display: none; }
    .area-radar__drive { display: none; }
    .area-radar__mobile-list {
      display: block;
      margin-top: 1.5rem;
    }
    .area-radar__mobile-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #bdbdbd;
      margin-bottom: 0.75rem;
    }
    .area-radar__mobile-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }
    .area-radar__mobile-links a {
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 999px;
      padding: 0.45rem 0.9rem;
      color: #fff;
      text-decoration: none;
      font-size: 0.78rem;
    }
  }
</style>
