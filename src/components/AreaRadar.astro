---
/**
 * AreaRadar — clickable "radar screen" area map for the homepage.
 * Stylized SVG radar (rings radiate from San Antonio) with HTML overlay links:
 *  - 12 city dots → area relocation guides
 *  - 4 installation stars → per-installation PCS housing guides
 *  - 5 landmark pins with custom icons → visual markers with hover labels (not links)
 * Major highways drawn as real roads with shield icons.
 */

const cities = [
  { name: 'San Antonio', href: '/san-antonio/', x: 50, y: 50, lx: -8, ly: 68, home: true },
  { name: 'New Braunfels', href: '/new-braunfels/', x: 68, y: 35.5, lx: 14, ly: -10 },
  { name: 'Bulverde', href: '/bulverde/', x: 47, y: 33, lx: -54, ly: -8 },
  { name: 'Garden Ridge', href: '/garden-ridge/', x: 53.75, y: 37.5, lx: -30, ly: -30 },
  { name: 'Canyon Lake', href: '/canyon-lake/', x: 52, y: 24.5, lx: 14, ly: -12 },
  { name: 'Seguin', href: '/seguin/', x: 78, y: 50, lx: 14, ly: -10 },
  { name: 'Cibolo', href: '/cibolo-schertz/', x: 71.5, y: 41.7, lx: 14, ly: -14 },
  { name: 'Schertz', href: '/cibolo-schertz/', x: 64, y: 41.5, lx: 8, ly: -24 },
  { name: 'Boerne', href: '/boerne/', x: 34.5, y: 34.5, lx: -50, ly: -10 },
  { name: 'Universal City', href: '/cibolo-schertz/', x: 66, y: 52, lx: 14, ly: 20 },
  { name: 'Selma', href: '/cibolo-schertz/', x: 61, y: 48.6, lx: 14, ly: -22 },
  { name: 'Live Oak', href: '/cibolo-schertz/', x: 56.7, y: 50.3, lx: -20, ly: 30 },
];

const installations = [
  { name: 'Fort Sam Houston', href: '/military-relocation/fort-sam-houston/', x: 57, y: 46, lx: -120, ly: -6 },
  { name: 'Randolph AFB', href: '/military-relocation/randolph-afb/', x: 76, y: 44, lx: 14, ly: 14 },
  { name: 'Lackland AFB', href: '/military-relocation/lackland-afb/', x: 38, y: 60, lx: -64, ly: 6 },
  { name: 'Camp Bullis', href: '/military-relocation/camp-bullis/', x: 41.25, y: 37, lx: -62, ly: 8 },
];

const landmarks = [
  { name: 'Schlitterbahn', x: 73, y: 29.5, icon: '#icon-slide', color: '#5ab0ff', showName: true },
  { name: 'Riverwalk', x: 51, y: 55, icon: '#icon-river', color: '#4fd1c5', showName: false },
  { name: 'Spurs', x: 65, y: 56, icon: '#icon-ball', color: '#c0c0c0', showName: false },
  { name: 'Six Flags', x: 34, y: 42, icon: '#icon-coaster', color: '#ff9f43', showName: true },
  { name: 'SeaWorld', x: 33, y: 65, icon: '#icon-wave', color: '#5ab0ff', showName: false },
];

const driveTimes = [
  { label: '25 MIN · SA TO NEW BRAUNFELS', x: 50, y: 4.5 },
  { label: '80 MIN · SA TO AUSTIN', x: 50, y: 95.5 },
  { label: '35 MIN · SA TO SEGUIN', x: 5, y: 50 },
  { label: '30 MIN · SA TO BOERNE', x: 95, y: 50 },
];
---

<section class="area-radar" id="area-radar">
  <div class="container">
    <p class="area-radar__kicker">Explore the Area</p>
    <h2 class="area-radar__heading">Find Your Place in the Corridor</h2>
    <p class="area-radar__sub">
      Twelve cities, four military installations, one radar. Click anywhere on the
      dial for the full relocation guide — neighborhoods, commute times, schools,
      and what your BAH actually buys.
    </p>

    <div class="area-radar__map">
      <svg viewBox="0 0 800 800" class="area-radar__svg" role="img" aria-label="Radar-style map of Cody Posey's service area, centered on San Antonio, Texas">
        <defs>
          <!-- landmark icons -->
          <symbol id="icon-ball" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M12 3v18M3 12h18M5.5 5.5c3 3 3 10 0 13M18.5 5.5c-3 3-3 10 0 13" fill="none" stroke="currentColor" stroke-width="1.4"/>
          </symbol>
          <symbol id="icon-wave" viewBox="0 0 24 24">
            <path d="M2 9c2.5 0 2.5 2.5 5 2.5s2.5-2.5 5-2.5 2.5 2.5 5 2.5 2.5-2.5 5-2.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M2 15c2.5 0 2.5 2.5 5 2.5s2.5-2.5 5-2.5 2.5 2.5 5 2.5 2.5-2.5 5-2.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
          </symbol>
          <symbol id="icon-river" viewBox="0 0 24 24">
            <path d="M7 3c0 5 10 5 10 9s-10 4-10 9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
          </symbol>
          <symbol id="icon-coaster" viewBox="0 0 24 24">
            <path d="M2 18c4-1 5-12 9-12s3 8 7 8 4-4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M7 18v-6M12 18v-8M17 18v-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </symbol>
          <symbol id="icon-slide" viewBox="0 0 24 24">
            <path d="M4 4c8 2 10 12 16 14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M4 9c5 1.5 7 7 11 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.6"/>
            <circle cx="18" cy="19" r="1.8" fill="currentColor"/>
          </symbol>
          <!-- interstate shield -->
          <symbol id="shield-i" viewBox="0 0 40 44">
            <path d="M20 2l14 6v12c0 10-6 17-14 22C12 37 6 30 6 20V8z" fill="#1a3a6b" stroke="#fff" stroke-width="2"/>
            <path d="M6 8l14-6 14 6v5H6z" fill="#c0392b"/>
          </symbol>
          <!-- state/us highway shield -->
          <symbol id="shield-h" viewBox="0 0 40 40">
            <rect x="3" y="5" width="34" height="30" rx="7" fill="#f5f5f5" stroke="#222" stroke-width="2"/>
          </symbol>
        </defs>

        <!-- concentric radar rings -->
        <g fill="none" stroke="rgba(255,255,255,0.14)" stroke-dasharray="6 8">
          <circle cx="400" cy="400" r="360" stroke-width="1.5" />
          <circle cx="400" cy="400" r="270" stroke-width="1" />
          <circle cx="400" cy="400" r="180" stroke-width="1" />
          <circle cx="400" cy="400" r="90" stroke-width="1" />
        </g>
        <!-- crosshairs -->
        <g stroke="rgba(255,255,255,0.07)" stroke-width="1">
          <line x1="400" y1="20" x2="400" y2="780" />
          <line x1="20" y1="400" x2="780" y2="400" />
        </g>

        <!-- ======== HIGHWAYS (casing + surface) ======== -->
        <g fill="none" stroke-linecap="round">
          <!-- casing -->
          <g stroke="#0a0a0a" stroke-width="9">
            <path d="M 300 560 L 400 400 L 478 368 L 545 285 L 605 195" />
            <path d="M 110 432 L 400 400 L 705 378" />
            <path d="M 400 400 L 410 280 L 415 190" />
            <path d="M 545 285 L 430 300 L 340 282 L 272 272" />
            <path d="M 400 400 L 470 510 L 530 610" />
          </g>
          <!-- I-35 surface: red -->
          <path d="M 300 560 L 400 400 L 478 368 L 545 285 L 605 195" stroke="#FF1616" stroke-width="4.5" opacity="0.85"/>
          <!-- other highways surface: light -->
          <g stroke="#e8e8e8" stroke-width="3.5" opacity="0.9">
            <path d="M 110 432 L 400 400 L 705 378" />
            <path d="M 400 400 L 410 280 L 415 190" />
            <path d="M 545 285 L 430 300 L 340 282 L 272 272" />
            <path d="M 400 400 L 470 510 L 530 610" />
          </g>
        </g>
        <!-- Loop 1604 -->
        <g fill="none">
          <ellipse cx="400" cy="400" rx="185" ry="140" stroke="#0a0a0a" stroke-width="8" transform="rotate(-12 400 400)" />
          <ellipse cx="400" cy="400" rx="185" ry="140" stroke="#e8e8e8" stroke-width="3" stroke-dasharray="12 7" transform="rotate(-12 400 400)" opacity="0.85" />
        </g>

        <!-- highway shields -->
        <g font-family="inherit" font-weight="700" text-anchor="middle">
          <g transform="translate(362,466)"><use href="#shield-i" width="30" height="33" x="-15" y="-16"/><text x="0" y="8" font-size="13" fill="#fff">35</text></g>
          <g transform="translate(170,420)"><use href="#shield-i" width="30" height="33" x="-15" y="-16"/><text x="0" y="8" font-size="13" fill="#fff">10</text></g>
          <g transform="translate(420,266)"><use href="#shield-h" width="34" height="34" x="-17" y="-17"/><text x="0" y="6" font-size="12" fill="#111">281</text></g>
          <g transform="translate(352,282)"><use href="#shield-h" width="34" height="34" x="-17" y="-17"/><text x="0" y="6" font-size="12" fill="#111">46</text></g>
          <g transform="translate(590,420)"><use href="#shield-h" width="40" height="34" x="-20" y="-17"/><text x="0" y="6" font-size="11" fill="#111">1604</text></g>
        </g>

        <!-- water -->
        <g fill="rgba(120,170,220,0.20)">
          <ellipse cx="415" cy="195" rx="42" ry="26" transform="rotate(-18 415 195)" />
        </g>
        <!-- water / county labels -->
        <g fill="rgba(255,255,255,0.30)" font-size="13" letter-spacing="3" text-anchor="middle" font-family="inherit">
                    <text x="400" y="560">BEXAR CO.</text>
          <text x="690" y="445">GUADALUPE CO.</text>
          <text x="180" y="300">KENDALL CO.</text>
          <text x="590" y="150">COMAL CO.</text>
        </g>
        <!-- compass -->
        <g fill="rgba(255,255,255,0.55)" font-size="16" font-weight="700" text-anchor="middle" font-family="inherit">
          <text x="400" y="52">N</text>
          <path d="M 400 60 L 394 74 L 406 74 Z" />
        </g>
      </svg>

      <!-- clickable city dots -->
      {cities.map((c) => (
        <a
          href={c.href}
          class={'area-radar__point' + (c.home ? ' area-radar__point--home' : '')}
          style={`left:${c.x}%;top:${c.y}%;`}
          aria-label={`${c.name} relocation guide`}
        >
          <span class="area-radar__dot"></span>
          <span class="area-radar__label" style={`transform:translate(${c.lx}px,${c.ly}px);`}>{c.name}</span>
        </a>
      ))}

      <!-- installation stars -->
      {installations.map((b) => (
        <a
          href={b.href}
          class="area-radar__point area-radar__point--base"
          style={`left:${b.x}%;top:${b.y}%;`}
          aria-label={`${b.name} PCS housing guide`}
        >
          <svg class="area-radar__star" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 1.8l3.1 6.6 7.1.8-5.3 4.9 1.4 7-6.3-3.6-6.3 3.6 1.4-7L1.8 9.2l7.1-.8z" fill="#FF1616" stroke="#fff" stroke-width="1.2"/>
          </svg>
          <span class="area-radar__label area-radar__label--base" style={`transform:translate(${b.lx}px,${b.ly}px);`}>{b.name}</span>
        </a>
      ))}

      <!-- landmark pins (visual only) -->
      {landmarks.map((l) => (
        <span class="area-radar__landmark" style={`left:${l.x}%;top:${l.y}%;`} title={l.name} aria-label={l.name}>
          <svg class="area-radar__pin" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="#161616" stroke="rgba(255,255,255,0.55)" stroke-width="1.5"/>
            <use href={l.icon} x="8" y="8" width="16" height="16" style={`color:${l.color}`} />
          </svg>
          {l.showName && <span class="area-radar__landmark-name">{l.name}</span>}
        </span>
      ))}

      <!-- drive-time callouts -->
      {driveTimes.map((d) => (
        <span class="area-radar__drive" style={`left:${d.x}%;top:${d.y}%;`}>{d.label}</span>
      ))}
    </div>

    <!-- legend -->
    <div class="area-radar__legend">
      <span class="area-radar__legend-item"><span class="area-radar__dot area-radar__dot--sm"></span> City guide</span>
      <span class="area-radar__legend-item">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 1.8l3.1 6.6 7.1.8-5.3 4.9 1.4 7-6.3-3.6-6.3 3.6 1.4-7L1.8 9.2l7.1-.8z" fill="#FF1616"/></svg>
        Military installation
      </span>
      <span class="area-radar__legend-item">
        <svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="#161616" stroke="rgba(255,255,255,0.55)" stroke-width="2"/><use href="#icon-ball" x="9" y="9" width="14" height="14" style="color:#c0c0c0"/></svg>
        Attraction
      </span>
    </div>

    <!-- mobile fallback link list -->
    <div class="area-radar__mobile-list">
      <p class="area-radar__mobile-title">Browse the guides:</p>
      <div class="area-radar__mobile-links">
        {cities.map((c) => (<a href={c.href}>{c.name}</a>))}
        {installations.map((b) => (<a href={b.href}>{b.name}</a>))}
      </div>
    </div>

    <p class="area-radar__more"><a href="/explorearea/">Explore all areas →</a></p>
  </div>
</section>

<style>
  .area-radar {
    padding: 4.5rem 0;
    background: #141414;
    color: #fff;
    text-align: center;
  }
  .area-radar__kicker {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.75rem;
    font-weight: 700;
    color: #FF1616;
    margin-bottom: 0.75rem;
  }
  .area-radar__heading {
    font-size: 2.1rem;
    margin: 0 0 1rem;
    color: #fff;
  }
  .area-radar__sub {
    max-width: 640px;
    margin: 0 auto 2.5rem;
    color: #bdbdbd;
    line-height: 1.7;
  }
  .area-radar__map {
    position: relative;
    max-width: 720px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
  }
  .area-radar__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .area-radar__point {
    position: absolute;
    width: 0;
    height: 0;
    text-decoration: none;
    z-index: 3;
  }
  .area-radar__dot {
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #FF1616;
    border: 2px solid #fff;
    box-shadow: 0 0 0 4px rgba(255,22,22,0.25);
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .area-radar__point:hover .area-radar__dot {
    transform: scale(1.35);
    box-shadow: 0 0 0 7px rgba(255,22,22,0.35);
  }
  .area-radar__point--home .area-radar__dot {
    width: 16px;
    height: 16px;
    left: -8px;
    top: -8px;
    background: #fff;
    border: 3px solid #FF1616;
  }
  .area-radar__star {
    position: absolute;
    left: -9px;
    top: -9px;
    filter: drop-shadow(0 0 6px rgba(255,22,22,0.7));
    transition: transform 0.15s;
  }
  .area-radar__point--base:hover .area-radar__star {
    transform: scale(1.3);
  }
  .area-radar__label {
    position: absolute;
    left: 0;
    top: -9px;
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 4px rgba(0,0,0,0.9);
    transition: color 0.15s;
  }
  .area-radar__point:hover .area-radar__label {
    color: #FF1616;
  }
  .area-radar__label--base {
    color: #ffb3b3;
  }
  .area-radar__landmark {
    position: absolute;
    width: 0;
    height: 0;
    z-index: 2;
    cursor: default;
  }
  .area-radar__pin {
    position: absolute;
    left: -15px;
    top: -15px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.6));
  }
  .area-radar__landmark-name {
    position: absolute;
    left: 18px;
    top: -8px;
    white-space: nowrap;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
  }
  .area-radar__drive {
    position: absolute;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.5);
    z-index: 1;
  }
  .area-radar__legend {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
  .area-radar__legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #bdbdbd;
  }
  .area-radar__dot--sm {
    position: static;
    width: 10px;
    height: 10px;
    box-shadow: none;
  }
  .area-radar__mobile-list {
    display: none;
  }
  .area-radar__more {
    margin-top: 1.75rem;
  }
  .area-radar__more a {
    color: #FF1616;
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 720px) {
    .area-radar__label { font-size: 0.6rem; }
    .area-radar__landmark-name { display: none; }
    .area-radar__drive { display: none; }
    .area-radar__mobile-list {
      display: block;
      margin-top: 1.5rem;
    }
    .area-radar__mobile-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #bdbdbd;
      margin-bottom: 0.75rem;
    }
    .area-radar__mobile-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }
    .area-radar__mobile-links a {
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 999px;
      padding: 0.45rem 0.9rem;
      color: #fff;
      text-decoration: none;
      font-size: 0.78rem;
    }
  }
</style>
