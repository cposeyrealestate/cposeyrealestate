---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ParallaxBanner from '../../components/ParallaxBanner.astro';
import ContactForm from '../../components/ContactForm.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { placeSchema, collectionPageSchema, breadcrumbSchema, faqSchema, videoObjectSchema } from '../../lib/schema';

const csDescription = "Cibolo & Schertz, TX homes for sale: SCUCISD schools, 10–20 minutes to JBSA-Randolph, and median home values near $350K. Cody Posey's 2026 relocation guide.";

const faqs = [
  {
    q: 'What do homes cost in Cibolo and Schertz?',
    a: 'Median home values in the Cibolo/Schertz area sit near $350K (ESRI, August 2026: $358K in Cibolo, $346K in Schertz). Older resale homes start in the low $300s, while newer construction in master-planned communities runs into the mid-$400s — new construction median sale price was $479K in August 2026. Compared to north San Antonio neighborhoods with similar schools, you typically get more square footage per dollar here.',
  },
  {
    q: 'Is Cibolo/Schertz a good fit for a military family PCSing to JBSA-Randolph?',
    a: 'It is one of the strongest fits in the San Antonio metro. Randolph AFB borders Schertz to the east, so many neighborhoods are 10–20 minutes from the gate, and a large share of residents are active-duty, retired military, or DoD civilians. VA loans are widely used and accepted, and the transient-friendly community makes PCS integration fast. One caution: homes near the base fall under Randolph\'s AICUZ noise contours, which can trigger land-use restrictions and disclosure requirements in a transaction — I flag affected listings before we tour them.',
  },
  {
    q: 'How are the schools in Cibolo and Schertz?',
    a: 'The area is served by Schertz-Cibolo-Universal City ISD (SCUCISD), which earned an overall B (81) in the 2026 TEA accountability release, with Byron P. Steele II High School earning an A and both Steele and Samuel Clemens consistently ranking in the top 30% of Texas high schools. Campus ratings vary within the district, so always verify the campus assigned to a specific address before buying — that detail affects resale value as much as academics.',
  },
  {
    q: 'What should I watch out for before buying in Cibolo or Schertz?',
    a: 'Three things: traffic, taxes, and new construction fine print. I-35 and Loop 1604 are the commute choke points — test your actual drive at your actual hours before committing. Effective property tax rates in this corridor typically run 1.8–2.3%, but newer communities with MUD or PID financing can push rates above 2.3%, which meaningfully changes your monthly payment. Get the exact total tax rate in writing on any new build before you sign.',
  },
];

const pageSchema = [
  placeSchema({ name: 'Cibolo, TX', description: csDescription, url: '/cibolo-schertz/', image: '/images/areas/cibolo-schertz.jpg' }),
  placeSchema({ name: 'Schertz, TX', description: csDescription, url: '/cibolo-schertz/', image: '/images/areas/cibolo-schertz.jpg' }),
  collectionPageSchema({
    name: 'Cibolo & Schertz Area Guide',
    description: csDescription,
    url: '/cibolo-schertz/',
    hasPart: [
      { name: 'Neighborhoods', url: '/cibolo-schertz/neighborhoods/' },
      { name: 'Restaurants', url: '/cibolo-schertz/restaurants/' },
      { name: 'Things to Do', url: '/cibolo-schertz/things-to-do/' },
    ],
  }),
  faqSchema(faqs),
  videoObjectSchema({
    videoId: 'TTGTwpJbJ1Y',
    title: 'Why Everyone Is Moving to this Schertz Neighborhood!',
    description: 'Why everyone is moving to Schertz, Texas — neighborhoods, schools, and the JBSA-Randolph corridor, from a retired Army First Sergeant and REALTOR.',
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Hill Country Relocation Guide', url: '/hill-country-relocation-guide/' },
    { name: 'Cibolo & Schertz', url: '/cibolo-schertz/' },
  ]),
];
---

<Layout
  title="Cibolo & Schertz, TX Homes for Sale | 2026 Relocation Guide"
  description={csDescription}
  schema={pageSchema}
>
  <Navbar />
  <main style="padding-top: 80px;">

    <!-- 1. Hero -->
    <div class="cs-hero">
      <div class="cs-hero__overlay"></div>
      <div class="cs-hero__content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span>/</span> <span>Cibolo / Schertz</span>
        </nav>
        <p class="cs-hero__eyebrow">2026 Relocation Guide · I-35 Corridor · Minutes from JBSA-Randolph</p>
        <h1>Cibolo &amp; <span style="color:#FF1616;">Schertz</span> Homes for Sale</h1>
        <p>The military-family favorite on San Antonio's northeast side — SCUCISD schools, new construction, and a straight shot to Randolph AFB.</p>
      </div>
    </div>

    <!-- 2. Stat band -->
    <section class="cs-statband" aria-label="Key facts">
      <div class="container cs-statband__grid">
        <div class="cs-stat">
          <span class="cs-stat__number">85K+</span>
          <span class="cs-stat__label">Combined Population</span>
        </div>
        <div class="cs-stat">
          <span class="cs-stat__number">$345–358K</span>
          <span class="cs-stat__label">Median Home Value</span>
        </div>
        <div class="cs-stat">
          <span class="cs-stat__number">10–20 min</span>
          <span class="cs-stat__label">To JBSA-Randolph</span>
        </div>
        <div class="cs-stat">
          <span class="cs-stat__number">B (81)</span>
          <span class="cs-stat__label">SCUCISD, 2026 TEA</span>
        </div>
      </div>
      <p class="cs-statband__source">Population and home-value figures as of September 2026 (ESRI Aug 2026 data, World Population Review 2026 estimates). Drive times are off-peak ranges.</p>
      <div class="container">
        <div class="cs-video">
          <h3>Watch: Why Everyone Is Moving to this Schertz Neighborhood!</h3>
          <div class="cs-video__frame">
            <iframe
              src="https://www.youtube.com/embed/TTGTwpJbJ1Y"
              title="Why Everyone Is Moving to this Schertz Neighborhood!"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Honest overview -->
    <section class="section">
      <div class="container">
        <div class="cs-overview__grid">
          <div class="cs-overview__text">
            <h2>The <span class="accent">Honest Overview</span></h2>
            <p>Cibolo and Schertz sit side by side in Guadalupe County, straddling I-35 between San Antonio and New Braunfels. Together they house roughly 85,000 people, and the draw is no mystery: SCUCISD schools, family-oriented neighborhoods at a discount to north San Antonio, and Randolph Air Force Base — now part of Joint Base San Antonio — bordering Schertz to the east. A large percentage of residents are active-duty, retired military, or DoD civilians, which makes this one of the most transient-friendly, newcomer-welcoming communities in the metro. As a veteran, I work with a lot of PCS buyers here, and the rhythm is familiar: short timelines, VA loans, and families who need a neighborhood that feels like home on day one.</p>
            <p>The housing stock splits into two lanes. Established neighborhoods built in the early 2000s offer mature landscaping, larger lots, and prices starting in the low $300s. Newer master-planned communities bring modern floor plans, amenity centers, and price tags into the mid-$400s. Retail has kept pace — the Schertz Parkway and FM 3009 corridors cover daily needs, and the Forum shopping corridor in Selma sits right next door for bigger trips. The Schertz Civic Center hosts concerts, festivals, and farmers markets, while Cibolo's trail network ties neighborhoods to parks and retail.</p>
            <p>Now the watch-outs, because you deserve them before you tour. I-35 and Loop 1604 are genuine commute bottlenecks — a 20-minute drive to San Antonio off-peak can double at rush hour, so test your real route at your real hours. New construction comes with new-construction taxes: MUD and PID financing in some communities can push effective property tax rates above 2.3%, which adds hundreds to your monthly payment versus an older resale at 1.8–2.0%. And if you're buying near Randolph AFB, know that AICUZ noise contours can trigger disclosure requirements and land-use restrictions on affected homes — I check for this on every listing east of I-35.</p>
          </div>
          <div class="cs-why__cards">
            <div class="cs-why__card">
              <h3>Military-Friendly</h3>
              <p>10–20 minutes to JBSA-Randolph. Active-duty and veteran families everywhere, VA loans widely accepted, newcomers absorbed fast.</p>
            </div>
            <div class="cs-why__card">
              <h3>SCUCISD Schools</h3>
              <p>B (81) in the 2026 TEA release, with Steele II earning an A. Campus ratings vary — verify the address assignment before buying.</p>
            </div>
            <div class="cs-why__card">
              <h3>Value per Square Foot</h3>
              <p>Median home value near $350K gets you more house here than in comparable north San Antonio school zones.</p>
            </div>
            <div class="cs-why__card">
              <h3>I-35 Corridor Location</h3>
              <p>San Antonio one way, New Braunfels the other, Austin an hour up the interstate. Both metros are realistically commutable.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Neighborhoods -->
    <section class="section" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>Top <span class="accent">Neighborhoods</span></h2>
          <p>Four of the strongest communities in the Cibolo/Schertz corridor</p>
        </div>
        <div class="cs-nbh__grid">
          <div class="cs-nbh__card">
            <h3>Saddle Creek Ranch</h3>
            <p>A long-established Schertz community with mature trees, larger lots, and a neighborhood lake and park system. Popular with military families for its proximity to the Randolph gate and solid resale history.</p>
          </div>
          <div class="cs-nbh__card">
            <h3>Falcon Ridge</h3>
            <p>Newer Schertz construction with modern floor plans and community amenities. A frequent landing spot for PCS buyers who want a new build without the MUD/PID tax surprise — confirm the rate before writing an offer.</p>
          </div>
          <div class="cs-nbh__card">
            <h3>Bentwood Ranch</h3>
            <p>Cibolo community blending established resales with newer sections. Quiet, family-oriented streets with quick FM 3009 access to I-35 and the retail corridor.</p>
          </div>
          <div class="cs-nbh__card">
            <h3>Cibolo Valley Ranch</h3>
            <p>Cibolo's growth-front community with newer homes, trails, and amenity centers. Strong appeal for young families trading commute time for square footage and new-build warranties.</p>
          </div>
        </div>
        <div style="text-align:center; margin-top:2rem;">
          <a href="/cibolo-schertz/neighborhoods/" class="btn btn-primary">Explore All Neighborhoods</a>
        </div>
      </div>
    </section>

    <!-- 5. Cost snapshot -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>Cost <span class="accent">Snapshot</span></h2>
          <p>What it actually costs to buy in Cibolo and Schertz</p>
        </div>
        <div class="cs-cost__grid">
          <div class="cs-cost__card">
            <span class="cs-cost__value">$345–358K</span>
            <span class="cs-cost__label">Median home value (ESRI, Aug 2026)</span>
            <p>Schertz: $346K · Cibolo: $358K. Older resales start in the low $300s; new construction in master-planned communities runs into the mid-$400s.</p>
          </div>
          <div class="cs-cost__card">
            <span class="cs-cost__value">$479K</span>
            <span class="cs-cost__label">New-construction median sale price (Aug 2026)</span>
            <p>New builds carry a premium here. Builders offer rate buydowns and incentives that can beat resale math — bring a buyer-side agent even when the builder has one on site.</p>
          </div>
          <div class="cs-cost__card">
            <span class="cs-cost__value">1.8–2.3%+</span>
            <span class="cs-cost__label">Typical effective property tax range</span>
            <p>No state income tax, but property taxes do the work in Texas. Newer MUD/PID communities can exceed 2.3% — get the exact total rate in writing before you sign a new-build contract.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Schools -->
    <section class="section" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>School <span class="accent">District</span></h2>
          <p>One district serves nearly the entire corridor</p>
        </div>
        <div class="cs-schools__grid">
          <a href="https://www.scuc.txed.net" target="_blank" rel="noopener" class="cs-schools__card">
            <h3>Schertz-Cibolo-Universal City ISD (SCUCISD)</h3>
            <p>Overall B (81) in the 2026 TEA accountability release. Byron P. Steele II High School earned an A, and both Steele and Samuel Clemens rank in the top 30% of Texas high schools with a 94%+ graduation rate. The district serves Schertz, Cibolo, Universal City, and Selma. Campus ratings vary — verify the assignment for your address.</p>
            <span class="cs-schools__link">Visit SCUCISD Website →</span>
          </a>
        </div>
        <p class="cs-schools__note">School assignments are based on physical address. Always verify directly with the district before purchasing.</p>
      </div>
    </section>

    <!-- 7. Commute -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>Commute <span class="accent">Times</span></h2>
          <p>Off-peak ranges — verify your actual route at your actual hours</p>
        </div>
        <div class="cs-commute__grid">
          <div class="cs-commute__card">
            <span class="cs-commute__time">10–20 min</span>
            <h3>JBSA-Randolph</h3>
            <p>Randolph AFB borders Schertz to the east. The gate commute is the corridor's whole pitch — but check AICUZ noise contours on homes nearest the base.</p>
          </div>
          <div class="cs-commute__card">
            <span class="cs-commute__time">20–30 min</span>
            <h3>San Antonio</h3>
            <p>Downtown and the Medical Center run down I-35. Rush hour regularly adds 15–25 minutes — Loop 1604 is the other choke point worth knowing.</p>
          </div>
          <div class="cs-commute__card">
            <span class="cs-commute__time">~60 min</span>
            <h3>Austin</h3>
            <p>Doable for hybrid schedules and weekend trips; a daily drive grinds on I-35. San Antonio International Airport is roughly 25–30 minutes south.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Things to Do / Restaurants -->
    <section class="section cs-explore" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>Explore <span class="accent">Cibolo / Schertz</span></h2>
          <p>Dig deeper into the neighborhoods, homes, and lifestyle that matter to you</p>
        </div>
        <div class="cs-explore__grid">
          <a href="/cibolo-schertz/things-to-do/" class="cs-explore__card">
            <h3>Things to Do</h3>
            <p>Nature parks, wildlife safaris, live entertainment, and outdoor adventures in and around the area — including SchertzFest and CiboloFest each year.</p>
          </a>
          <a href="/cibolo-schertz/restaurants/" class="cs-explore__card">
            <h3>Restaurants</h3>
            <p>From wings and Tex-Mex to authentic Thai — the best local spots to eat in the Cibolo/Schertz area.</p>
          </a>
          <a href="/cibolo-schertz/neighborhoods/" class="cs-explore__card">
            <h3>Neighborhoods</h3>
            <p>Explore the top communities in Cibolo and Schertz — from established favorites to newer developments.</p>
          </a>
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="cs-explore__card">
            <h3>Home Search</h3>
            <p>Search current listings in Cibolo and Schertz. Filter by price, area, and home type to find what's available now.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 9. FAQ -->
    <section class="faq-section">
      <div class="container">
        <h2>Frequently Asked Questions About <span class="accent">Cibolo and Schertz</span></h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Video -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>Watch: Living in <span class="accent">Cibolo &amp; Schertz</span></h2>
        </div>
        <VideoEmbed
          videoId="8yrbdE5mBZw"
          title="Living in Cibolo/Schertz Texas | One of San Antonio's Top Suburbs!"
          description="A full tour of living in Cibolo and Schertz — neighborhoods, SCUC schools, commutes to San Antonio and JBSA, and what homes cost in each."
          uploadDate="2026-05-30"
        />
      </div>
    </section>

    <!-- 10. CTA -->
    <section class="section cs-cta-parallax">
      <div class="cs-cta-parallax__overlay"></div>
      <div class="container cs-cta-parallax__content">
        <h2>Ready to Explore <span class="accent">Cibolo / Schertz</span>?</h2>
        <p>Whether you're PCSing to Randolph and need a home in 30 days, or just starting your search — I can help you navigate the market and find the right fit.</p>
        <div class="cs-cta__buttons">
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="btn btn-primary">Search Homes</a>
          <a href="#contact" class="btn btn-outline">Ask About Cibolo / Schertz</a>
        </div>
      </div>
    </section>

  </main>
  <ParallaxBanner image="/images/areas/cibolo-schertz.jpg" />

  <ContactForm context="I'd like to learn more about Cibolo and Schertz..." />
  <Footer />
</Layout>

<style>
  /* FAQ */
  .faq-section {
    padding: 4rem 0;
    background: #f9f9f9;
  }
  .faq-section h2 {
    text-align: center;
    margin-bottom: 2rem;
  }
  .faq-list {
    max-width: 800px;
    margin: 0 auto;
  }
  .faq-item {
    background: #fff;
    border: 1px solid #eee;
    margin-bottom: 1rem;
    padding: 0;
  }
  .faq-item summary {
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    cursor: pointer;
    font-size: 1rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 1.3rem;
    color: #FF1616;
    font-weight: 700;
  }
  .faq-item[open] summary::after {
    content: '\2212';
  }
  .faq-item p {
    padding: 0 1.5rem 1.25rem;
    color: #555;
    line-height: 1.8;
    font-size: 0.95rem;
  }

  /* Hero */
  .cs-hero {
    position: relative;
    height: 360px;
    background: url('/images/areas/cibolo-schertz.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
  }

  .cs-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
  }

  .cs-hero__content {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
  }

  .cs-hero__eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.75rem;
  }

  .cs-hero__content h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 0.75rem;
  }

  .cs-hero__content p {
    color: rgba(255,255,255,0.7);
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-size: 0.8rem;
    margin-bottom: 1rem;
    color: rgba(255,255,255,0.5);
  }

  .breadcrumb a {
    color: rgba(255,255,255,0.5);
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: #FF1616;
  }

  .breadcrumb span {
    margin: 0 0.3rem;
  }

  /* Stat band */
  .cs-statband {
    background: #000;
    padding: 2.5rem 0 1.5rem;
    color: #fff;
  }

  .cs-statband__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    text-align: center;
  }

  .cs-stat__number {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: #FF1616;
  }

  .cs-stat__label {
    display: block;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cs-statband__source {
    text-align: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
    margin-top: 1.25rem;
    padding: 0 1.5rem;
  }
  .cs-video { max-width: 900px; margin: 2.5rem auto 0; }
  .cs-video h3 { font-size: 1.15rem; margin-bottom: 1rem; color: #fff; }
  .cs-video__frame { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; }
  .cs-video__frame iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }

  /* Overview */
  .cs-overview__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .cs-overview__text p {
    color: var(--gray);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .cs-why__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .cs-why__card {
    background: #fff;
    padding: 1.75rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .cs-why__card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .cs-why__card p {
    color: var(--gray);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Neighborhood cards */
  .cs-nbh__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .cs-nbh__card {
    background: #fff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    border-left: 4px solid #FF1616;
  }

  .cs-nbh__card h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .cs-nbh__card p {
    color: var(--gray);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Cost cards */
  .cs-cost__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .cs-cost__card {
    background: #fff;
    border: 1px solid var(--light-gray);
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }

  .cs-cost__value {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: #FF1616;
    margin-bottom: 0.25rem;
  }

  .cs-cost__label {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gray);
    margin-bottom: 1rem;
  }

  .cs-cost__card p {
    color: var(--gray);
    font-size: 0.85rem;
    line-height: 1.7;
    text-align: left;
  }

  /* Commute cards */
  .cs-commute__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .cs-commute__card {
    background: #fff;
    border: 1px solid var(--light-gray);
    padding: 2rem;
    border-radius: 8px;
