---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { placeSchema, articleSchema, collectionPageSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

const sgTitle = 'Seguin, TX Homes for Sale | 2026 Relocation Guide';
const sgDescription = 'Seguin, TX homes for sale: median ~$289K, 35 min to San Antonio, Guadalupe River living. Explore neighborhoods, schools, commute, and honest 2026 cost data.';

const faqs = [
  {
    q: 'Is Seguin a good place to buy a first home?',
    a: 'Seguin is one of the best markets in the greater San Antonio region for first-time homebuyers. The median sale price runs in the $275K-$290K range as of Sept 2026 — significantly lower than New Braunfels, San Marcos, or San Antonio proper — so buyers can often get a newer, larger home for less money. Several master-planned communities offer new construction in the mid-$200s, and established neighborhoods carry well-maintained homes at even lower price points.',
  },
  {
    q: 'What are the major employers in Seguin?',
    a: 'Seguin has a manufacturing-anchored job base. Caterpillar operates a large hydraulic excavator plant here, Continental Automotive and Tyson Foods have major presences, and Guadalupe Regional Medical Center anchors the healthcare sector. Texas Lutheran University contributes to the local economy as well. That said, the local job base is smaller than San Antonio or New Braunfels — many residents commute to San Antonio (about 35 minutes via I-10) for broader career options.',
  },
  {
    q: 'How far is Seguin from San Antonio, New Braunfels, and Austin?',
    a: 'Seguin is approximately 35 minutes east of downtown San Antonio via I-10 and about 20 minutes south of New Braunfels via TX-46. Austin is roughly an hour away (about 50 miles, fastest via the TX-130 toll road). For day-to-day needs, Seguin has its own grocery stores, medical facilities, and retail, so you do not need to leave town for routine errands.',
  },
  {
    q: 'What are property taxes like in Seguin?',
    a: 'Seguin property taxes run roughly 2.0-2.3% of assessed value per year when you combine the city, Guadalupe County, Seguin ISD, and other taxing units. On a $289K home that works out to roughly $5,800-$6,600 per year — meaningful for your monthly payment, so factor it into your budget from the start. File for your homestead exemption immediately after closing to reduce the taxable value.',
  },
];

const pageSchema = [
  placeSchema({ name: 'Seguin, TX', description: sgDescription, url: '/seguin/', image: '/images/areas/seguin.jpg' }),
  articleSchema({
    title: sgTitle,
    description: sgDescription,
    url: '/seguin/',
    image: '/images/areas/seguin.jpg',
    datePublished: '2026-10-01',
    dateModified: '2026-10-01',
  }),
  collectionPageSchema({
    name: 'Seguin Area Guide',
    description: sgDescription,
    url: '/seguin/',
    hasPart: [
      { name: 'Neighborhoods', url: '/seguin/neighborhoods/' },
      { name: 'Restaurants', url: '/seguin/restaurants/' },
      { name: 'Things to Do', url: '/seguin/things-to-do/' },
    ],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Hill Country Relocation Guide', url: '/hill-country-relocation-guide/' },
    { name: 'Seguin', url: '/seguin/' },
  ]),
  faqSchema(faqs),
];
---

<Layout
  title={sgTitle}
  description={sgDescription}
  schema={pageSchema}
>
  <Navbar />
  <main style="padding-top: 80px;">

    <!-- 1. Hero -->
    <div class="seg-hero">
      <div class="seg-hero__overlay"></div>
      <div class="seg-hero__content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span>/</span> <span>Seguin</span>
        </nav>
        <h1><span style="color:#FF1616;">Seguin</span>, TX</h1>
        <p>2026 Relocation Guide: the affordability play on the Guadalupe River — 35 minutes from San Antonio</p>
      </div>
    </div>

    <!-- 2. Stat Band -->
    <section class="section seg-stats" style="background: var(--light-gray);">
      <div class="container">
        <div class="seg-stats__grid">
          <div class="seg-stat">
            <span class="seg-stat__number">~39K</span>
            <span class="seg-stat__label">Population (2024 Census est.; up ~32% since 2020)</span>
          </div>
          <div class="seg-stat">
            <span class="seg-stat__number">$289K</span>
            <span class="seg-stat__label">Median Sale Price (Sept 2026)</span>
          </div>
          <div class="seg-stat">
            <span class="seg-stat__number">35 min</span>
            <span class="seg-stat__label">To San Antonio via I-10</span>
          </div>
          <div class="seg-stat">
            <span class="seg-stat__number">227 acres</span>
            <span class="seg-stat__label">Max Starcke Park on the Guadalupe</span>
          </div>
        </div>
        <p class="seg-stats__note">Stats verified as of Sept 2026. Population: U.S. Census Bureau 2024 annual estimate; Seguin ranked the fastest-growing city in the San Antonio metro. Price: Sept 2026 market data; typical sold range $208K-$414K (Aug 2026).</p>
      </div>
    </section>

    <!-- 3. Honest Overview -->
    <section class="section seg-overview">
      <div class="container">
        <div class="seg-overview__text">
          <h2>The <span class="accent">Honest Overview</span></h2>
          <p>Seguin is a historic city on the Guadalupe River, about 35 miles east of San Antonio. Named after Texas Revolution hero Juan Seguin and founded in 1838, it is one of the oldest cities in Texas — pecan-lined streets, a revitalized Main Street downtown, and restored Victorian and German-style homes in the historic district. Major employers like Caterpillar, Continental Automotive, and Tyson Foods anchor a manufacturing job base, and Texas Lutheran University adds culture and economic stability. For buyers, the headline is simple: Seguin is the most affordable market on the I-35/I-10 corridor, with new construction from the mid-$200s and median sale prices roughly half of what you'd pay for a comparable new build in parts of New Braunfels or Austin.</p>
          <p>The watch-outs, stated plainly: the local job base is narrower than San Antonio's or New Braunfels' — a meaningful share of residents commutes to San Antonio, and that 35-minute I-10 drive becomes 50+ minutes during rush hour, so test the commute from your likely work location before you commit. Property taxes run roughly 2.0-2.3% of assessed value per year across all taxing units, which adds real money to the monthly payment on any home here. And Seguin is a growing city, not a finished one — retail, dining, and infrastructure are catching up to the population, so if you need every amenity within five minutes, New Braunfels or the metro may fit better. But if you want more house for the money, river access, and a genuine small-town feel that still commutes to the big city, Seguin delivers.</p>
        </div>
      </div>
    </section>

    <!-- 4. Neighborhoods -->
    <section class="section seg-neighborhoods" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>Seguin <span class="accent">Neighborhoods</span></h2>
          <p>Top picks across price points — full breakdowns on the neighborhoods page</p>
        </div>
        <div class="seg-grid-4">
          <div class="seg-card">
            <h3>Village of Mill Creek</h3>
            <p class="seg-card__price">$200K - $320K</p>
            <p>Quiet, family-friendly community with larger lots than surrounding areas and a close-knit feel. Easy access to New Braunfels, Randolph AFB, and the Guadalupe River. Some sections have no HOA.</p>
          </div>
          <div class="seg-card">
            <h3>Cordova Crossing</h3>
            <p class="seg-card__price">$280K - $400K</p>
            <p>One of Seguin's newer developments: contemporary designs, open layouts, smart-home tech, energy-efficient builds, plus a playground, dog park, and trails. The master-planned feel at a non-metro price.</p>
          </div>
          <div class="seg-card">
            <h3>Nob Hill</h3>
            <p class="seg-card__price">$250K - $350K</p>
            <p>Established community anchored by Nob Hill Condominiums — a budget-friendly entry into homeownership with mature trees, a community pool and clubhouse, and HOA-managed exteriors. Appeals to first-time buyers and downsizers.</p>
          </div>
          <div class="seg-card">
            <h3>Downtown Seguin</h3>
            <p class="seg-card__price">$150K - $300K</p>
            <p>Charming, walkable living on Main Street: Victorian-era houses, bungalows, and mid-century ranches, each with its own character. Many homes qualify for historic preservation tax incentives. Character and convenience in one package.</p>
          </div>
        </div>
        <div style="text-align: center; margin-top: 2rem;">
          <a href="/seguin/neighborhoods/" class="btn btn-primary">All Seguin Neighborhoods</a>
        </div>
        <div class="section-title" style="margin-top: 3rem;">
          <h2>Watch: New Construction in <span class="accent">Seguin</span></h2>
          <p>What new builds buy you on this side of the Guadalupe</p>
        </div>
        <VideoEmbed
          videoId="mEOheFhazEQ"
          title="Meadows at Mill Creek | Perry Homes | Seguin, TX"
          description="A walkthrough of Meadows at Mill Creek by Perry Homes in Seguin — floor plans, pricing, and what new construction buys you on this side of the Guadalupe."
          uploadDate="2026-05-13"
        />
      </div>
    </section>

    <!-- 5. Cost Snapshot -->
    <section class="section seg-cost">
      <div class="container">
        <div class="section-title">
          <h2>The Cost <span class="accent">Snapshot</span></h2>
          <p>Seguin is the affordability play — here is the data behind it</p>
        </div>
        <div class="seg-cost__grid">
          <div class="seg-cost__card">
            <h3>Median Sale Price</h3>
            <p class="seg-cost__number">$289K</p>
            <p>Sept 2026 market data. Typical sold range $208K-$414K (Aug 2026). New construction from the mid-$200s. Acreage on the town's edges for buyers who want rural space.</p>
          </div>
          <div class="seg-cost__card">
            <h3>Property Tax</h3>
            <p class="seg-cost__number">~2.0-2.3%</p>
            <p>Combined rate across city, Guadalupe County, Seguin ISD, and other units — roughly $5,800-$6,600/year on a $289K home. File your homestead exemption at closing.</p>
          </div>
          <div class="seg-cost__card">
            <h3>Median Rent</h3>
            <p class="seg-cost__number">$1,360</p>
            <p>Sept 2026. With a median sale price under $290K, Seguin remains one of the few markets where buying still beats renting on monthly payment for most buyers.</p>
          </div>
          <div class="seg-cost__card">
            <h3>Days on Market</h3>
            <p class="seg-cost__number">82</p>
            <p>Sept 2026, down from 96 a year ago. Sale-to-list ratio near 97%. Homes still take time to sell — accurate pricing matters more than it did two years ago.</p>
          </div>
        </div>
        <p class="seg-cost__note">Compared with New Braunfels and San Antonio proper, Seguin buyers consistently get more home per dollar — the reason first-time buyers and budget-stretchers keep landing here.</p>
      </div>
    </section>

    <!-- 6. Schools -->
    <section class="section" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>School <span class="accent">District</span></h2>
          <p>Seguin's schools serve a growing and diverse community</p>
        </div>
        <div class="seg-schools__grid">
          <a href="https://www.seguin.k12.tx.us" target="_blank" rel="noopener" class="seg-schools__card">
            <h3>Seguin ISD</h3>
            <p>Seguin ISD serves the city and surrounding areas with a focus on college readiness, career training, and community involvement. The district operates multiple campuses from pre-K through high school.</p>
            <span class="seg-schools__link">Visit Seguin ISD Website →</span>
          </a>
        </div>
        <p class="seg-schools__note">Portions of the Seguin area fall within Navarro ISD boundaries. School assignments are based on physical address — always verify campus-level ratings directly with the district and the Texas Education Agency before purchasing.</p>
      </div>
    </section>

    <!-- 7. Commute -->
    <section class="section seg-commute">
      <div class="container">
        <div class="section-title">
          <h2>The <span class="accent">Commute</span></h2>
          <p>Drive times are off-peak — test your actual route before you buy</p>
        </div>
        <div class="seg-commute__grid">
          <div class="seg-commute__card">
            <span class="seg-commute__time">~35 min</span>
            <h3>San Antonio</h3>
            <p>Via I-10 west. The most common commute. Expect 45-60+ minutes during rush hour — many Seguin residents make this drive daily for the metro job market.</p>
          </div>
          <div class="seg-commute__card">
            <span class="seg-commute__time">~20 min</span>
            <h3>New Braunfels</h3>
            <p>Via TX-46 north. Easy access to the shops, dining, and employers along the I-35 corridor. Close enough for dinner without planning a trip.</p>
          </div>
          <div class="seg-commute__card">
            <span class="seg-commute__time">~60 min</span>
            <h3>Austin</h3>
            <p>About 50 miles — fastest via the TX-130 toll road. A workable occasional trip; a heavy daily commute. Worth knowing before you pick an employer base.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Things to Do / Restaurants -->
    <section class="section seg-explore" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>Life in <span class="accent">Seguin</span></h2>
          <p>River, BBQ, and small-town weekends — dig deeper on the lifestyle pages</p>
        </div>
        <div class="seg-explore__grid">
          <a href="/seguin/things-to-do/" class="seg-explore__card">
            <h3>Things to Do</h3>
            <p>Guadalupe River kayaking, Max Starcke Park's 227 acres, ZDT's Amusement Park, downtown Main Street, the Seguin Heritage Museum, and the annual Texas Pecan Festival.</p>
          </a>
          <a href="/seguin/restaurants/" class="seg-explore__card">
            <h3>Restaurants</h3>
            <p>Michelin Bib Gourmand BBQ at Burnt Bean Co., Seguin Brewing Company, The Oak Tavern, and downtown cafes like Court Street Coffee — a deeper food scene than the city's size suggests.</p>
          </a>
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="seg-explore__card">
            <h3>Home Search</h3>
            <p>Search current listings in Seguin. Filter by price, area, and home type to find what's available now.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 9. FAQ -->
    <section class="faq-section">
      <div class="container">
        <h2>Frequently Asked Questions About <span class="accent">Seguin</span></h2>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. CTA -->
    <section class="section seg-cta-parallax">
      <div class="seg-cta-parallax__overlay"></div>
      <div class="container seg-cta-parallax__content">
        <h2>Ready to Explore <span class="accent">Seguin</span>?</h2>
        <p>Whether you're just starting your search or ready to schedule showings, I can help you navigate the market and find the right fit.</p>
        <div class="seg-cta__buttons">
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="btn btn-primary">Search Homes</a>
          <a href="#contact" class="btn btn-outline">Ask About Seguin</a>
        </div>
      </div>
    </section>

  </main>

  <ContactForm context="I'd like to learn more about Seguin..." />
  <Footer />
</Layout>

<style>
  /* Hero */
  .seg-hero {
    position: relative;
    height: 420px;
    background: url('/images/areas/seguin.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
  }

  .seg-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
  }

  .seg-hero__content {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
  }

  .seg-hero__content h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 0.75rem;
  }

  .seg-hero__content p {
    color: rgba(255,255,255,0.7);
    font-size: 1rem;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-size: 0.8rem;
    margin-bottom: 1rem;
    color: rgba(255,255,255,0.5);
  }

  .breadcrumb a {
    color: rgba(255,255,255,0.5);
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: #FF1616;
  }

  .breadcrumb span {
    margin: 0 0.3rem;
  }

  /* Stat band */
  .seg-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .seg-stat {
    background: #fff;
    padding: 1.5rem;
    text-align: center;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .seg-stat__number {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: #FF1616;
  }

  .seg-stat__label {
    display: block;
    font-size: 0.78rem;
    color: var(--gray);
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .seg-stats__note {
    text-align: center;
    font-size: 0.82rem;
    color: var(--gray);
    font-style: italic;
    margin-top: 1.5rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Overview */
  .seg-overview__text {
    max-width: 900px;
    margin: 0 auto;
  }

  .seg-overview__text p {
    color: var(--gray);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  /* Cards */
  .seg-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .seg-card {
    background: #fff;
    padding: 1.75rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .seg-card h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .seg-card__price {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #FF1616;
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .seg-card p {
    color: var(--gray);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  /* Cost snapshot */
  .seg-cost__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .seg-cost__card {
    background: var(--light-gray);
    padding: 1.75rem;
    border-radius: 8px;
    text-align: center;
  }

  .seg-cost__card h3 {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .seg-cost__number {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: #FF1616;
    margin-bottom: 0.5rem;
  }

  .seg-cost__card p {
    color: var(--gray);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .seg-cost__note {
    text-align: center;
    font-size: 0.92rem;
    color: var(--gray);
    margin-top: 1.75rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Schools */
  .seg-schools__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .seg-schools__card {
    display: block;
    background: #fff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.2s, box-shadow 0.2s;
    text-align: center;
  }

  .seg-schools__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }

  .seg-schools__card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
    color: #000;
  }

  .seg-schools__card:hover h3 {
    color: #FF1616;
  }

  .seg-schools__card p {
    color: var(--gray);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .seg-schools__link {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #FF1616;
  }

  .seg-schools__note {
    text-align: center;
    font-size: 0.85rem;
    color: var(--gray);
    font-style: italic;
    max-width: 800px;
    margin: 1.5rem auto 0;
  }

  /* Commute */
  .seg-commute__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .seg-commute__card {
    background: #fff;
    border: 1px solid var(--light-gray);
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .seg-commute__time {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: #FF1616;
    margin-bottom: 0.5rem;
  }

  .seg-commute__card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .seg-commute__card p {
    color: var(--gray);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  /* Explore cards */
  .seg-explore__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .seg-explore__card {
    display: block;
    background: #fff;
    border: 1px solid var(--light-gray);
    padding: 2rem;
    border-radius: 8px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .seg-explore__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }

  .seg-explore__card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    color: #000;
  }

  .seg-explore__card:hover h3 {
    color: #FF1616;
  }

  .seg-explore__card p {
    color: var(--gray);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  /* FAQ */
  .faq-section {
    padding: 4rem 0;
    background: #f9f9f9;
  }
  .faq-section h2 {
    text-align: center;
    margin-bottom: 2rem;
  }
  .faq-list {
    max-width: 800px;
    margin: 0 auto;
  }
  .faq-item {
    background: #fff;
    border: 1px solid #eee;
    margin-bottom: 1rem;
    padding: 0;
  }
  .faq-item summary {
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    cursor: pointer;
    font-size: 1rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 1.3rem;
    color: #FF1616;
    font-weight: 700;
