---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ParallaxBanner from '../../components/ParallaxBanner.astro';
import ContactForm from '../../components/ContactForm.astro';
import { placeSchema, collectionPageSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

const grDescription = 'Garden Ridge, TX homes for sale — 2026 relocation guide. Median home price, real neighborhoods, Comal ISD schools, commute times, restaurants, and things to do. Straight talk for buyers.';
const pageSchema = [
  placeSchema({ name: 'Garden Ridge, TX', description: grDescription, url: '/garden-ridge/', image: '/images/areas/garden-ridge.jpg' }),
  collectionPageSchema({
    name: 'Garden Ridge, TX Homes for Sale | 2026 Relocation Guide',
    description: grDescription,
    url: '/garden-ridge/',
    hasPart: [
      { name: 'Garden Ridge Neighborhoods', url: '/garden-ridge/neighborhoods/' },
      { name: 'Garden Ridge Restaurants', url: '/garden-ridge/restaurants/' },
      { name: 'Things to Do in Garden Ridge', url: '/garden-ridge/things-to-do/' },
      { name: 'Commute & Lifestyle', url: '/garden-ridge/#commute' },
      { name: 'FAQ', url: '/garden-ridge/#faq' },
    ],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Hill Country Relocation Guide', url: '/hill-country-relocation-guide/' },
    { name: 'Garden Ridge', url: '/garden-ridge/' },
  ]),
  faqSchema([
    {
      q: 'Where is Garden Ridge, TX?',
      a: 'Garden Ridge is a small city on the ridge between New Braunfels and San Antonio along the Loop 1604 corridor — about 15 minutes southwest of New Braunfels and 20 miles (roughly 25 minutes) from downtown San Antonio. It is almost entirely residential, known for larger lots, mature trees, and a quiet, upscale character.',
    },
    {
      q: 'What is the median home price in Garden Ridge?',
      a: 'As of July 2026, the median home price in Garden Ridge was $874,500 (Homes.com) — a premium over the San Antonio metro driven by lot size, Comal ISD schools, and limited inventory. Expect most of the market to run roughly $750K to $1.5M+. New construction starts at $729,990 in Heimer Estates and climbs past $1M in Enchanted Bluff.',
    },
    {
      q: 'What school district is Garden Ridge in?',
      a: 'The city of Garden Ridge is served by Comal ISD — Garden Ridge Elementary, Danville Middle School, and Davenport High School. School quality is one of the primary drivers of home values in the city. Always verify attendance boundaries by street address before buying.',
    },
    {
      q: 'What should buyers watch out for in Garden Ridge?',
      a: 'Three things: (1) premium pricing with thin inventory — financing should be fully lined up before touring; (2) deed restrictions and HOAs are common in the gated subdivisions, so read the CC&Rs before offering; (3) older resale homes may be on septic or well water — budget for inspections beyond the standard set.',
    },
  ]),
];
---

<Layout
  title="Garden Ridge, TX Homes for Sale | 2026 Relocation Guide"
  description={grDescription}
  schema={pageSchema}
>
  <Navbar />
  <main style="padding-top: 80px;">

    <!-- Hero -->
    <div class="gr-hero">
      <div class="gr-hero__overlay"></div>
      <div class="gr-hero__content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span>/</span> <a href="/hill-country-relocation-guide/">Relocation Guide</a> <span>/</span> <span>Garden Ridge</span>
        </nav>
        <h1>Garden <span style="color:#FF1616;">Ridge</span></h1>
        <p>Homes for sale, real neighborhoods, Comal ISD schools, and honest market data — the 2026 Garden Ridge relocation guide</p>
      </div>
    </div>

    <!-- Stat band + quick answer -->
    <section class="section gr-intro">
      <div class="container">
        <div class="gr-quick">
          <p><strong>Quick answer:</strong> Garden Ridge is a small, affluent city of 4,186 residents (2020 Census) tucked between New Braunfels and San Antonio. Buyers come for larger lots, mature trees, Comal ISD schools (Garden Ridge Elementary, Danville Middle, Davenport High), and a genuinely quiet feel — while staying ~25 minutes to downtown San Antonio and about 15 minutes to New Braunfels. It's a premium market: the median home price was $874,500 as of July 2026 (Homes.com).</p>
        </div>
        <div class="gr-intro__grid">
          <div class="gr-intro__text">
            <h2>Small City, <span class="accent">Big</span> Lots</h2>
            <p>Garden Ridge doesn't feel like a suburb — it feels like a retreat that happens to sit in the middle of the metro. The city sits on the ridge (the name is literal) between New Braunfels to the northeast and San Antonio to the southwest, with Loop 1604 and I-35 both within easy reach. Homes here sit on larger lots than you'll find in most San Antonio subdivisions, many of them shaded by mature oaks, and the whole city has a deliberately low-key, residential character.</p>
            <p>The buyer profile is consistent: established professionals, executives, and military officers who want space and quiet without giving up commute access. Nature is part of the pitch here — the Bracken Bat Cave, home to the world's largest bat colony, sits just outside the city, and deer in the yard is a normal Tuesday. If you want walkable nightlife, this isn't it. If you want to hear yourself think, it is.</p>
          </div>
          <div class="gr-intro__stats">
            <div class="gr-stat">
              <span class="gr-stat__number">4,186</span>
              <span class="gr-stat__label">Population (2020 Census)</span>
            </div>
            <div class="gr-stat">
              <span class="gr-stat__number">~$875K</span>
              <span class="gr-stat__label">Median Home (Jul 2026)</span>
            </div>
            <div class="gr-stat">
              <span class="gr-stat__number">~25 min</span>
              <span class="gr-stat__label">To downtown San Antonio</span>
            </div>
            <div class="gr-stat">
              <span class="gr-stat__number">Comal ISD</span>
              <span class="gr-stat__label">School district</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Honest overview -->
    <section class="section" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>The <span class="accent">Honest</span> Overview</h2>
          <p>What Garden Ridge gets right — and what buyers should watch for</p>
        </div>
        <div class="gr-honest__grid">
          <div class="gr-honest__col">
            <h3>What works here</h3>
            <p>Garden Ridge is one of the few Hill Country enclaves where you can own an acre or more, live under mature oak canopy, and still reach downtown San Antonio in under 30 minutes. Comal ISD is a top-tier district, and the Davenport High feeder pattern is a genuine value anchor — Davenport earned an A (95) with all seven eligible distinctions in the 2026 TEA ratings. Crime is low, turnover is low, and neighbors tend to stay for decades.</p>
            <p>For military families, the position is hard to beat: ~20 minutes to Camp Bullis, ~25 minutes to Randolph AFB via 1604, and BAH for the SA area can support this price point for senior officers and NCOs.</p>
          </div>
          <div class="gr-honest__col">
            <h3>Watch-outs</h3>
            <ul class="gr-honest__list">
              <li><strong>Premium price, thin inventory.</strong> The median was $874,500 as of July 2026, and well-priced homes move fast. Have financing fully ready before you tour — there is no negotiating leverage from volume here.</li>
              <li><strong>HOAs and deed restrictions.</strong> The gated subdivisions (Enchanted Bluff, Woodlands of Garden Ridge) run on CC&Rs. Read them before you offer, not after.</li>
              <li><strong>Older stock needs inspection depth.</strong> Much of the resale inventory is custom homes from the 70s–90s. Septic systems, wells, and older foundations show up — budget for inspections beyond the standard set and price accordingly.</li>
              <li><strong>No commercial strip.</strong> Dining and grocery mean a short drive to the I-35 corridor in Selma/Schertz. If walkable amenities matter, this is the wrong zip.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Neighborhoods -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>Garden Ridge <span class="accent">Neighborhoods</span></h2>
          <p>The subdivisions buyers actually ask about</p>
        </div>
        <div class="gr-explore__grid">
          <a href="/garden-ridge/neighborhoods/" class="gr-explore__card">
            <h3>Enchanted Bluff</h3>
            <p>The headline luxury community — gated, with three active builders: Drees Custom Homes (from $1,018,900), Sitterle Homes (from $875,000), and Toll Brothers (from $839,995). New construction on estate-sized lots.</p>
          </a>
          <a href="/garden-ridge/neighborhoods/" class="gr-explore__card">
            <h3>Heimer Estates at Garden Ridge</h3>
            <p>Chesmar Homes builds from $729,990 — the cheapest new construction in Garden Ridge and the entry point for a new build in the city. 3–5 bed plans from 2,500+ sq ft.</p>
          </a>
          <a href="/garden-ridge/neighborhoods/" class="gr-explore__card">
            <h3>Wild Wind</h3>
            <p>Resale custom homes in a quiet wooded pocket of the city. Recent listings run roughly $795K–$1.5M for 3–4 bed homes — classic Garden Ridge: big lots, big trees, no through traffic.</p>
          </a>
          <a href="/garden-ridge/neighborhoods/" class="gr-explore__card">
            <h3>Woodlands of Garden Ridge</h3>
            <p>Gated community off FM 2252 and Bat Cave Road on large half-acre lots. Recent median list around $871,500 (Nov 2025) — established Hill Country living minutes from the caverns corridor.</p>
          </a>
        </div>
        <p class="gr-more"><a href="/garden-ridge/neighborhoods/">See all Garden Ridge neighborhoods →</a></p>
      </div>
    </section>

    <!-- Cost snapshot -->
    <section class="section" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>Cost <span class="accent">Snapshot</span></h2>
          <p>What homes actually cost here (date-stamped, not guessed)</p>
        </div>
        <div class="gr-cost__grid">
          <div class="gr-cost__card">
            <span class="gr-cost__number">~$875K</span>
            <span class="gr-cost__label">Median home price, July 2026 (Homes.com)</span>
          </div>
          <div class="gr-cost__card">
            <span class="gr-cost__number">$730K–$1.5M+</span>
            <span class="gr-cost__label">Typical market range, recent MLS snapshots</span>
          </div>
          <div class="gr-cost__card">
            <span class="gr-cost__number">1.7–2.2%</span>
            <span class="gr-cost__label">Property tax range in Comal County (approx.)</span>
          </div>
        </div>
        <p class="gr-cost__note">Note: median figures vary by source (foreclosure.com reported a $710,603 median home value in Aug 2026; WalletInvestor reported $698,385 in Sep 2026). Sources disagree on methodology and timing — treat medians as directional, not guarantees. There is also no state income tax in Texas.</p>
      </div>
    </section>

    <!-- Schools -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>School <span class="accent">Districts</span></h2>
          <p>One district, three campuses — verify attendance by street address</p>
        </div>
        <div class="gr-schools__grid">
          <a href="https://www.comalisd.org" target="_blank" rel="noopener" class="gr-schools__card">
            <h3>Comal ISD</h3>
            <p>Garden Ridge feeds Garden Ridge Elementary, Danville Middle School, and Davenport High School — all Comal ISD, one of the fastest-growing and most in-demand districts in Texas. Davenport High earned an A (95) with all seven eligible TEA distinctions in 2026. School quality is a core driver of the city's home values.</p>
            <span class="gr-schools__link">Visit Comal ISD Website →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Commute -->
    <section id="commute" class="section" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2><span class="accent">Commute</span> Times</h2>
          <p>Where the ridge puts you relative to the region's job centers</p>
        </div>
        <div class="gr-commute__grid">
          <div class="gr-commute__card"><span class="gr-commute__time">~15 min</span><span class="gr-commute__dest">New Braunfels (11 mi NE via I-35)</span></div>
          <div class="gr-commute__card"><span class="gr-commute__time">~25 min</span><span class="gr-commute__dest">Downtown San Antonio (20 mi SW via 1604)</span></div>
          <div class="gr-commute__card"><span class="gr-commute__time">~20 min</span><span class="gr-commute__dest">Camp Bullis (west via FM 3009)</span></div>
          <div class="gr-commute__card"><span class="gr-commute__time">~25 min</span><span class="gr-commute__dest">Randolph AFB (via Loop 1604)</span></div>
          <div class="gr-commute__card"><span class="gr-commute__time">~30 min</span><span class="gr-commute__dest">Fort Sam Houston (via 1604/I-35)</span></div>
          <div class="gr-commute__card"><span class="gr-commute__time">~1 hr</span><span class="gr-commute__dest">Austin (via I-35)</span></div>
        </div>
        <p class="gr-cost__note">Drive times are approximate, off-peak. I-35 and Loop 1604 both back up at rush hour — do a test drive of your actual route before you commit.</p>
      </div>
    </section>

    <!-- Explore subpages -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>Explore <span class="accent">Garden Ridge</span></h2>
          <p>Guides to the areas, food, and lifestyle that matter to you</p>
        </div>
        <div class="gr-explore__grid">
          <a href="/garden-ridge/neighborhoods/" class="gr-explore__card">
            <h3>Neighborhoods</h3>
            <p>Enchanted Bluff, Heimer Estates, Wild Wind, Woodlands of Garden Ridge, and more — how the city's subdivisions differ by price, lot size, and builder.</p>
          </a>
          <a href="/garden-ridge/restaurants/" class="gr-explore__card">
            <h3>Restaurants</h3>
            <p>Wraptitude's live-music patio, Capparelli's family Italian, Grumpy's Tex-Mex breakfasts — the real dining map in and around Garden Ridge.</p>
          </a>
          <a href="/garden-ridge/things-to-do/" class="gr-explore__card">
            <h3>Things to Do</h3>
            <p>Bracken Bat Cave dusk emergences, Natural Bridge Caverns, the wildlife ranch, Paul Davis Park, and Market Days every second Saturday.</p>
          </a>
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="gr-explore__card">
            <h3>Search Homes</h3>
            <p>See what's on the market in Garden Ridge right now. Inventory is thin — set up an alert so you don't miss the next one.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA with Parallax -->
    <section class="section gr-cta">
      <div class="gr-cta__overlay"></div>
      <div class="container" style="position: relative; z-index: 1;">
        <h2>Garden Ridge Moves <span class="accent">Quietly.</span></h2>
        <p>Inventory here is thin and the best homes never sit long. Tell me what you're looking for and I'll set up an alert — plus video walkthroughs if you're buying from out of town.</p>
        <div class="gr-cta__buttons">
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="btn btn-primary">Search Homes</a>
          <a href="#contact" class="btn btn-outline">Talk to Cody</a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="faq-section">
      <div class="container">
        <h2>Frequently Asked Questions About <span class="accent">Garden Ridge</span></h2>
        <div class="faq-list">
          <details class="faq-item">
            <summary>Where is Garden Ridge, TX?</summary>
            <p>Garden Ridge is a small city on the ridge between New Braunfels and San Antonio along the Loop 1604 corridor — about 15 minutes southwest of New Braunfels and 20 miles (roughly 25 minutes) from downtown San Antonio. It's almost entirely residential, known for larger lots, mature trees, and a quiet, upscale character.</p>
          </details>
          <details class="faq-item">
            <summary>What is the median home price in Garden Ridge?</summary>
            <p>As of July 2026, the median home price in Garden Ridge was $874,500 (Homes.com) — a premium over the San Antonio metro driven by lot size, Comal ISD schools, and limited inventory. Expect most of the market to run roughly $750K to $1.5M+. New construction starts at $729,990 in Heimer Estates and climbs past $1M in Enchanted Bluff.</p>
          </details>
          <details class="faq-item">
            <summary>What school district is Garden Ridge in?</summary>
            <p>The city of Garden Ridge is served by Comal ISD — Garden Ridge Elementary, Danville Middle School, and Davenport High School. School quality is one of the primary drivers of home values in the city. Always verify attendance boundaries by street address before buying.</p>
          </details>
          <details class="faq-item">
            <summary>What should buyers watch out for in Garden Ridge?</summary>
            <p>Three things: (1) premium pricing with thin inventory — financing should be fully lined up before touring; (2) deed restrictions and HOAs are common in the gated subdivisions, so read the CC&amp;Rs before offering; (3) older resale homes may be on septic or well water — budget for inspections beyond the standard set.</p>
          </details>
        </div>
      </div>
    </section>

  </main>
  <ParallaxBanner image="/images/generated/guadalupe-river.webp" />

  <ContactForm context="Interested in Garden Ridge — I'd like listings and guidance for my budget..." />
  <Footer />
</Layout>

<style>
  .faq-section { padding: 4rem 0; background: #f9f9f9; }
  .faq-section h2 { text-align: center; margin-bottom: 2rem; }
  .faq-list { max-width: 800px; margin: 0 auto; }
  .faq-item { background: #fff; border: 1px solid #eee; margin-bottom: 1rem; padding: 0; }
  .faq-item summary { padding: 1.25rem 1.5rem; font-weight: 600; cursor: pointer; font-size: 1rem; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::after { content: '+'; font-size: 1.3rem; color: #FF1616; font-weight: 700; }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p { padding: 0 1.5rem 1.25rem; color: #555; line-height: 1.8; font-size: 0.95rem; }

  .gr-hero { position: relative; height: 340px; background: url('/images/areas/garden-ridge.jpg') center/cover no-repeat; display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; }
  .gr-hero__overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.55); }
  .gr-hero__content { position: relative; z-index: 1; padding: 0 1.5rem; }
  .gr-hero__content h1 { font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 0.75rem; }
  .gr-hero__content p { color: rgba(255,255,255,0.7); font-size: 1rem; max-width: 640px; margin: 0 auto; }

  .breadcrumb { font-size: 0.8rem; margin-bottom: 1rem; color: rgba(255,255,255,0.5); }
  .breadcrumb a { color: rgba(255,255,255,0.5); transition: color 0.2s; }
  .breadcrumb a:hover { color: #FF1616; }
  .breadcrumb span { margin: 0 0.3rem; }

  .gr-quick { background: #111; color: #fff; border-left: 4px solid #FF1616; padding: 1.5rem 2rem; border-radius: 0 8px 8px 0; margin-bottom: 3rem; }
  .gr-quick p { line-height: 1.8; font-size: 0.95rem; margin: 0; color: rgba(255,255,255,0.85); }
  .gr-quick strong { color: #FF1616; }

  .gr-intro__grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: start; }
  .gr-intro__text p { color: var(--gray); line-height: 1.8; margin-bottom: 1rem; }
  .gr-intro__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .gr-stat { background: var(--light-gray); padding: 1.5rem; text-align: center; border-radius: 8px; }
  .gr-stat__number { display: block; font-family: var(--font-heading); font-size: 1.8rem; font-weight: 800; color: #FF1616; }
  .gr-stat__label { display: block; font-size: 0.8rem; color: var(--gray); margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em; }

  .gr-honest__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .gr-honest__col h3 { font-family: var(--font-heading); font-size: 1.1rem; text-transform: uppercase; margin-bottom: 1rem; }
  .gr-honest__col p { color: var(--gray); line-height: 1.8; margin-bottom: 1rem; font-size: 0.95rem; }
  .gr-honest__list { list-style: none; padding: 0; margin: 0; }
  .gr-honest__list li { color: var(--gray); line-height: 1.7; font-size: 0.95rem; margin-bottom: 1rem; padding-left: 1.5rem; position: relative; }
  .gr-honest__list li::before { content: '—'; position: absolute; left: 0; color: #FF1616; font-weight: 700; }

  .gr-explore__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .gr-explore__card { display: block; background: #fff; border: 1px solid var(--light-gray); padding: 2rem; border-radius: 8px; transition: transform 0.2s, box-shadow 0.2s; }
  .gr-explore__card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
  .gr-explore__card h3 { font-family: var(--font-heading); font-size: 1rem; text-transform: uppercase; margin-bottom: 0.5rem; color: #000; }
  .gr-explore__card:hover h3 { color: #FF1616; }
  .gr-explore__card p { color: var(--gray); font-size: 0.85rem; line-height: 1.6; }
  .gr-more { text-align: center; margin-top: 2rem; }
  .gr-more a { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em; color: #FF1616; }

  .gr-cost__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 1000px; margin: 0 auto 1.5rem; }
  .gr-cost__card { background: #fff; padding: 2rem 1.5rem; text-align: center; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .gr-cost__number { display: block; font-family: var(--font-heading); font-size: 1.7rem; font-weight: 800; color: #FF1616; }
  .gr-cost__label { display: block; font-size: 0.78rem; color: var(--gray); margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; line-height: 1.5; }
  .gr-cost__note { text-align: center; font-style: italic; color: var(--gray); font-size: 0.85rem; max-width: 800px; margin: 0 auto; line-height: 1.7; }

  .gr-schools__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; max-width: 1000px; margin: 0 auto; }
  .gr-schools__card { display: block; background: #fff; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: transform 0.2s, box-shadow 0.2s; text-align: center; }
  .gr-schools__card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
  .gr-schools__card h3 { font-family: var(--font-heading); font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.75rem; color: #000; }
  .gr-schools__card:hover h3 { color: #FF1616; }
  .gr-schools__card p { color: var(--gray); font-size: 0.9rem; line-height: 1.7; margin-bottom: 1rem; }
  .gr-schools__link { font-family: var(--font-heading); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #FF1616; }

  .gr-commute__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 1000px; margin: 0 auto 1.5rem; }
  .gr-commute__card { background: #fff; padding: 1.5rem; text-align: center; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .gr-commute__time { display: block; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: #FF1616; }
  .gr-commute__dest { display: block; font-size: 0.8rem; color: var(--gray); margin-top: 0.35rem; line-height: 1.5; }

  .gr-cta { position: relative; background: url('/images/testimonials-hero.webp') center/cover no-repeat fixed; color: #fff; text-align: center; }
  .gr-cta__overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.75); }
  .gr-cta__buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .gr-cta p { color: rgba(255,255,255,0.7); max-width: 600px; margin: 1rem auto 2rem; }

  @media (max-width: 600px) {
