---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ParallaxBanner from '../../components/ParallaxBanner.astro';
import ContactForm from '../../components/ContactForm.astro';
import { placeSchema, collectionPageSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

const saDescription = 'San Antonio, TX homes for sale: 2026 relocation guide with median prices, neighborhoods by corridor, schools, commute times, and the honest tradeoffs — from a retired Army First Sergeant based in New Braunfels.';
const faqs = [
  {
    q: 'Is San Antonio a good place to relocate in 2026?',
    a: 'For the right buyer, yes. The San Antonio–New Braunfels metro median list price was $320,374 in September 2026 (Realtor.com), down 2.9% year over year — roughly $180,000 below Austin and about 30% below Dallas–Fort Worth. There is no state income tax, and military buyers can use a zero-down VA loan. The honest caveat: San Antonio is a sprawling, car-dependent city with hot summers and real rush-hour traffic, so pick your corridor around your commute first.',
  },
  {
    q: 'Which San Antonio neighborhoods are best for military families?',
    a: 'Pick by gate, not by zip code. Randolph families land in the Schertz–Cibolo–Universal City corridor (under 10 minutes to the Main Gate, SCUCISD schools). Lackland families go Alamo Ranch or Helotes (10–15 minutes, Northside ISD). Fort Sam families choose Alamo Heights, Terrell Hills, or Government Hill (under 15 minutes). My installation guides cover each base in detail: /military-relocation/fort-sam-houston/, /military-relocation/lackland-afb/, and /military-relocation/randolph-afb/.',
  },
  {
    q: 'What are property taxes in San Antonio?',
    a: 'Budget for a typical range of 1.7–2.2% of assessed value in Bexar County. On a $320,000 home that is roughly $5,400–$7,000 per year — the single biggest line item beyond your mortgage. New construction in some areas adds MUD or PID taxes on top. One bright spot: Texas offers property-tax exemptions for disabled veterans that can reduce or eliminate the bill entirely, worth checking against your disability rating.',
  },
  {
    q: 'How far is San Antonio from New Braunfels, and where does Cody work?',
    a: 'Downtown San Antonio to New Braunfels is about 30–35 minutes via I-35. I am based in New Braunfels and my core market is the I-35 Hill Country corridor — New Braunfels, Cibolo/Schertz, Canyon Lake, Bulverde, Boerne, Seguin, and Garden Ridge. I work with San Antonio buyers too, especially PCS families in the northeast corridor, and I do video walkthroughs for buyers relocating from out of state.',
  },
];
const pageSchema = [
  placeSchema({ name: 'San Antonio, TX', description: saDescription, url: '/san-antonio/' }),
  collectionPageSchema({
    name: 'San Antonio, TX Homes for Sale | 2026 Relocation Guide',
    description: saDescription,
    url: '/san-antonio/',
    hasPart: [
      { name: 'San Antonio Neighborhoods by Corridor', url: '/san-antonio/neighborhoods/' },
      { name: 'San Antonio Restaurants', url: '/san-antonio/restaurants/' },
      { name: 'Things to Do in San Antonio', url: '/san-antonio/things-to-do/' },
    ],
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Hill Country Relocation Guide', url: '/hill-country-relocation-guide/' },
    { name: 'San Antonio', url: '/san-antonio/' },
  ]),
  faqSchema(faqs),
];
---

<Layout
  title="San Antonio, TX Homes for Sale | 2026 Relocation Guide"
  description={saDescription}
  schema={pageSchema}
>
  <Navbar />
  <main style="padding-top: 80px;">

    <!-- 1. Hero -->
    <div class="sa-hero">
      <div class="sa-hero__overlay"></div>
      <div class="sa-hero__content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span>/</span> <a href="/hill-country-relocation-guide/">Relocation Guide</a> <span>/</span> <span>San Antonio</span>
        </nav>
        <h1>San Antonio, TX <span style="color:#FF1616;">Homes for Sale</span></h1>
        <p>2026 relocation guide — Military City USA, organized by corridor, with the honest tradeoffs</p>
      </div>
    </div>

    <!-- 2. Quick answer + stat band -->
    <section class="section sa-intro">
      <div class="container">
        <div class="sa-quick">
          <p><strong>Quick answer:</strong> San Antonio is the employment and military anchor south of the Hill Country I-35 corridor. The San Antonio–New Braunfels metro median list price sat at $320,374 in September 2026 (Realtor.com), down 2.9% year over year. Military families cluster near their gate — Randolph, Lackland, or Fort Sam. Everyone else is really making a commute decision: the city sprawls across 500+ square miles, and rush hour is the tax you pay for picking wrong.</p>
        </div>
        <div class="sa-intro__grid">
          <div class="sa-intro__text">
            <h2>The Anchor South of <span class="accent">the Corridor</span></h2>
            <p>San Antonio is Texas's second-largest city and its most affordable major metro — about $180,000 below Austin's median and roughly 30% below Dallas–Fort Worth, with no state income tax. It's Military City USA: Joint Base San Antonio's three installations (Fort Sam Houston, Lackland AFB, Randolph AFB) anchor an economy that also includes USAA, Toyota's manufacturing plant, the South Texas Medical Center, and a growing cybersecurity sector.</p>
            <p>Here's where I fit. I'm based in New Braunfels, and my core market is the I-35 Hill Country corridor — New Braunfels, Cibolo/Schertz, Canyon Lake, Bulverde, Boerne, Seguin, Garden Ridge. San Antonio is the employment and military anchor south of it, and I work with SA buyers — especially PCS families in the northeast corridor — the same way I work the rest of my territory: corridor first, listings second, video walkthroughs for out-of-state buyers.</p>
            <p>The pitch for relocating buyers is simple: big-city amenities at a price that still works. The $200K–$500K range covers roughly two-thirds of all San Antonio sales, so the core of the market — the three- and four-bedroom family home — is firmly in play for a typical relocator's budget.</p>
          </div>
          <div class="sa-intro__stats">
            <div class="sa-stat">
              <span class="sa-stat__number">~1.55M</span>
              <span class="sa-stat__label">City population (2025 est.)</span>
            </div>
            <div class="sa-stat">
              <span class="sa-stat__number">$320,374</span>
              <span class="sa-stat__label">Metro median list, Sept 2026</span>
            </div>
            <div class="sa-stat">
              <span class="sa-stat__number">3</span>
              <span class="sa-stat__label">JBSA installations</span>
            </div>
            <div class="sa-stat">
              <span class="sa-stat__number">2nd</span>
              <span class="sa-stat__label">Largest city in Texas</span>
            </div>
          </div>
        </div>
        <p class="sa-stat__note">Population: 2025 Census estimate via Wikipedia. Median list price: Realtor.com September 2026 monthly housing trends, San Antonio–New Braunfels metro. JBSA: Fort Sam Houston, Lackland AFB, Randolph AFB.</p>
      </div>
    </section>

    <!-- 3. Honest overview + watch-outs -->
    <section class="section sa-honest" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>The Honest <span class="accent">Overview</span></h2>
          <p>What the numbers say — and what they don't</p>
        </div>
        <div class="sa-honest__grid">
          <div class="sa-honest__card">
            <h3>The Value Case</h3>
            <p>A $320K metro median buys a real house in most corridors — new construction in the northeast and far west, established brick in the urban core, master-planned in Stone Oak. Texas has no state income tax, and VA buyers can go zero-down. If you're relocating from Austin or DFW, the housing payment drop is typically hundreds of dollars a month, which is the whole reason people make this move.</p>
          </div>
          <div class="sa-honest__card">
            <h3>The Economy Holds Up</h3>
            <p>JBSA trains more DoD students than any other installation and supports a military community of 80,000+. Layer on USAA headquarters, Toyota manufacturing, the South Texas Medical Center, and the cyber corridor, and you get an economy that isn't a one-industry town. PCS cycles move the housing market in predictable annual waves — which is exactly the market I know how to time.</p>
          </div>
          <div class="sa-honest__card sa-honest__card--watchouts">
            <h3>Watch-Outs (No Sugarcoating)</h3>
            <ul>
              <li><strong>Property taxes:</strong> 1.7–2.2% is the typical range — on a $320K home, that's $5,400–$7,000 a year. Budget it like a second mortgage payment.</li>
              <li><strong>Summer heat:</strong> 100°F stretches from June through September. AC is not optional; it's a real monthly line item.</li>
              <li><strong>Traffic:</strong> I-35, Loop 1604, and US-281 all congest hard at rush hour. Live on the same side of town as your job.</li>
              <li><strong>Car-dependent:</strong> 500+ square miles of sprawl. Walkability exists in pockets (Pearl, Southtown, Alamo Heights) — most of the city requires a car for everything.</li>
            </ul>
          </div>
          <div class="sa-honest__card">
            <h3>Culture You Can Feel</h3>
            <p>The River Walk, the UNESCO-listed Spanish missions, Fiesta every April, Spurs basketball, the Pearl's food scene. San Antonio has an identity most Sun Belt boomtowns are still trying to manufacture — and as the UNESCO Creative City of Gastronomy, the food scene alone is a relocation argument. <a href="/san-antonio/things-to-do/">See what there is to do →</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Neighborhoods by corridor -->
    <section id="neighborhoods" class="section sa-explore">
      <div class="container">
        <div class="section-title">
          <h2>Neighborhoods, <span class="accent">by Corridor</span></h2>
          <p>Pick your commute first — the neighborhood follows</p>
        </div>
        <div class="sa-explore__grid">
          <a href="/cibolo-schertz/" class="sa-explore__card">
            <h3>Northeast: Schertz / Cibolo / Universal City</h3>
            <p>The JBSA Randolph corridor — under 10 minutes to the Main Gate, SCUCISD schools, new construction throughout. This is also the corridor I work most. Selma and Live Oak sit inside this same corridor.</p>
          </a>
          <a href="/military-relocation/lackland-afb/" class="sa-explore__card">
            <h3>Northwest: Alamo Ranch / Helotes</h3>
            <p>Southwest growth corridor feeding Lackland AFB — 10–15 minutes to the gate, Northside ISD, master-planned communities with the best new-construction value inside Loop 1604's orbit.</p>
          </a>
          <a href="/san-antonio/neighborhoods/" class="sa-explore__card">
            <h3>North-Central: Stone Oak</h3>
            <p>Master-planned north side, North East ISD, medical-center adjacent. The default for established families who want newer construction and every amenity within 10 minutes. Timberwood Park sits in this same North Central zone.</p>
          </a>
          <a href="/military-relocation/fort-sam-houston/" class="sa-explore__card">
            <h3>Fort Sam Corridor: Alamo Heights / Terrell Hills / Olmos Park</h3>
            <p>San Antonio's premium corridor — historic homes, mature oaks, Alamo Heights ISD, minutes to Fort Sam Houston's gates. You pay for all of it, and residents say it's worth it.</p>
          </a>
          <a href="/san-antonio/neighborhoods/" class="sa-explore__card">
            <h3>Historic Urban Core</h3>
            <p>King William, Monte Vista, Tobin Hill, Southtown — walkable, character-rich, and closest to downtown jobs, the River Walk, and the Pearl's dining scene. Older homes, real personality.</p>
          </a>
          <a href="/san-antonio/neighborhoods/" class="sa-explore__card">
            <h3>Browse Every Corridor →</h3>
            <p>The full corridor-by-corridor breakdown: where military families actually land, typical price ranges, school districts, and drive times.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. Cost snapshot -->
    <section class="section sa-cost" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>Cost <span class="accent">Snapshot</span></h2>
          <p>San Antonio–New Braunfels metro, as of September 2026</p>
        </div>
        <div class="sa-cost__table-wrap">
          <table class="sa-cost__table">
            <tbody>
              <tr>
                <th>Metro median list price</th>
                <td><strong>$320,374</strong> — down 2.9% year over year (Realtor.com, Sept 2026)</td>
              </tr>
              <tr>
                <th>Core of the market</th>
                <td><strong>$200K–$500K</strong> covers roughly two-thirds of all San Antonio sales — the 3–4 bedroom family home is the center of this market</td>
              </tr>
              <tr>
                <th>Property tax</th>
                <td><strong>1.7–2.2%</strong> typical range in Bexar County — ~$5,400–$7,000/yr on a $320K home; some new construction adds MUD/PID taxes on top</td>
              </tr>
              <tr>
                <th>State income tax</th>
                <td><strong>0%</strong> — Texas has none; this is part of the relocation math</td>
              </tr>
              <tr>
                <th>Summer utilities</th>
                <td>AC is a real line item — budget for heavy cooling bills June through September</td>
              </tr>
              <tr>
                <th>Veteran note</th>
                <td>VA loans go <strong>zero-down</strong>; Texas disabled-veteran property-tax exemptions can reduce or eliminate the tax bill — check your rating against the exemption tiers</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 6. Schools -->
    <section id="schools" class="section">
      <div class="container">
        <div class="section-title">
          <h2>School <span class="accent">Districts</span></h2>
          <p>San Antonio has 15+ districts — these are the ones buyers ask about most</p>
        </div>
        <div class="sa-schools__grid">
          <a href="https://www.neisd.net" target="_blank" rel="noopener" class="sa-schools__card">
            <h3>North East ISD</h3>
            <p>Stone Oak and north-central San Antonio. One of the state's largest districts, with extensive magnet and career programs.</p>
            <span class="sa-schools__link">Visit NEISD Website →</span>
          </a>
          <a href="https://www.nisd.net" target="_blank" rel="noopener" class="sa-schools__card">
            <h3>Northside ISD</h3>
            <p>Alamo Ranch, Helotes, and the far west side. The district behind the Lackland corridor's family appeal.</p>
            <span class="sa-schools__link">Visit NISD Website →</span>
          </a>
          <a href="https://www.scucisd.org" target="_blank" rel="noopener" class="sa-schools__card">
            <h3>SCUCISD</h3>
            <p>Schertz–Cibolo–Universal City ISD — 15,000+ students across Bexar and Guadalupe counties, serving the Randolph corridor including Selma.</p>
            <span class="sa-schools__link">Visit SCUCISD Website →</span>
          </a>
          <a href="https://www.judsonisd.org" target="_blank" rel="noopener" class="sa-schools__card">
            <h3>Judson ISD</h3>
            <p>Converse, Kirby, Live Oak, and northeast San Antonio — 23,000+ students on the east side of the metro.</p>
            <span class="sa-schools__link">Visit Judson ISD Website →</span>
          </a>
        </div>
        <p class="sa-schools__note">School assignments are based on physical address. Always verify directly with the district before purchasing.</p>
      </div>
    </section>

    <!-- 7. Commute -->
    <section class="section sa-commute" style="background: var(--light-gray);">
      <div class="container">
        <div class="section-title">
          <h2>Commute, <span class="accent">by Corridor</span></h2>
          <p>Typical drive times — rush hour on I-35, Loop 1604, and US-281 adds 15–20 minutes</p>
        </div>
        <div class="sa-commute__grid">
          <div class="sa-commute__card">
            <h3>Randolph AFB ↔ Schertz / Cibolo</h3>
            <p class="sa-commute__time">Under 10 min</p>
            <p>The reason military families stack up in this corridor. Gate-to-driveway in single digits.</p>
          </div>
          <div class="sa-commute__card">
            <h3>Lackland AFB ↔ Alamo Ranch</h3>
            <p class="sa-commute__time">10–15 min</p>
            <p>Straight shot up 151/410. The far west side exists because of this commute.</p>
          </div>
          <div class="sa-commute__card">
            <h3>Fort Sam ↔ Alamo Heights / Terrell Hills</h3>
            <p class="sa-commute__time">Under 15 min</p>
            <p>Premium corridor, premium commute. Government Hill is even closer, at a lower price point.</p>
          </div>
          <div class="sa-commute__card">
            <h3>Stone Oak ↔ Downtown</h3>
            <p class="sa-commute__time">20–25 min off-peak</p>
            <p>35–45+ minutes at rush hour down US-281. This is the commute that sells and unsells Stone Oak.</p>
          </div>
          <div class="sa-commute__card">
            <h3>Downtown SA ↔ New Braunfels</h3>
            <p class="sa-commute__time">30–35 min via I-35</p>
            <p>The corridor I live in. Plenty of people work San Antonio and live Hill Country — and vice versa.</p>
          </div>
          <div class="sa-commute__card">
            <h3>San Antonio ↔ Austin</h3>
            <p class="sa-commute__time">75–90 min via I-35</p>
            <p>Doable for the occasional trip, miserable as a daily drive. Commuters exist; I don't recommend it.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Explore: things to do + restaurants + more -->
    <section class="section sa-explore">
      <div class="container">
        <div class="section-title">
          <h2>Explore <span class="accent">San Antonio</span></h2>
          <p>The lifestyle side — food, history, and weekends</p>
        </div>
        <div class="sa-explore__grid sa-explore__grid--3">
          <a href="/san-antonio/things-to-do/" class="sa-explore__card">
            <h3>Things to Do</h3>
            <p>The Alamo, the 15-mile River Walk, the UNESCO missions, the Pearl, the Zoo, Six Flags and SeaWorld — what weekends actually look like here.</p>
          </a>
          <a href="/san-antonio/restaurants/" class="sa-explore__card">
            <h3>Restaurants</h3>
            <p>A UNESCO Creative City of Gastronomy. Mi Tierra at Market Square, tableside guacamole on the River Walk, the Pearl's chef-driven lineup, 2M Smokehouse's Tex-Mex BBQ.</p>
          </a>
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="sa-explore__card">
            <h3>Search Homes</h3>
            <p>See what's actually on the market across every corridor right now. Filter by price, beds, and school district.</p>
          </a>
          <a href="/military-relocation/randolph-afb/" class="sa-explore__card">
            <h3>PCS to Randolph AFB</h3>
            <p>The northeast corridor guide: where Randolph families land, BAH math, and what to do in your first 30 days.</p>
          </a>
          <a href="/military-relocation/lackland-afb/" class="sa-explore__card">
            <h3>PCS to Lackland AFB</h3>
            <p>The far west side guide: Alamo Ranch and Helotes, gate commutes, and Northside ISD schools.</p>
          </a>
          <a href="/military-relocation/fort-sam-houston/" class="sa-explore__card">
            <h3>PCS to Fort Sam Houston</h3>
            <p>The central corridor guide: Alamo Heights, Terrell Hills, and Government Hill near the gates.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 9. FAQ -->
    <section class="faq-section">
      <div class="container">
        <h2>Frequently Asked Questions About <span class="accent">San Antonio</span></h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. CTA -->
    <section class="section sa-cta-parallax">
      <div class="sa-cta-parallax__overlay"></div>
      <div class="container sa-cta-parallax__content">
        <h2>Moving to San Antonio? <span class="accent">Start With Your Commute.</span></h2>
        <p>Tell me where you'll work — which base, which employer, which side of town — and I'll send you the corridors where people in your situation actually land, with real listings and real drive times. Video walkthroughs available for out-of-state buyers.</p>
        <div class="sa-cta__buttons">
          <a href="https://cposeyrealestate.idxbroker.com/idx/search/advanced" class="btn btn-primary">Search Homes</a>
          <a href="#contact" class="btn btn-outline">Talk to Cody</a>
        </div>
      </div>
    </section>

  </main>
  <ParallaxBanner image="/images/areas/san-antonio.jpg" alt="The Alamo, San Antonio, Texas" position="center bottom" />

  <ContactForm context="Relocating to San Antonio — I'd like neighborhood guidance for my commute and budget..." />
  <Footer />
</Layout>

<style>
  /* 1. Hero */
  .sa-hero {
    position: relative;
    height: 380px;
    background: url('/images/areas/san-antonio.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    background-color: #111;
  }
  .sa-hero__overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.55); }
  .sa-hero__content { position: relative; z-index: 1; padding: 0 1.5rem; }
  .sa-hero__content h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); margin-bottom: 0.75rem; }
  .sa-hero__content p { color: rgba(255,255,255,0.7); font-size: 1rem; max-width: 640px; margin: 0 auto; }

  .breadcrumb { font-size: 0.8rem; margin-bottom: 1rem; color: rgba(255,255,255,0.5); }
  .breadcrumb a { color: rgba(255,255,255,0.5); transition: color 0.2s; }
  .breadcrumb a:hover { color: #FF1616; }
  .breadcrumb span { margin: 0 0.3rem; }

  /* 2. Quick answer + stat band */
  .sa-quick { background: #111; color: #fff; border-left: 4px solid #FF1616; padding: 1.5rem 2rem; border-radius: 0 8px 8px 0; margin-bottom: 3rem; }
  .sa-quick p { line-height: 1.8; font-size: 0.95rem; margin: 0; color: rgba(255,255,255,0.85); }
  .sa-quick strong { color: #FF1616; }

  .sa-intro__grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; align-items: start; }
  .sa-intro__text p { color: var(--gray); line-height: 1.8; margin-bottom: 1rem; }
  .sa-intro__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .sa-stat { background: var(--light-gray); padding: 1.5rem; text-align: center; border-radius: 8px; }
  .sa-stat__number { display: block; font-family: var(--font-heading); font-size: 1.8rem; font-weight: 800; color: #FF1616; }
  .sa-stat__label { display: block; font-size: 0.8rem; color: var(--gray); margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .sa-stat__note { font-size: 0.78rem; color: var(--gray); font-style: italic; margin-top: 2rem; max-width: 900px; }

  /* 3. Honest overview */
  .sa-honest__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .sa-honest__card { background: #fff; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
  .sa-honest__card h3 { font-family: var(--font-heading); font-size: 1.1rem; text-transform: uppercase; margin-bottom: 0.75rem; }
  .sa-honest__card p { color: var(--gray); font-size: 0.9rem; line-height: 1.7; }
  .sa-honest__card p a { color: #FF1616; font-weight: 600; }
  .sa-honest__card--watchouts { border-left: 4px solid #FF1616; }
  .sa-honest__card--watchouts ul { margin: 0; padding-left: 1.2rem; }
  .sa-honest__card--watchouts li { color: var(--gray); font-size: 0.9rem; line-height: 1.7; margin-bottom: 0.5rem; }
  .sa-honest__card--watchouts strong { color: #111; }

  /* 4 + 8. Explore cards */
  .sa-explore__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .sa-explore__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .sa-explore__card { display: block; background: #fff; border: 1px solid var(--light-gray); padding: 2rem; border-radius: 8px; transition: transform 0.2s, box-shadow 0.2s; }
  .sa-explore__card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
  .sa-explore__card h3 { font-family: var(--font-heading); font-size: 1rem; text-transform: uppercase; margin-bottom: 0.5rem; color: #000; }
  .sa-explore__card:hover h3 { color: #FF1616; }
  .sa-explore__card p { color: var(--gray); font-size: 0.85rem; line-height: 1.6; }

  /* 5. Cost table */
  .sa-cost__table-wrap { max-width: 900px; margin: 0 auto; overflow-x: auto; }
