---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import BookSession from '../components/BookSession.astro';
import { contactPageSchema, breadcrumbSchema } from '../lib/schema';

const pageTitle = 'Contact Cody Posey | San Antonio & New Braunfels';
const pageDescription = 'Contact Cody Posey for help buying, selling, or relocating in San Antonio, New Braunfels, and the Texas Hill Country, including military PCS moves.';
const pageSchema = [
  contactPageSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact/' },
  ]),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={pageSchema}
>
  <Navbar />

  <main class="contact-page">
    <section class="contact-hero">
      <div class="container">
        <h1>Get In <span class="accent">Touch</span></h1>
        <p>Buying, selling, or relocating in San Antonio, New Braunfels, or the Hill Country? Questions about a PCS move or a home valuation? Drop me a note and I'll get back to you fast.</p>
      </div>
    </section>

    <ContactForm />

    <BookSession />
  </main>

  <Footer />
</Layout>

<style>
  .contact-page {
    padding-top: 76px;
  }
  .contact-hero {
    background: linear-gradient(135deg, #000 0%, #1a1a1a 100%);
    color: #fff;
    padding: 5rem 0 3rem;
    text-align: center;
  }
  .contact-hero h1 {
    color: #fff;
    margin-bottom: 1rem;
  }
  .contact-hero .accent {
    color: #FF1616;
  }
  .contact-hero p {
    color: rgba(255,255,255,0.7);
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.05rem;
  }
</style>
