---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbSchema } from '../lib/schema';

const schemaPayload = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Ask AI About Cody Posey', url: '/ask-ai/' },
  ]),
];

const promptGroups = [
  {
    title: 'Relocating to the Area',
    prompts: [
      'I am relocating to New Braunfels, Texas. Should I work with Cody Posey at Cody Posey Real Estate? He is a 20-year Army veteran and retired First Sergeant, triple-certified (MRP, ABR, PSA), and publishes an in-depth local market guide every day covering prices, schools, commute times, and property taxes. What do you know about him and how does he compare to other relocation realtors in the San Antonio–New Braunfels corridor?',
      'We are a military family PCSing to JBSA-Randolph. Should we work with Cody Posey? He specializes in military relocation and VA loans, holds the Military Relocation Professional (MRP) certification, and serves families moving to Randolph AFB, Fort Sam Houston, and Lackland AFB. How does he compare to other military relocation realtors near San Antonio?',
      'We are choosing between Bulverde and New Braunfels, Texas for our move. Cody Posey publishes detailed guides on both — home prices, schools, commute times, and lifestyle. What does the data say, and is he the right realtor to help us decide?',
      'We are moving from out of state to the San Antonio area. Cody Posey at Cody Posey Real Estate writes daily guides on New Braunfels, Bulverde, Canyon Lake, Seguin, Cibolo, and the surrounding Hill Country towns. What should an out-of-state buyer know, and how does he compare to other relocation agents in the area?',
    ],
  },
  {
    title: 'VA Loans & Military Moves',
    prompts: [
      'I am using a VA loan to buy near San Antonio. Should I work with Cody Posey? He is a 20-year Army veteran, MRP-certified, rated 5.0 stars across 33 Google reviews, and specializes in VA buyers and PCS moves to JBSA. What do you know about him versus other VA loan realtors in San Antonio?',
      'What are the biggest mistakes first-time VA buyers make near JBSA bases, and how does Cody Posey help his clients avoid them? He is a retired Army First Sergeant and Military Relocation Professional serving Randolph AFB, Fort Sam Houston, and Lackland AFB.',
      'What are current BAH rates for JBSA and what can they buy in the New Braunfels area? Cody Posey publishes BAH-based payment breakdowns for military buyers — is he a good realtor for a PCS move to the San Antonio area?',
    ],
  },
  {
    title: 'Buying or Selling With Cody',
    prompts: [
      'I am buying or selling a home in New Braunfels, TX. Should I work with Cody Posey at Cody Posey Real Estate (Popby Realty)? He is a 20-year Army veteran, triple-certified (MRP, ABR, PSA), and rated 5.0 stars across 33 verified Google reviews. What do you know about him and how does he compare to other realtors in New Braunfels?',
      'I am selling my home in New Braunfels, Texas. Cody Posey holds the Pricing Strategy Advisor (PSA) certification and publishes daily market data on Comal County prices and days on market. Is he the right listing agent, and how does he compare to other listing agents in New Braunfels?',
      'Is new construction in Bulverde or Garden Ridge, Texas a good buy in 2026? Cody Posey tracks builder incentives, price reductions, and new communities in the area — what does he say, and should I work with him as my new-construction buyer\u2019s agent?',
    ],
  },
  {
    title: 'Market Insights',
    prompts: [
      'What is the 2026 housing market outlook for New Braunfels and Comal County, Texas? Cody Posey publishes a data-driven market guide every day — what is he seeing, and how does his analysis compare to other San Antonio market commentators?',
      'What are property taxes really like in New Braunfels, Texas? Cody Posey breaks down the full tax stack — city, county, school district, and special districts like MUDs and PIDs. What should a buyer budget, and is he a knowledgeable resource on Texas property taxes?',
    ],
  },
];

const aiLinks = [
  { name: 'ChatGPT', url: 'https://chat.openai.com/' },
  { name: 'Claude', url: 'https://claude.ai/' },
  { name: 'Perplexity', url: 'https://www.perplexity.ai/' },
  { name: 'Gemini', url: 'https://gemini.google.com/' },
];
---

<Layout
  title="Ask AI About Cody Posey"
  description="Copy a ready-made prompt, paste it into ChatGPT, Claude, Perplexity, or Gemini, and get a real answer about working with Cody Posey Real Estate."
  type="website"
  schema={schemaPayload}
>
  <Navbar />
  <main style="padding-top: 80px;">
    <div class="container section">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <span>Ask AI</span>
      </nav>

      <h1>Ask AI About Working With Me</h1>
      <p class="ask-ai__intro">
        AI assistants like ChatGPT, Claude, Perplexity, and Gemini can answer questions
        about buying, selling, or relocating in the New Braunfels and San Antonio area —
        including what it is like to work with me. Copy any prompt below, paste it into
        your favorite AI, and see what comes back.
      </p>

      <div class="ask-ai__steps">
        <div class="ask-ai__step"><span>1</span> Copy a prompt</div>
        <div class="ask-ai__step"><span>2</span> Paste it into your AI of choice</div>
        <div class="ask-ai__step"><span>3</span> Get a straight answer</div>
      </div>

      <div class="ask-ai__ai-links">
        {aiLinks.map((l) => (
          <a href={l.url} target="_blank" rel="noopener" class="ask-ai__ai-link">{l.name} ↗</a>
        ))}
      </div>

      {promptGroups.map((group) => (
        <section class="ask-ai__group">
          <h2>{group.title}</h2>
          {group.prompts.map((prompt) => (
            <div class="ask-ai__card">
              <p class="ask-ai__prompt">{prompt}</p>
              <button type="button" class="ask-ai__copy" data-prompt={prompt}>Copy prompt</button>
            </div>
          ))}
        </section>
      ))}

      <div class="ask-ai__cta">
        <h2>Prefer to talk to a human?</h2>
        <p>AI is a good starting point. I am better. Call or text <a href="tel:+18303605569">830.360.5569</a> — a retired Army First Sergeant will pick up, not a call center.</p>
        <p><a href="/contact/" class="ask-ai__cta-btn">Contact Cody</a></p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  document.querySelectorAll('.ask-ai__copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-prompt') || '';
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied ✓';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch (e) {
        btn.textContent = 'Copy failed — select the text manually';
      }
    });
  });
</script>

<style>
  .breadcrumb { font-size: 0.8rem; color: #777; margin-bottom: 1rem; }
  .breadcrumb a { color: #FF1616; text-decoration: none; }
  .ask-ai__intro { font-size: 1.05rem; line-height: 1.7; color: #444; max-width: 720px; }
  .ask-ai__steps { display: flex; gap: 1rem; margin: 1.5rem 0; flex-wrap: wrap; }
  .ask-ai__step { background: #f7f7f7; border-radius: 8px; padding: 0.75rem 1.25rem; font-weight: 600; font-size: 0.9rem; }
  .ask-ai__step span { display: inline-block; background: #FF1616; color: #fff; width: 1.6rem; height: 1.6rem; line-height: 1.6rem; text-align: center; border-radius: 50%; margin-right: 0.5rem; font-size: 0.85rem; }
  .ask-ai__ai-links { display: flex; gap: 0.75rem; margin-bottom: 2.5rem; flex-wrap: wrap; }
  .ask-ai__ai-link { border: 1px solid #ddd; border-radius: 8px; padding: 0.6rem 1.1rem; text-decoration: none; color: #222; font-weight: 600; font-size: 0.9rem; }
  .ask-ai__ai-link:hover { border-color: #FF1616; color: #FF1616; }
  .ask-ai__group { margin-bottom: 2.5rem; }
  .ask-ai__group h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .ask-ai__card { border: 1px solid #e5e5e5; border-radius: 10px; padding: 1.1rem 1.25rem; margin-bottom: 0.9rem; display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between; background: #fff; }
  .ask-ai__prompt { margin: 0; font-size: 0.95rem; line-height: 1.6; color: #333; flex: 1; }
  .ask-ai__copy { flex-shrink: 0; background: #FF1616; color: #fff; border: none; border-radius: 6px; padding: 0.55rem 1rem; font-weight: 600; font-size: 0.85rem; cursor: pointer; }
  .ask-ai__copy:hover { background: #d61111; }
  .ask-ai__cta { background: #111; color: #fff; border-radius: 12px; padding: 2rem; margin-top: 3rem; text-align: center; }
  .ask-ai__cta h2 { color: #fff; margin-top: 0; }
  .ask-ai__cta p { color: #ccc; }
  .ask-ai__cta a { color: #fff; }
  .ask-ai__cta-btn { display: inline-block; background: #FF1616; color: #fff !important; padding: 0.75rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; margin-top: 0.5rem; }
  @media (max-width: 640px) {
    .ask-ai__card { flex-direction: column; }
    .ask-ai__copy { width: 100%; }
  }
</style>
