---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import QuickActions from '../components/QuickActions.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.astro';
import HomeDiscovery from '../components/HomeDiscovery.astro';
import HomeServices from '../components/HomeServices.astro';
import FeaturedBlogs from '../components/FeaturedBlogs.astro';
import FeaturedProperties from '../components/FeaturedProperties.astro';
import StatsBand from '../components/StatsBand.astro';
import PcsLandingPlan from '../components/PcsLandingPlan.astro';
import WorkWithUs from '../components/WorkWithUs.astro';
import BookSession from '../components/BookSession.astro';
import Footer from '../components/Footer.astro';
import ParallaxBanner from '../components/ParallaxBanner.astro';
import { homepageSchema } from '../lib/schema';
---

<Layout
  title="San Antonio &amp; New Braunfels Real Estate | Cody Posey"
  description="Retired Army First Sergeant and REALTOR® serving San Antonio, New Braunfels, and the Texas Hill Country. Buying, selling, military PCS relocation, and VA home-buying guidance."
  image="/images/cody-posey.webp"
  schema={homepageSchema()}
>
  <Navbar />
  <main>
    <Hero />
    <SocialProof />
    <QuickActions />
    <HomeDiscovery />
    <FeaturedProperties />
    <Portfolio />
    <HomeServices />
    <Testimonials />
    <StatsBand />
    <PcsLandingPlan />
    <HomeServices resources />
    <FeaturedBlogs />
    <ParallaxBanner image="/images/generated/hill-country-sunset.webp" />
    <BookSession />
    <WorkWithUs />
  </main>
  <Footer />
</Layout>
