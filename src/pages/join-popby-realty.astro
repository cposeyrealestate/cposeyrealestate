---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import ParallaxBanner from '../components/ParallaxBanner.astro';
import { articleSchema, breadcrumbSchema, faqSchema } from '../lib/schema';

const JOIN_POPBY_URL = 'https://www.joinpopby.com/';

const pageTitle = 'Join Popby Realty | Brokerage Savings Calculator for Agents | Cody Posey';
const pageDescription =
  'Thinking about a brokerage change? See what your current split, cap, and fees actually cost you each year versus Popby Realty, then explore joining the team.';

const faqs = [
  {
    q: 'What is Popby Realty?',
    a: 'Popby Realty is the brokerage Cody Posey hangs his license with, built around a capped commission plan, a flat monthly technology fee, and a revenue share program that pays agents for helping grow the brokerage. You can read the full model at joinpopby.com.',
  },
  {
    q: 'How does the savings calculator work?',
    a: 'You enter the numbers you already know — your annual gross commission income, your current split with your brokerage, your monthly fees, and how many transactions you close. The calculator compares that against Popby Realty\'s published fee schedule and shows the yearly difference.',
  },
  {
    q: 'Are the results a guarantee of what I would earn?',
    a: 'No. The calculator produces an estimate based only on the figures you enter and Popby Realty\'s current published fee schedule. Real income depends on your production, your market, and your expenses. Treat the output as a starting point for a conversation, not a promise.',
  },
  {
    q: 'Do I have to give my contact information to use it?',
    a: 'No. The calculator runs entirely in your browser with no login and no signup. You only share your name and email if you choose to request a written breakdown.',
  },
  {
    q: 'Who do I talk to about joining?',
    a: 'Cody Posey. He is a REALTOR® with Popby Realty serving New Braunfels, San Antonio, and the Texas Hill Country, and he can walk you through the plan, the tools, and the revenue share side of the business.',
  },
];

const pageSchema = [
  articleSchema({
    title: pageTitle,
    description: pageDescription,
    url: '/join-popby-realty/',
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Join Popby Realty', url: '/join-popby-realty/' },
  ]),
  faqSchema(faqs),
];
---

<Layout title={pageTitle} description={pageDescription} schema={pageSchema}>
  <Navbar />
  <main style="padding-top: 80px;">

    <!-- Hero -->
    <div class="jp-hero" style="background-image:url('/images/generated/calculator-hero.webp');">
      <div class="jp-hero__overlay"></div>
      <div class="jp-hero__content">
        <h1>Join <span style="color:#FF1616;">Popby Realty</span></h1>
        <p>Run your own numbers, then come see what the brokerage looks like from the inside.</p>
      </div>
    </div>

    <!-- Intro + primary link out to joinpopby.com -->
    <section class="section">
      <div class="container">
        <div class="jp-intro">
          <div class="jp-intro__copy">
            <h2>A brokerage built around <span class="accent">keeping more of what you earn</span></h2>
            <p>
              Most agents can tell you their split. Far fewer can tell you what that
              split, plus the desk fee, plus the technology fee, plus the per-transaction
              fee actually added up to last year. That number is usually the reason a
              brokerage change gets put off another season.
            </p>
            <p>
              Popby Realty runs on a capped commission plan with a flat monthly
              technology fee and a revenue share program for agents who help the
              brokerage grow. Start with the calculator below to see your own numbers,
              then head over to the Popby Realty site for the full picture.
            </p>
            <div class="jp-intro__actions">
              <a class="btn btn-primary" href={JOIN_POPBY_URL} target="_blank" rel="noopener">
                Visit joinpopby.com
              </a>
              <a class="btn btn-outline-dark" href="#savings-calculator">Run the numbers first</a>
            </div>
          </div>
          <a class="jp-intro__card" href={JOIN_POPBY_URL} target="_blank" rel="noopener">
            <img
              src="/images/popby-wordmark.png"
              width="750"
              height="258"
              alt="Popby Realty"
              loading="lazy"
            />
            <span class="jp-intro__card-label">joinpopby.com</span>
            <span class="jp-intro__card-cta">See the full brokerage model &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Savings calculator -->
    <section class="section jp-calc-section" id="savings-calculator">
      <div class="container">
        <div class="section-title">
          <h2>Popby Savings <span class="accent">Calculator</span></h2>
          <p>No login, no signup. Everything runs in your browser.</p>
        </div>

        <!--
          data-mode is read from the ?mode= URL param by JS below and applied here.
          Default is "full". See LAYER 2 for the mode switch logic.
        -->
        <div class="pb-calc" id="pbCalc" data-mode="full">
          <div class="pb-shell">

            <div class="pb-eyebrow-row">
              <div class="pb-wordmark"><a href="https://www.joinpopby.com/" target="_blank" rel="noopener"><img src="/images/popby-wordmark.png" width="750" height="258" alt="Popby Realty" /></a></div>
              <div class="pb-agent-chip" id="pbAgentChip" hidden>
                <img id="pbAgentChipImg" src="" alt="" hidden />
                <span id="pbAgentChipText">Guided by an agent</span>
              </div>
            </div>

            <!-- FULL MODE HERO -->
            <div class="pb-hero" id="pbHero">
              <h1>Know your numbers.</h1>
              <p>Your brokerage should make sense for your business. Enter what you're
                producing today and we'll do the math on what you're actually paying
                to sell real estate — no login, no pressure.</p>
            </div>

            <!-- EMBED MODE HEADING -->
            <h2 class="pb-embed-heading" id="pbEmbedHeading" hidden>Let's see what you could keep.</h2>

            <!-- CALCULATOR CARD -->
            <div class="pb-card">

              <div class="pb-field">
                <div class="pb-field-label"><span>Current brokerage</span><span class="pb-hint">optional</span></div>
                <div class="pb-select-row">
                  <select id="pbBrokeragePreset">
                    <option value="">Select to auto-fill a typical split</option>
                  </select>
                </div>
                <small class="pb-desc">Just a starting point — every office is different. Adjust the split below to match yours.</small>
              </div>

              <div class="pb-field">
                <div class="pb-field-label">
                  <span>Annual GCI</span>
                  <span class="pb-field-value" id="pbGciDisplay">$120,000</span>
                </div>
                <input type="range" class="pb-slider" id="pbGci" min="20000" max="500000" step="5000" value="120000" />
                <small class="pb-desc">Total commission income you generate in a year, before any splits.</small>
              </div>

              <div class="pb-grid-2">
                <div class="pb-field">
                  <div class="pb-field-label"><span>Deals per year</span></div>
                  <div class="pb-input-row">
                    <input type="number" id="pbTransactions" value="12" min="0" step="1" inputmode="numeric" />
                  </div>
                </div>
                <div class="pb-field">
                  <div class="pb-field-label">
                    <span>Current split you pay</span>
                    <span class="pb-field-value" id="pbSplitDisplay">20%</span>
                  </div>
                  <input type="range" class="pb-slider" id="pbSplit" min="0" max="50" step="1" value="20" />
                </div>
              </div>

              <div class="pb-field">
                <div class="pb-field-label">
                  <span>Monthly brokerage fees</span>
                  <span class="pb-hint">optional</span>
                </div>
                <div class="pb-input-row">
                  <span class="pb-prefix">$</span>
                  <input type="number" id="pbMonthlyFees" placeholder="0" min="0" step="5" inputmode="numeric" />
                </div>
                <small class="pb-desc">Desk fees, franchise fees, tech fees — anything billed monthly on top of your split.</small>
              </div>

              <button class="pb-cta-btn" id="pbCalculateBtn" type="button">See where your money is going</button>
            </div>

            <!-- POPBY FEE SCHEDULE (interactive: right column updates with your GCI/deals above) -->
            <div class="pb-fee-card" id="pbFeeCard" data-open="false">
              <button class="pb-fee-toggle" id="pbFeeToggle" type="button" aria-expanded="false">
                <span>The Popby<sup>&reg;</sup> Way</span>
                <span class="pb-fee-chevron" aria-hidden="true"></span>
              </button>
              <div class="pb-fee-table-wrap" id="pbFeeTableWrap" hidden>
                <table class="pb-fee-table">
                  <thead>
                    <tr><th>What</th><th>Popby's rate</th><th>Based on your numbers</th></tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><div class="pb-fee-name-row"><span class="pb-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></span><div><span class="pb-fee-name">Commission split</span><span class="pb-fee-desc">What Popby keeps, until you hit the cap</span></div></div></td>
                      <td id="pbFeeSplitRate"></td>
                      <td class="pb-fee-live pb-tabular" id="pbFeeSplitLive">—</td>
                    </tr>
                    <tr>
                      <td><div class="pb-fee-name-row"><span class="pb-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span><div><span class="pb-fee-name">Annual cap</span><span class="pb-fee-desc">After this, you keep 100% for the rest of the year</span></div></div></td>
                      <td id="pbFeeCapRate"></td>
                      <td class="pb-fee-live pb-tabular" id="pbFeeCapLive">—</td>
                    </tr>
                    <tr>
                      <td><div class="pb-fee-name-row"><span class="pb-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><div><span class="pb-fee-name">Monthly tech fee</span><span class="pb-fee-desc">Flat platform fee, billed monthly</span></div></div></td>
                      <td id="pbFeeTechRate"></td>
                      <td class="pb-fee-live pb-tabular" id="pbFeeTechLive">—</td>
                    </tr>
                    <tr>
                      <td><div class="pb-fee-name-row"><span class="pb-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M20.59 13.41 13.41 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></span><div><span class="pb-fee-name">Transaction fee</span><span class="pb-fee-desc">Flat fee per closed deal</span></div></div></td>
                      <td id="pbFeeTxnRate"></td>
                      <td class="pb-fee-live pb-tabular" id="pbFeeTxnLive">—</td>
                    </tr>
                    <tr>
                      <td><div class="pb-fee-name-row"><span class="pb-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><circle cx="12" cy="8" r="6"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/></svg></span><div><span class="pb-fee-name">Royalty fee</span><span class="pb-fee-desc">Franchise/royalty charge</span></div></div></td>
                      <td id="pbFeeRoyaltyRate"></td>
                      <td class="pb-fee-live pb-tabular" id="pbFeeRoyaltyLive">—</td>
                    </tr>
                  </tbody>
                </table>
                <p class="pb-fee-table-note">The "based on your numbers" column updates live from the GCI and deals-per-year fields above.</p>
              </div>
            </div>

            <!-- RESULTS -->
            <div class="pb-results" id="pbResults">
              <div class="pb-results-headline">
                <div class="pb-label">What you could keep with Popby, per year</div>
                <div class="pb-amount pb-tabular" id="pbSavingsAmount">$0</div>
                <div class="pb-amount-sub" id="pbSavingsSub"></div>
              </div>

              <div class="pb-donut-row">
                <div class="pb-donut-col pb-donut-current">
                  <svg width="72" height="72" viewBox="0 0 72 72">
                    <circle class="pb-donut-ring-track" cx="36" cy="36" r="30" stroke-width="8" />
                    <circle class="pb-donut-ring-value" id="pbDonutCurrentRing" cx="36" cy="36" r="30" stroke-width="8"
                      stroke-dasharray="0 188.5" transform="rotate(-90 36 36)" />
                  </svg>
                  <div class="pb-donut-pct" id="pbDonutCurrentPct">0%</div>
                  <div class="pb-donut-label">You keep today</div>
                </div>
                <div class="pb-donut-col pb-donut-popby">
                  <svg width="72" height="72" viewBox="0 0 72 72">
                    <circle class="pb-donut-ring-track" cx="36" cy="36" r="30" stroke-width="8" />
                    <circle class="pb-donut-ring-value" id="pbDonutPopbyRing" cx="36" cy="36" r="30" stroke-width="8"
                      stroke-dasharray="0 188.5" transform="rotate(-90 36 36)" />
                  </svg>
                  <div class="pb-donut-pct" id="pbDonutPopbyPct">0%</div>
                  <div class="pb-donut-label">You'd keep with Popby</div>
                </div>
              </div>

              <div class="pb-compare">
                <div class="pb-compare-col">
                  <h4>Your brokerage, today</h4>
                  <div class="pb-total pb-tabular" id="pbCurrentTotal">$0</div>
                  <ul id="pbCurrentBreakdown"></ul>
                </div>
                <div class="pb-compare-col">
                  <h4>With Popby</h4>
                  <div class="pb-total pb-tabular" id="pbPopbyTotal">$0</div>
                  <ul id="pbPopbyBreakdown"></ul>
                </div>
              </div>

              <!-- CAP COUNTDOWN -->
              <div class="pb-cap-countdown" id="pbCapCountdown" hidden>
                <h4 id="pbCapHeadline">Your cap</h4>
                <div class="pb-cap-track">
                  <div class="pb-cap-fill" id="pbCapFill"></div>
                  <div class="pb-cap-marker" id="pbCapMarker"></div>
                </div>
                <p class="pb-cap-copy" id="pbCapCopy"></p>
              </div>

              <!-- MULTI-YEAR PROJECTION -->
              <div class="pb-projection" id="pbProjection" hidden>
                <h4 id="pbProjectionTitle">If nothing else changes</h4>
                <p class="pb-proj-sub">Same production, no growth assumed — just what today's numbers add up to over time.</p>
                <div class="pb-proj-row">
                  <span class="pb-proj-label">Year 1</span>
                  <div class="pb-proj-track"><div class="pb-proj-bar" id="pbProjBar1"></div></div>
                  <span class="pb-proj-value pb-tabular" id="pbProjVal1">$0</span>
                </div>
                <div class="pb-proj-row">
                  <span class="pb-proj-label">Year 3</span>
                  <div class="pb-proj-track"><div class="pb-proj-bar" id="pbProjBar3"></div></div>
                  <span class="pb-proj-value pb-tabular" id="pbProjVal3">$0</span>
                </div>
                <div class="pb-proj-row">
                  <span class="pb-proj-label">Year 5</span>
                  <div class="pb-proj-track"><div class="pb-proj-bar" id="pbProjBar5"></div></div>
                  <span class="pb-proj-value pb-tabular" id="pbProjVal5">$0</span>
                </div>
              </div>

              <details class="pb-disclosure">
                <summary>How we calculated this</summary>
                <p>We'll do the math. You decide. Your current cost is your GCI times the split
                  you pay, plus any monthly fees you entered, annualized. Your Popby cost is a
                  capped split (never more than $<span id="pbDiscCap"></span>/year), a flat monthly
                  tech fee, and a per-transaction fee — all set out in Popby's published fee
                  structure. Compare the numbers for yourself.</p>
              </details>

              <button class="pb-share-btn" id="pbShareBtn" type="button">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 10.5 15.4 6.5M8.6 13.5 15.4 17.5"/></svg>
                Share My Results
              </button>
              <p class="pb-share-status" id="pbShareStatus" hidden></p>
              <canvas id="pbShareCanvas" width="1080" height="1080" style="display:none;"></canvas>

              <!-- LEAD CAPTURE (shown after results, never gated) -->
              <div class="pb-lead" id="pbLead">
                <div id="pbLeadForm">
                  <h3>Want a personalized breakdown?</h3>
                  <p>We'll send you your numbers and answer any questions about what switching to Popby could look like.</p>
                  <div class="pb-lead-fields">
                    <div class="pb-input-row"><input type="text" id="pbFirstName" placeholder="First name" /></div>
                    <div class="pb-input-row"><input type="email" id="pbEmail" placeholder="Email" /></div>
                    <div class="pb-input-row"><input type="tel" id="pbPhone" placeholder="Phone (optional)" /></div>
                    <div class="pb-input-row"><input type="text" id="pbBrokerage" placeholder="Current brokerage (optional)" /></div>
                  </div>
                  <!-- Honeypot field — real visitors never see or fill this in.
                       See the .pb-hp-field CSS comment and wireLeadForm() JS. -->
                  <div class="pb-hp-field" aria-hidden="true">
                    <label for="pbHoneypot">Leave this field empty</label>
                    <input type="text" id="pbHoneypot" name="company_website" tabindex="-1" autocomplete="off" />
                  </div>
                  <button class="pb-cta-btn" id="pbSendBreakdownBtn" type="button">Send Me My Breakdown</button>
                  <p class="pb-trust-line">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5l-8-3Z"/></svg>
                    No spam, no obligation — just your numbers.
                  </p>
                </div>
                <div class="pb-lead-success" id="pbLeadSuccess" hidden>
                  <div class="pb-check">✓</div>
                  <h4>Sent.</h4>
                  <p id="pbLeadSuccessCopy">We'll follow up with your personalized breakdown shortly.</p>
                </div>
              </div>
            </div>

            <!-- REVENUE SHARE PROJECTION -->
            <div class="pb-revshare-card">
              <h3>Grow your income by growing your team</h3>
              <p>Popby shares a piece of what the company earns from agents you bring in —
                four tiers deep. Enter how many agents you'd have at each tier and a rough
                average GCI, and we'll estimate what that could pay you every year.</p>

              <div class="pb-tier-diagram" aria-hidden="true">
                <div class="pb-tier-node"><span class="pb-tier-node-num">TIER 1</span><span class="pb-tier-node-pct" id="pbDiagTier1Pct">5%</span></div>
                <div class="pb-tier-arrow">&rarr;</div>
                <div class="pb-tier-node"><span class="pb-tier-node-num">TIER 2</span><span class="pb-tier-node-pct" id="pbDiagTier2Pct">4%</span></div>
                <div class="pb-tier-arrow">&rarr;</div>
                <div class="pb-tier-node"><span class="pb-tier-node-num">TIER 3</span><span class="pb-tier-node-pct" id="pbDiagTier3Pct">2%</span></div>
                <div class="pb-tier-arrow">&rarr;</div>
                <div class="pb-tier-node"><span class="pb-tier-node-num">TIER 4</span><span class="pb-tier-node-pct" id="pbDiagTier4Pct">1%</span></div>
              </div>

              <div class="pb-tier-grid">
                <div class="pb-tier-field">
                  <label for="pbTier1">Tier 1 agents <span class="pb-tier-pct" id="pbTier1Pct"></span></label>
                  <div class="pb-input-row"><input type="number" id="pbTier1" min="0" step="1" placeholder="0" inputmode="numeric" /></div>
                </div>
                <div class="pb-tier-field">
                  <label for="pbTier2">Tier 2 agents <span class="pb-tier-pct" id="pbTier2Pct"></span></label>
                  <div class="pb-input-row"><input type="number" id="pbTier2" min="0" step="1" placeholder="0" inputmode="numeric" /></div>
                </div>
                <div class="pb-tier-field">
                  <label for="pbTier3">Tier 3 agents <span class="pb-tier-pct" id="pbTier3Pct"></span></label>
                  <div class="pb-input-row"><input type="number" id="pbTier3" min="0" step="1" placeholder="0" inputmode="numeric" /></div>
                </div>
                <div class="pb-tier-field">
                  <label for="pbTier4">Tier 4 agents <span class="pb-tier-pct" id="pbTier4Pct"></span></label>
                  <div class="pb-input-row"><input type="number" id="pbTier4" min="0" step="1" placeholder="0" inputmode="numeric" /></div>
                </div>
              </div>

              <div class="pb-field">
                <div class="pb-field-label">
                  <span>Average GCI per downline agent</span>
                </div>
                <div class="pb-input-row">
                  <span class="pb-prefix">$</span>
                  <input type="number" id="pbAvgDownlineGci" min="0" step="5000" placeholder="120000" inputmode="numeric" />
                </div>
                <small class="pb-desc">A rough average across the agents you'd recruit — doesn't need to be exact.</small>
              </div>

              <button class="pb-cta-btn" id="pbCalcRevShareBtn" type="button">See my team's potential</button>

              <div class="pb-revshare-results" id="pbRevShareResults">
                <div class="pb-revshare-total-card">
                  <div class="pb-label">Estimated revenue share, per year</div>
                  <div class="pb-amount pb-tabular" id="pbRevShareTotal">$0</div>
                </div>
                <ul class="pb-revshare-breakdown" id="pbRevShareBreakdown"></ul>

                <div class="pb-combined-total" id="pbCombinedTotal" hidden>
                  Combine that with your brokerage savings and your total potential
                  Popby advantage is
                  <strong id="pbCombinedAmount">$0/year</strong>
                </div>

                <details class="pb-disclosure">
                  <summary>How we calculated this</summary>
                  <p>Revenue share is estimated as a percentage of the "company dollar" Popby
                    collects from each downline agent — their capped split plus Popby's flat
                    monthly tech fee — based on the average GCI you entered. Tier 1 pays 5%,
                    Tier 2 pays 4%, Tier 3 pays 2%, and Tier 4 pays 1%. This is an estimate to
                    help you think through the model, not a guarantee of earnings.</p>
                </details>
              </div>
            </div>

            <!-- BOTTOM RECRUITING CTA -->
            <div class="pb-recruit-cta">
              <div class="pb-recruit-copy">
                <div class="pb-kicker">Curious what Popby could look like for your business?</div>
                <h3 id="pbRecruitHeadline">Let's talk.</h3>
              </div>
              <div class="pb-recruit-agent">
                <img id="pbBottomAgentImg" src="" alt="" hidden />
                <button class="pb-book-btn" id="pbBookCallBtn" type="button">Book a Conversation</button>
                <a class="pb-learn-link" id="pbLearnMoreLink" href="https://www.joinpopby.com/" target="_blank" rel="noopener">Explore Popby Realty</a>
              </div>
            </div>

            <p class="pb-footnote">Estimates only, based on the figures you enter and Popby's current published fee schedule. Not a guarantee of earnings or savings. <a href="#" id="pbPrivacyLink">Privacy</a></p>

          </div>
        </div>

      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <div class="section-title">
          <h2>Common <span class="accent">Questions</span></h2>
        </div>
        <div class="jp-faq">
          {faqs.map((item) => (
            <details class="jp-faq__item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>

  <ParallaxBanner image="/images/generated/hill-country-sunset.webp" />

  <ContactForm context="I'm a licensed agent and I'd like to hear more about joining Popby Realty..." />
  <Footer />
</Layout>

<style>
  .jp-hero {
    position: relative;
