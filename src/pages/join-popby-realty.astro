<script is:inline>
(function () {
  "use strict";

  // ==========================================================================
  // CENTRAL CONFIGURATION
  // Every calculation in this file reads from these two objects. Nothing
  // below should ever hardcode a fee number directly — update it here and
  // it propagates everywhere, including inside the CTA copy and breakdowns.
  // ==========================================================================
  const POPBY_CONFIG = {
    brokerageSplit: 0.15,   // % of GCI Popby keeps, until the annual cap is hit
    annualCap: 12000,       // once an agent has paid this much in splits, they go to 100%
    monthlyTechFee: 79,     // flat monthly platform/tech fee
    transactionFee: 250,    // flat fee per closed transaction
    royaltyFee: 0,          // placeholder for a future royalty/franchise fee, currently $0

    // 4-tier revenue share: % of the "company dollar" (capped split + tech
    // fee) Popby collects from each downline agent, paid up to the
    // recruiting agent who brought them in.
    revShareTiers: [0.05, 0.04, 0.02, 0.01]
  };

  const POPBY_LINKS = {
    // The brokerage's own site — where "Explore Popby Realty" and the
    // wordmark both point.
    learnMore: "https://www.joinpopby.com/",
    defaultBooking: "https://calendly.com/popbyrealty",
    privacy: "#",

    // Where lead submissions get POSTed. Point this at a deployed Google
    // Apps Script Web App URL (see google-apps-script-lead-handler.gs,
    // shipped alongside this file) to both log every submission to a
    // Google Sheet AND email a notification to camille@popbyrealty.com.
    // Leave blank to keep the calculator working with zero integration —
    // submitRecruitingLead() below still logs the lead to the console.
    leadWebhook: ""
  };

  // Illustrative starting points only — real splits vary by office/market.
  // Selecting one just pre-fills the split slider + monthly fee field, which
  // the visitor can (and should) adjust to match their actual numbers.
  const POPBY_BROKERAGE_PRESETS = [
    { label: "Keller Williams", split: 30, monthlyFee: 60 },
    { label: "eXp Realty", split: 20, monthlyFee: 85 },
    { label: "RE/MAX", split: 30, monthlyFee: 150 },
    { label: "Coldwell Banker", split: 30, monthlyFee: 100 },
    { label: "Compass", split: 20, monthlyFee: 0 },
    { label: "Other / I know my numbers", split: null, monthlyFee: null }
  ];


  // ==========================================================================
  // === LAYER 1: CALCULATION ENGINE =========================================
  // Pure functions only — no DOM access, no globals besides POPBY_CONFIG.
  // This is the part that should stay identical between ?mode=full and
  // ?mode=embed, and the part a future backend/CRM sync would want to
  // mirror server-side for lead-scoring.
  // ==========================================================================

  /**
   * Estimate an agent's current annual brokerage cost.
   * @param {number} annualGCI
   * @param {number} currentSplitPercent  e.g. 20 for "I pay a 20% split"
   * @param {number} monthlyFees          desk/tech/franchise fees billed monthly
   * @returns {{splitCost:number, feeCost:number, total:number}}
   */
  function calculateCurrentBrokerageCost(annualGCI, currentSplitPercent, monthlyFees) {
    const splitCost = annualGCI * (currentSplitPercent / 100);
    const feeCost = (monthlyFees || 0) * 12;
    return {
      splitCost: round(splitCost),
      feeCost: round(feeCost),
      total: round(splitCost + feeCost)
    };
  }

  /**
   * Estimate what the same agent would pay under Popby's model:
   * a capped split, plus a flat monthly tech fee, plus a flat per-transaction
   * fee. All figures come from POPBY_CONFIG so they can be updated in one place.
   * @param {number} annualGCI
   * @param {number} annualTransactions
   * @returns {{splitCost:number, techCost:number, transactionCost:number, royaltyCost:number, total:number}}
   */
  function calculatePopbyCost(annualGCI, annualTransactions) {
    const uncappedSplit = annualGCI * POPBY_CONFIG.brokerageSplit;
    const splitCost = Math.min(uncappedSplit, POPBY_CONFIG.annualCap);
    const techCost = POPBY_CONFIG.monthlyTechFee * 12;
    const transactionCost = POPBY_CONFIG.transactionFee * (annualTransactions || 0);
    const royaltyCost = POPBY_CONFIG.royaltyFee;
    return {
      splitCost: round(splitCost),
      techCost: round(techCost),
      transactionCost: round(transactionCost),
      royaltyCost: round(royaltyCost),
      total: round(splitCost + techCost + transactionCost + royaltyCost)
    };
  }

  /**
   * Full comparison used to drive the UI.
   */
  function calculatePopbySavings(inputs) {
    const current = calculateCurrentBrokerageCost(inputs.annualGCI, inputs.currentSplitPercent, inputs.monthlyFees);
    const popby = calculatePopbyCost(inputs.annualGCI, inputs.annualTransactions);
    return {
      current,
      popby,
      savings: round(current.total - popby.total)
    };
  }

  /**
   * Estimate annual revenue share income from a 4-tier downline, using the
   * "company dollar" (capped split + monthly tech fee) Popby collects per
   * agent as the base each tier percentage applies to. Per-transaction fees
   * are left out of the base since we don't collect a downline transaction
   * count from the visitor — this keeps the estimate conservative.
   * @param {number[]} tierCounts        [tier1Count, tier2Count, tier3Count, tier4Count]
   * @param {number} avgDownlineGCI      assumed average annual GCI per downline agent
   * @returns {{perAgentCompanyDollar:number, tiers:Array, total:number}}
   */
  function calculateRevenueShare(tierCounts, avgDownlineGCI) {
    const cappedSplit = Math.min(avgDownlineGCI * POPBY_CONFIG.brokerageSplit, POPBY_CONFIG.annualCap);
    const techCost = POPBY_CONFIG.monthlyTechFee * 12;
    const perAgentCompanyDollar = round(cappedSplit + techCost);

    const tiers = POPBY_CONFIG.revShareTiers.map((pct, i) => {
      const count = tierCounts[i] || 0;
      const income = round(count * perAgentCompanyDollar * pct);
      return { tier: i + 1, pct, count, income };
    });

    const total = tiers.reduce((sum, t) => sum + t.income, 0);
    return { perAgentCompanyDollar, tiers, total };
  }

  /**
   * Flat (no-growth) multi-year projection: simply multiplies a steady
   * annual figure out across 1, 3, and 5 years so a visitor can see what
   * today's numbers add up to over time.
   * @param {number} annualValue
   * @returns {{year1:number, year3:number, year5:number}}
   */
  function calculateMultiYearProjection(annualValue) {
    return {
      year1: round(annualValue * 1),
      year3: round(annualValue * 3),
      year5: round(annualValue * 5)
    };
  }

  function round(n) { return Math.round(n); }
  function formatCurrency(n) {
    return "$" + Math.round(n).toLocaleString("en-US");
  }


  // ==========================================================================
  // === LAYER 3: REFERRAL / LEAD ATTRIBUTION =================================
  // Reads URL params once on load, holds them in memory for the life of the
  // widget, and exposes helpers the UI layer uses to personalize copy and
  // to build the lead object. No data leaves the browser in this prototype.
  // ==========================================================================

  /**
   * Supported URL params (see embed docs at top of file):
   *   ?ref=cody-posey            referring agent's slug/id
   *   &agentName=Cody%20Posey    referring agent's display name
   *   &agentImage=https://...    referring agent's headshot
   *   &booking=https://...       referring agent's personal booking link
   *   &source=instagram          marketing source
   *   &campaign=brokerage-savings marketing campaign
   *   &mode=embed|full           display mode (default: full)
   *
   * A production version of joinpopby.com would generate one unique
   * recruiting URL per agent (e.g. joinpopby.com/savings/cody-posey) and
   * resolve agentName/agentImage/booking server-side from the agent's slug,
   * so agents never have to hand-build a long query string themselves.
   */
  function readReferralParams() {
    const params = new URLSearchParams(window.location.search);
    return {
      ref: params.get("ref") || params.get("agent") || null,
      agentName: params.get("agentName") || null,
      agentImage: params.get("agentImage") || null,
      booking: params.get("booking") || null,
      source: params.get("source") || null,
      campaign: params.get("campaign") || null,
      mode: params.get("mode") || "full"
    };
  }

  // Held in memory for the life of the page/iframe. Never written to
  // localStorage/cookies in this prototype — CRM sync (Layer 3 below)
  // is where this would eventually be persisted.
  const PopbyReferral = readReferralParams();

  function referringAgentLabel() {
    return PopbyReferral.agentName || (PopbyReferral.ref ? titleCase(PopbyReferral.ref) : null);
  }
  function titleCase(slug) {
    return slug.replace(/[-_]/g, " ").replace(/\b\w/g, c => c.toUpperCase());
  }

  /**
   * Builds the lead payload and "submits" it. In production this is where
   * Popby would POST to its CRM. Kept as a single, clearly-commented
   * integration point so swapping in a real endpoint later is a one-function change.
   */
  function submitRecruitingLead(formInputs, calculationResult) {
    const lead = {
      firstName: formInputs.firstName,
      lastName: formInputs.lastName || "",
      email: formInputs.email,
      phone: formInputs.phone || "",
      currentBrokerage: formInputs.currentBrokerage || "",
      annualGCI: formInputs.annualGCI,
      annualTransactions: formInputs.annualTransactions,
      estimatedCurrentBrokerageCost: calculationResult.current.total,
      estimatedPopbyCost: calculationResult.popby.total,
      estimatedAnnualSavings: calculationResult.savings,
      referringAgent: PopbyReferral.ref,
      source: PopbyReferral.source,
      campaign: PopbyReferral.campaign,
      submittedAt: new Date().toISOString()
    };

    // ---- LIVE INTEGRATION: Google Apps Script Web App ----------------------
    // POPBY_LINKS.leadWebhook, once set, should point at a deployed Apps
    // Script Web App URL. That one endpoint both:
    //   1. Appends `lead` as a new row to a Google Sheet, and
    //   2. Emails a notification to camille@popbyrealty.com
    // See google-apps-script-lead-handler.gs (shipped alongside this file)
    // for the exact script to paste in and deploy — it's a 5-minute setup,
    // no separate email service or paid API required.
    //
    // Apps Script Web Apps don't return CORS headers by default, so this
    // uses mode: "no-cors" — the request still reaches the script and still
    // runs, we just can't read a response back in the browser. That's fine
    // here since there's nothing in the response the UI needs.
    if (POPBY_LINKS.leadWebhook) {
      fetch(POPBY_LINKS.leadWebhook, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "text/plain;charset=utf-8" }, // avoids an Apps Script CORS preflight
        body: JSON.stringify(lead)
      }).catch(err => {
        // Never let a failed network call break the visitor's experience —
        // the lead is already logged to the console below as a fallback.
        console.warn("[Popby] lead webhook failed (lead still logged locally):", err);
      });
    } else {
      console.log("[Popby] submitRecruitingLead — no leadWebhook configured yet, lead not sent anywhere:", lead);
    }

    // ---- OTHER FUTURE CRM / AUTOMATION INTEGRATION POINTS ------------------
    // BoldTrail:  POST `lead` to BoldTrail's lead-capture API, mapping
    //             referringAgent -> the receiving agent's BoldTrail user id.
    // Zapier:     POST `lead` as JSON to a Zapier "Catch Hook" webhook URL,
    //             then branch in Zapier on `lead.referringAgent`.
    // Make:       same shape, POST to a Make.com webhook trigger.
    // CRM API:    call Popby's own CRM REST API directly once it exists.
    // -------------------------------------------------------------------------

    trackEvent("lead_submitted", lead);
    return lead;
  }

  /**
   * Builds a shareable recruiting link for the CURRENT referring agent.
   * A production joinpopby.com would instead issue one permanent slug per
   * agent (joinpopby.com/savings/cody-posey) that resolves server-side —
   * this helper just shows how the query-string version would be composed.
   */
  function buildShareableLink(agentSlug, baseUrl) {
    baseUrl = baseUrl || (window.location.origin + window.location.pathname);
    const url = new URL(baseUrl);
    if (agentSlug) url.searchParams.set("ref", agentSlug);
    return url.toString();
  }


  // ---- TRACKING EVENT STUBS --------------------------------------------
  // Each function below is called at the relevant point in the flow. None
  // of them call an analytics provider yet — wire in Meta Pixel / GA4 /
  // another tool where noted, keeping referring_agent/source/campaign as
  // custom parameters so recruiting funnels can be attributed per agent.
  function trackEvent(eventName, extra) {
    const payload = Object.assign({
      referring_agent: PopbyReferral.ref,
      source: PopbyReferral.source,
      campaign: PopbyReferral.campaign
    }, extra || {});

    // Meta Pixel:        fbq('trackCustom', eventName, payload);
    // Google Analytics:  gtag('event', eventName, payload);
    // Other platform:    window.analytics && window.analytics.track(eventName, payload);
    console.log("[Popby tracking]", eventName, payload);
  }
  function calculator_started() { trackEvent("calculator_started"); }
  function calculator_completed(extra) { trackEvent("calculator_completed", extra); }
  function savings_calculated(extra) { trackEvent("savings_calculated", extra); }
  function lead_submitted(extra) { trackEvent("lead_submitted", extra); }
  function book_call_clicked(extra) { trackEvent("book_call_clicked", extra); }
  function revenue_share_calculated(extra) { trackEvent("revenue_share_calculated", extra); }
  function results_shared(extra) { trackEvent("results_shared", extra); }
  function learn_more_clicked(extra) { trackEvent("learn_more_clicked", extra); }


  // ==========================================================================
  // === LAYER 2: USER INTERFACE ==============================================
  // DOM wiring only. Reads from Layer 1 (calculation) and Layer 3 (referral)
  // but contains no calculation logic or attribution logic of its own.
  // ==========================================================================

  const root = document.getElementById("pbCalc");
  const el = id => document.getElementById(id);

  let hasStarted = false;
  let lastRevShareResult = null;

  // ---- Static labels that read from config, not hardcoded -----------------
  function applyConfigLabels() {
    el("pbDiscCap").textContent = POPBY_CONFIG.annualCap.toLocaleString();
    const pctEls = [el("pbTier1Pct"), el("pbTier2Pct"), el("pbTier3Pct"), el("pbTier4Pct")];
    const diagEls = [el("pbDiagTier1Pct"), el("pbDiagTier2Pct"), el("pbDiagTier3Pct"), el("pbDiagTier4Pct")];
    POPBY_CONFIG.revShareTiers.forEach((pct, i) => {
      pctEls[i].textContent = "(" + Math.round(pct * 100) + "%)";
      diagEls[i].textContent = Math.round(pct * 100) + "%";
    });
  }

  // ---- Brokerage preset dropdown -------------------------------------------
  function wireBrokeragePreset() {
    const select = el("pbBrokeragePreset");
    POPBY_BROKERAGE_PRESETS.forEach((preset, i) => {
      const opt = document.createElement("option");
      opt.value = String(i);
      opt.textContent = preset.label;
      select.appendChild(opt);
    });

    select.addEventListener("change", () => {
      const preset = POPBY_BROKERAGE_PRESETS[Number(select.value)];
      if (!preset || preset.split === null) return; // "Other" / blank — leave manual values alone

      el("pbSplit").value = preset.split;
      el("pbSplitDisplay").textContent = preset.split + "%";
      if (preset.monthlyFee !== null) {
        el("pbMonthlyFees").value = preset.monthlyFee;
      }
      maybeTrackStart();
    });
  }

  // ---- Apply display mode -------------------------------------------------
  function applyMode() {
    const mode = PopbyReferral.mode === "embed" ? "embed" : "full";
    root.setAttribute("data-mode", mode);
    if (mode === "embed") {
      el("pbHero").hidden = true;
      el("pbEmbedHeading").hidden = false;
    } else {
      el("pbHero").hidden = false;
      el("pbEmbedHeading").hidden = true;
    }
  }

  // ---- Apply agent personalization ----------------------------------------
  function applyPersonalization() {
    const agentLabel = referringAgentLabel();

    // Top chip: "Guided by Cody" — only shown if we know who referred them
    if (agentLabel) {
      el("pbAgentChip").hidden = false;
      el("pbAgentChipText").textContent = "Guided by " + agentLabel;
      if (PopbyReferral.agentImage) {
        el("pbAgentChipImg").src = PopbyReferral.agentImage;
        el("pbAgentChipImg").alt = agentLabel;
        el("pbAgentChipImg").hidden = false;
      }
    }

    // "Send Me My Breakdown" button + bottom recruiting CTA copy
    const talkLabel = agentLabel ? ("Talk to " + firstNameOnly(agentLabel)) : "Talk With Popby";
    el("pbSendBreakdownBtn").textContent = "Send Me My Breakdown";

    el("pbRecruitHeadline").textContent = "Let's talk.";
    el("pbBookCallBtn").textContent = agentLabel
      ? ("Book a Conversation With " + firstNameOnly(agentLabel))
      : "Book a Conversation With Popby";

    if (agentLabel && PopbyReferral.agentImage) {
      el("pbBottomAgentImg").src = PopbyReferral.agentImage;
      el("pbBottomAgentImg").alt = agentLabel;
      el("pbBottomAgentImg").hidden = false;
    }

    el("pbBookCallBtn").addEventListener("click", function () {
      book_call_clicked({ label: talkLabel });
      const href = PopbyReferral.booking || POPBY_LINKS.defaultBooking;
      if (href && href !== "#") window.open(href, "_blank", "noopener");
    });

    el("pbPrivacyLink").href = POPBY_LINKS.privacy;

    // "Explore Popby Realty" — same referral attribution as the booking
    // button, so a visit that starts on an agent's page is still credited.
    const learnEl = el("pbLearnMoreLink");
    if (learnEl) {
      learnEl.href = POPBY_LINKS.learnMore;
      learnEl.addEventListener("click", function () {
        learn_more_clicked({ destination: POPBY_LINKS.learnMore });
      });
    }
  }

  function firstNameOnly(fullName) { return fullName.split(" ")[0]; }

  // ---- Popby fee schedule table --------------------------------------------
  function applyFeeScheduleRates() {
    el("pbFeeSplitRate").textContent = Math.round(POPBY_CONFIG.brokerageSplit * 100) + "% of GCI";
    el("pbFeeCapRate").textContent = formatCurrency(POPBY_CONFIG.annualCap) + "/yr";
    el("pbFeeTechRate").textContent = formatCurrency(POPBY_CONFIG.monthlyTechFee) + "/mo";
    el("pbFeeTxnRate").textContent = formatCurrency(POPBY_CONFIG.transactionFee) + " / deal";
    el("pbFeeRoyaltyRate").textContent = POPBY_CONFIG.royaltyFee ? formatCurrency(POPBY_CONFIG.royaltyFee) : "$0";
  }

  function renderFeeScheduleLive() {
    const inputs = readInputs();
    const popby = calculatePopbyCost(inputs.annualGCI, inputs.annualTransactions);

    el("pbFeeSplitLive").textContent = formatCurrency(popby.splitCost) + "/yr";
    el("pbFeeCapLive").textContent = popby.splitCost >= POPBY_CONFIG.annualCap ? "Capped" : "Not yet reached";
    el("pbFeeTechLive").textContent = formatCurrency(popby.techCost) + "/yr";
    el("pbFeeTxnLive").textContent = formatCurrency(popby.transactionCost) + "/yr";
    el("pbFeeRoyaltyLive").textContent = formatCurrency(popby.royaltyCost) + "/yr";
  }

  function wireFeeSchedule() {
    applyFeeScheduleRates();
    renderFeeScheduleLive();

    const card = el("pbFeeCard");
    const toggle = el("pbFeeToggle");
    const wrap = el("pbFeeTableWrap");
    toggle.addEventListener("click", () => {
      const isOpen = card.getAttribute("data-open") === "true";
      card.setAttribute("data-open", String(!isOpen));
      toggle.setAttribute("aria-expanded", String(!isOpen));
      wrap.hidden = isOpen;
    });
  }

  // ---- Slider / input live values -----------------------------------------
  function wireInputDisplays() {
    const gci = el("pbGci");
    const split = el("pbSplit");

    gci.addEventListener("input", () => {
      el("pbGciDisplay").textContent = formatCurrency(Number(gci.value));
      renderFeeScheduleLive();
      maybeTrackStart();
    });
    split.addEventListener("input", () => {
      el("pbSplitDisplay").textContent = split.value + "%";
      maybeTrackStart();
    });
    [el("pbTransactions"), el("pbMonthlyFees")].forEach(input => {
      input.addEventListener("input", () => {
        renderFeeScheduleLive();
        maybeTrackStart();
      });
    });
  }

  function maybeTrackStart() {
    if (!hasStarted) {
      hasStarted = true;
      calculator_started();
    }
  }

  // ---- Read current form state --------------------------------------------
  function readInputs() {
    return {
      annualGCI: Number(el("pbGci").value) || 0,
      annualTransactions: Number(el("pbTransactions").value) || 0,
      currentSplitPercent: Number(el("pbSplit").value) || 0,
      monthlyFees: Number(el("pbMonthlyFees").value) || 0
    };
  }

  // Small inline icon set reused across the breakdown list and share card.
  const PB_ICONS = {
    percent: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>',
    calendar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
    wifi: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>',
    tag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M20.59 13.41 13.41 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>'
  };
  function pbLi(iconKey, label, value) {
    return `<li><span class="pb-li-label"><span class="pb-row-icon">${PB_ICONS[iconKey]}</span>${label}</span><span class="pb-tabular">${value}</span></li>`;
  }

  // ---- Render results -------------------------------------------------------
  function renderResults(result) {
    const savingsEl = el("pbSavingsAmount");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReducedMotion) {
      savingsEl.textContent = formatCurrency(result.savings);
    } else {
      animateCount(savingsEl, 0, result.savings, 700);
      // Small pop once the number lands, so the reveal feels like a payoff
      // rather than just text fading in.
      window.setTimeout(() => {
        savingsEl.classList.remove("pb-pulse");
        void savingsEl.offsetWidth; // restart the animation if triggered twice
        savingsEl.classList.add("pb-pulse");
      }, 700);
    }

    el("pbSavingsSub").textContent = result.savings >= 0
      ? "Compare the numbers for yourself below."
      : "Based on what you entered, your current setup may cost less — here's the breakdown.";

    el("pbCurrentTotal").textContent = formatCurrency(result.current.total);
    el("pbCurrentBreakdown").innerHTML =
      pbLi("percent", "Split paid to brokerage", formatCurrency(result.current.splitCost)) +
      pbLi("calendar", "Monthly fees (annualized)", formatCurrency(result.current.feeCost));

    el("pbPopbyTotal").textContent = formatCurrency(result.popby.total);
    el("pbPopbyBreakdown").innerHTML =
      pbLi("percent", `Capped split (max $${POPBY_CONFIG.annualCap.toLocaleString()})`, formatCurrency(result.popby.splitCost)) +
      pbLi("wifi", `Tech fee ($${POPBY_CONFIG.monthlyTechFee}/mo)`, formatCurrency(result.popby.techCost)) +
      pbLi("tag", `Transaction fees ($${POPBY_CONFIG.transactionFee} × deals)`, formatCurrency(result.popby.transactionCost));

    renderDonuts(result);
    renderCapCountdown(result);

    el("pbResults").classList.add("pb-visible");

    renderProjectionChart();
  }

  /**
   * "Keep vs. give away" donut rings — shows what % of GCI the agent keeps
   * under their current brokerage vs. under Popby, side by side.
   */
  const PB_DONUT_CIRCUMFERENCE = 2 * Math.PI * 30; // r=30 in the SVG markup
  function renderDonuts(result) {
    const gci = lastInputs ? lastInputs.annualGCI : 0;
    if (!gci) return;

    const currentKeepPct = clampPct(((gci - result.current.total) / gci) * 100);
    const popbyKeepPct = clampPct(((gci - result.popby.total) / gci) * 100);

    setDonut("pbDonutCurrentRing", "pbDonutCurrentPct", currentKeepPct);
    setDonut("pbDonutPopbyRing", "pbDonutPopbyPct", popbyKeepPct);
  }
  function clampPct(n) { return Math.max(0, Math.min(100, n)); }
  function setDonut(ringId, labelId, pct) {
    const dash = (pct / 100) * PB_DONUT_CIRCUMFERENCE;
    el(ringId).setAttribute("stroke-dasharray", dash.toFixed(1) + " " + PB_DONUT_CIRCUMFERENCE.toFixed(1));
    el(labelId).textContent = Math.round(pct) + "%";
  }

  /**
   * Cap countdown — the single most persuasive fact in the capped-split
   * model, so it gets its own callout instead of living inside a table row.
   */
  function renderCapCountdown(result) {
    const gci = lastInputs ? lastInputs.annualGCI : 0;
    const block = el("pbCapCountdown");
    if (!gci) { block.hidden = true; return; }

    const uncappedSplit = gci * POPBY_CONFIG.brokerageSplit;
    const isCapped = uncappedSplit > POPBY_CONFIG.annualCap;

    if (isCapped) {
      const monthsToCap = Math.max(1, Math.round((POPBY_CONFIG.annualCap / uncappedSplit) * 12));
      const fillPct = clampPct((monthsToCap / 12) * 100);
      el("pbCapHeadline").textContent = "You'd hit your cap around month " + monthsToCap;
      el("pbCapCopy").innerHTML = `At your production, you'd hit Popby's $${POPBY_CONFIG.annualCap.toLocaleString()} cap around <strong>month ${monthsToCap}</strong> — then you keep 100% of your commission for the rest of the year.`;
      el("pbCapFill").style.width = fillPct + "%";
      el("pbCapMarker").style.left = fillPct + "%";
      el("pbCapMarker").hidden = false;
    } else {
      const fillPct = clampPct((uncappedSplit / POPBY_CONFIG.annualCap) * 100);
      el("pbCapHeadline").textContent = "You're nowhere near the cap";
      el("pbCapCopy").innerHTML = `At your production, you'd pay about <strong>${formatCurrency(uncappedSplit)}</strong> in splits this year — well under Popby's $${POPBY_CONFIG.annualCap.toLocaleString()} cap, so you'd never hit it.`;
      el("pbCapFill").style.width = fillPct + "%";
      el("pbCapMarker").hidden = true;
    }

    block.hidden = false;
  }

  /**
   * Renders the 1/3/5-year bar chart from whatever we currently know:
   * brokerage savings alone if the revenue share section hasn't been
   * calculated yet, or savings + revenue share combined once it has.
   */
  function renderProjectionChart() {
    if (!lastResult) return;
    const annual = lastResult.savings + (lastRevShareResult ? lastRevShareResult.total : 0);
    const projection = calculateMultiYearProjection(Math.max(annual, 0));
    const maxValue = Math.max(projection.year5, 1);

    el("pbProjectionTitle").textContent = lastRevShareResult
      ? "Savings + revenue share, if nothing else changes"
      : "If nothing else changes";

    setProjBar("1", projection.year1, maxValue);
    setProjBar("3", projection.year3, maxValue);
    setProjBar("5", projection.year5, maxValue);

    el("pbProjection").hidden = false;
  }

  function setProjBar(yearKey, value, maxValue) {
    const pct = Math.min(100, Math.round((value / maxValue) * 100));
    el("pbProjBar" + yearKey).style.width = pct + "%";
    el("pbProjVal" + yearKey).textContent = formatCurrency(value);
  }

  function animateCount(node, from, to, duration) {
    const start = performance.now();
    function step(now) {
      const progress = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = Math.round(from + (to - from) * eased);
      node.textContent = formatCurrency(value);
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  // ---- Wire the "Calculate" button ------------------------------------------
  let lastResult = null;
  let lastInputs = null;
  function wireCalculateButton() {
    el("pbCalculateBtn").addEventListener("click", () => {
      const inputs = readInputs();
      lastInputs = inputs;
      lastResult = calculatePopbySavings(inputs);
      renderResults(lastResult);
      savings_calculated({ savings: lastResult.savings });
      calculator_completed({ savings: lastResult.savings });
      el("pbResults").scrollIntoView({ behavior: prefersReducedMotionSafe() ? "auto" : "smooth", block: "nearest" });
    });
  }
  function prefersReducedMotionSafe() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  // ---- Share My Results ------------------------------------------------------
  // Draws a simple branded 1080x1080 image summarizing the visitor's
  // savings, using the hidden <canvas id="pbShareCanvas">. Nothing here is
  // sent anywhere — it's generated entirely client-side, then either handed
  // to the native share sheet (mobile) or downloaded (desktop).
  async function generateShareBlob() {
    const canvas = el("pbShareCanvas");
    const ctx = canvas.getContext("2d");
    const W = canvas.width, H = canvas.height;

    // Best-effort font preload so canvas text doesn't fall back to a
    // system serif before Poppins has finished loading.
    try {
      await Promise.all([
        document.fonts.load("700 36px Poppins"),
        document.fonts.load("700 118px Poppins"),
        document.fonts.load("600 30px Poppins"),
        document.fonts.load("400 26px Poppins")
      ]);
    } catch (e) { /* canvas will just fall back to a system font */ }

    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = "#FFFFFF";
    ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = "#FF1616";
    ctx.fillRect(0, 0, W, 16);

    ctx.fillStyle = "#000000";
    ctx.font = "700 36px Poppins, sans-serif";
    ctx.fillText("POPBY REALTY", 70, 120);

    ctx.fillStyle = "#6B7280";
    ctx.font = "400 26px Poppins, sans-serif";
    ctx.fillText("What I could keep per year", 70, 420);

    ctx.fillStyle = "#FF1616";
    ctx.font = "700 118px Poppins, sans-serif";
    ctx.fillText(formatCurrency(lastResult.savings), 66, 545);

    ctx.fillStyle = "#33343A";
    ctx.font = "400 26px Poppins, sans-serif";
    ctx.fillText("by switching to Popby Realty", 70, 590);

    const agentLabel = referringAgentLabel();
    ctx.fillStyle = "#000000";
    ctx.font = "600 30px Poppins, sans-serif";
    ctx.fillText(agentLabel ? ("Talk to " + firstNameOnly(agentLabel)) : "Talk With Popby", 70, 950);

    ctx.fillStyle = "#6B7280";
    ctx.font = "400 22px Poppins, sans-serif";
    ctx.fillText("Estimate only — not a guarantee of earnings.", 70, 990);

    return new Promise(resolve => canvas.toBlob(resolve, "image/png"));
  }

  function wireShareButton() {
    el("pbShareBtn").addEventListener("click", async () => {
      const statusEl = el("pbShareStatus");
      if (!lastResult) {
        statusEl.hidden = false;
        statusEl.textContent = "Calculate your numbers first, then share your results.";
        return;
      }

      statusEl.hidden = false;
      statusEl.textContent = "Preparing your image…";

      try {
        const blob = await generateShareBlob();
        const file = new File([blob], "popby-savings.png", { type: "image/png" });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({
            files: [file],
            title: "My Popby Realty savings",
            text: "Here's what I could keep per year with Popby Realty."
          });
          statusEl.hidden = true;
        } else {
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = "popby-savings.png";
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          statusEl.textContent = "Image downloaded — share it anywhere.";
        }
        results_shared({ savings: lastResult.savings });
      } catch (err) {
        if (err && err.name === "AbortError") { statusEl.hidden = true; return; } // user cancelled the native share sheet
        console.warn("[Popby] share image failed:", err);
        statusEl.textContent = "Couldn't generate the image — try again.";
      }
    });
  }

  // ---- Wire the revenue share / downline projection --------------------------
  function wireRevShare() {
    el("pbCalcRevShareBtn").addEventListener("click", () => {
      const tierCounts = [
        Number(el("pbTier1").value) || 0,
        Number(el("pbTier2").value) || 0,
        Number(el("pbTier3").value) || 0,
        Number(el("pbTier4").value) || 0
      ];
      const avgDownlineGCI = Number(el("pbAvgDownlineGci").value) || 0;

      lastRevShareResult = calculateRevenueShare(tierCounts, avgDownlineGCI);
      renderRevShareResults(lastRevShareResult);

      revenue_share_calculated({ total: lastRevShareResult.total });

      // If the visitor already calculated their brokerage savings, fold
      // this into the same multi-year projection chart.
      if (lastResult) renderProjectionChart();

      el("pbRevShareResults").scrollIntoView({ behavior: prefersReducedMotionSafe() ? "auto" : "smooth", block: "nearest" });
    });
  }

  function renderRevShareResults(result) {
    const totalEl = el("pbRevShareTotal");
    if (prefersReducedMotionSafe()) {
      totalEl.textContent = formatCurrency(result.total);
    } else {
      animateCount(totalEl, 0, result.total, 700);
    }

    el("pbRevShareBreakdown").innerHTML = result.tiers.map(t =>
      `<li><span>Tier ${t.tier} — ${t.count} agent${t.count === 1 ? "" : "s"} (${Math.round(t.pct * 100)}%)</span><span class="pb-tabular">${formatCurrency(t.income)}</span></li>`
    ).join("");

    el("pbRevShareResults").classList.add("pb-visible");

    const combinedEl = el("pbCombinedTotal");
    if (lastResult) {
      const combined = lastResult.savings + result.total;
      el("pbCombinedAmount").textContent = formatCurrency(combined) + "/year";
      combinedEl.hidden = false;
    } else {
      combinedEl.hidden = true;
    }
  }

  // ---- Wire the lead capture form --------------------------------------------
  function wireLeadForm() {
    el("pbSendBreakdownBtn").addEventListener("click", () => {
      // Honeypot check: a real visitor never fills this field in (it's
      // off-screen and unreachable by tab). If it has a value, a bot
      // filled the form — drop the submission without any network call
      // and without tipping the bot off that it was caught.
      if (el("pbHoneypot").value.trim() !== "") {
        return;
      }

      const firstName = el("pbFirstName").value.trim();
      const email = el("pbEmail").value.trim();

      if (!firstName || !email) {
        el("pbFirstName").focus();
        return; // keep it simple for the prototype — a production build
                // would show inline validation messaging here
      }
      if (!lastResult) {
        // Shouldn't happen since the lead section only shows after results,
        // but guard anyway.
        lastResult = calculatePopbySavings(readInputs());
      }

      const formInputs = {
        firstName,
        email,
        phone: el("pbPhone").value.trim(),
        currentBrokerage: el("pbBrokerage").value.trim(),
        annualGCI: readInputs().annualGCI,
        annualTransactions: readInputs().annualTransactions
      };

      submitRecruitingLead(formInputs, lastResult);

      el("pbLeadForm").hidden = true;
      el("pbLeadSuccess").hidden = false;
      const agentLabel = referringAgentLabel();
      el("pbLeadSuccessCopy").textContent = agentLabel
        ? `${firstNameOnly(agentLabel)} will follow up with your personalized breakdown shortly.`
        : "We'll follow up with your personalized breakdown shortly.";
    });
  }

  // ---- Init ------------------------------------------------------------------
  function init() {
    applyMode();
    applyPersonalization();
    applyConfigLabels();
    wireBrokeragePreset();
    wireInputDisplays();
    wireFeeSchedule();
    wireCalculateButton();
    wireShareButton();
    wireRevShare();
    wireLeadForm();
  }

  init();

  // Exposed for debugging / future integration testing from the browser console.
  window.PopbyCalculator = {
    calculatePopbySavings,
    calculateRevenueShare,
    calculateMultiYearProjection,
    submitRecruitingLead,
    buildShareableLink,
    referral: PopbyReferral
  };
})();
</script>
