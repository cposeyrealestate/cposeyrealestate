---
import SEO from '../components/SEO.astro';
import CookieBanner from '../components/CookieBanner.astro';
import SignupPopup from '../components/SignupPopup.astro';
import seo from '../data/seo.json';
import { homepageSchema } from '../lib/schema';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  schema?: object | object[];
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

const {
  title = 'Cody Posey | New Braunfels, Texas Real Estate Agent',
  description = seo.site.description,
  canonical,
  image,
  type,
  noindex,
  schema,
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

// Define the same author, business, brokerage, and website on each page.
// Preserve page-specific definitions when a page supplies a node with the same ID.
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const definedIds = new Set(schemas.map((node: any) => node?.['@id']).filter(Boolean));
const pageSchemas = [...homepageSchema().filter(node => !definedIds.has(node['@id'])), ...schemas];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/font-e0fcb6cf81c5-v1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/font-b877d7636354-v1.woff2" as="font" type="font/woff2" crossorigin />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      schema={pageSchemas}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
    />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-h5TNqTBUNL1OihFlOO-iG.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <slot />
    <CookieBanner />
    <SignupPopup />
    <script>
      const track = (name: string, props: Record<string, string> = {}) => {
        const analytics = (window as Window & { plausible?: (event: string, options: object) => void }).plausible;
        if (typeof analytics === 'function') analytics(name, { props });
      };
      document.addEventListener('cpre:lead-submitted', (event: Event) => {
        const form = (event as CustomEvent).detail?.form;
        if (['homepage-contact', 'contact', 'valuation-modal', 'home-valuation', 'guide-download', 'lead-gate', 'signup'].includes(form)) {
          track('Lead Submitted', { form });
        }
      });
      document.addEventListener('cpre:booking-opened', () => track('Consultation Link Click'));
      document.addEventListener('click', event => {
        const link = event.target instanceof Element ? event.target.closest('a') : null;
        if (!link) return;
        const href = link.getAttribute('href') || '';
        if (href.startsWith('tel:')) track('Phone Link Click');
        else if (href.startsWith('mailto:')) track('Email Link Click');
        else if (/^(?:\/contact\/?|\/)#book$|^#book$/.test(href) || /^https:\/\/tidycal\.com\/cposeyrealestate(?:\/|$)/.test(href)) track('Consultation Link Click');
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
